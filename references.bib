}

@article{nguyenCannabidiolInhibitsSARSCoV22021,
  title = {Cannabidiol Inhibits {{SARS-CoV-2}} Replication and Promotes the Host Innate Immune Response.},
  author = {Nguyen, Long Chi and Yang, Dongbo and Nicolaescu, Vlad and Best, Thomas J and Ohtsuki, Takashi and Chen, Shao-Nong and Friesen, J Brent and Drayman, Nir and Mohamed, Adil and Dann, Christopher and Silva, Diane and Gula, Haley and Jones, Krysten A and Millis, J Michael and Dickinson, Bryan C and Tay, Sava{\c s} and Oakes, Scott A and Pauli, Guido F and Meltzer, David O and Randall, Glenn and Rosner, Marsha Rich},
  year = {2021},
  month = mar,
  journal = {bioRxiv : the preprint server for biology},
  publisher = {Cold Spring Harbor Laboratory Preprints},
  doi = {10.1101/2021.03.10.432967},
  abstract = {The rapid spread of COVID-19 underscores the need for new treatments. Here we report that cannabidiol (CBD), a compound produced by the cannabis plant, inhibits SARS-CoV-2 infection. CBD and its metabolite, 7-OH-CBD, but not congeneric cannabinoids, potently block SARS-CoV-2 replication in lung epithelial cells. CBD acts after cellular infection, inhibiting viral gene expression and reversing many effects of SARS-CoV-2 on host gene transcription. CBD induces interferon expression and up-regulates its antiviral signaling pathway. A cohort of human patients previously taking CBD had significantly lower SARS-CoV-2 infection incidence of up to an order of magnitude relative to matched pairs or the general population. This study highlights CBD, and its active metabolite, 7-OH-CBD, as potential preventative agents and therapeutic treatments for SARS-CoV-2 at early stages of infection.},
  date-added = {2022-02-09T19:50:32GMT},
  date-modified = {2022-03-21T19:10:43GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/B/2021/Nguyen/2021\%20Nguyen\%20bioRxiv.pdf},
  pmcid = {PMC7987002},
  pmid = {33758843},
  rating = {0},
  uri = {papers3://publication/doi/10.1101/2021.03.10.432967},
  keywords = {Cannabis,CBD,coronavirus,COVID-19},
  file = {/Users/nately/Zotero/storage/JFIDZFGU/2021 Nguyen bioRxiv.pdf}
}

