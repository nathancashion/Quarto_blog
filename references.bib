@article{baderSuccessfulManagementIatrogenic2024,
  title = {Successful Management of an {{Iatrogenic}} Portal Vein and Hepatic Artery Injury in a 4-Month-Old Female Patient: {{A}} Case Report and Literature Review},
  shorttitle = {Successful Management of an {{Iatrogenic}} Portal Vein and Hepatic Artery Injury in a 4-Month-Old Female Patient},
  author = {Bader, Raneem and Imam, Ashraf and Alnees, Mohammad and Adler, Neta and {ilia}, Joanthan and Zugayar, Diaa and Dan, Arbell and Khalaileh, Abed},
  year = {2024},
