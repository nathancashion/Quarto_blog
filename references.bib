@article{mandelRetrospectiveAnalysisVertebral2013a,
  title = {A Retrospective Analysis of Vertebral Body Fractures Following Epidural Steroid Injections.},
  author = {Mandel, Shlomo and Schilling, Jennifer and Peterson, Edward and Rao, D Sudhaker and Sanders, William},
  year = {2013},
  month = jun,
  journal = {The Journal of Bone and Joint Surgery (American)},
  volume = {95},
  number = {11},
  pages = {961--964},
  doi = {10.2106/JBJS.L.00844},
  abstract = {BACKGROUND:Lumbar epidural steroid injections (LESIs) are frequently prescribed for the treatment of radiculopathy or neurogenic claudication arising from compression of spinal nerves. However, there is evidence suggesting that corticosteroids adversely affect bone strength by diminishing new bone formation and increasing bone resorption. Our study sought to assess whether LESIs increase the risk of subsequent vertebral body fracture. METHODS:A retrospective cohort study was conducted to compare patients receiving LESIs with a control group. A total of 50,345 patients with ICD-9 (International Classification of Diseases, Ninth Revision) diagnosis codes involving the spine were identified by searching a corporate database, and 3415 of these were found to have received at least one LESI. We randomly selected a study population of 3000 patients from the injected population, and we selected a matched cohort of 3000 patients from the non-injected group with use of propensity matching. The incidence of vertebral body fractures in each group was assessed with use of survival analysis. RESULTS:There was no significant difference between the injected and non-injected groups with respect to age, predicted propensity score, sex, race, hyperthyroidism, or steroid use. In the survival analysis, an increasing number of injections was associated with an increasing likelihood of fractures. Each successive injection increased the risk of fracture by a factor of 1.21 (95\% confidence interval, 1.08 to 1.30) after adjustment for covariates (p = 0.003). CONCLUSIONS:The findings suggest that LESIs, like other forms of exogenous steroid administration, may lead to increased bone fragility. The added exposure to glucocorticoids resulting from LESI use may carry a greater risk than previously thought, suggesting that use of LESIs should be approached cautiously in patients at risk for osteoporotic fractures. LEVEL OF EVIDENCE:Therapeutic Level III. See Instructions for Authors for a complete description of levels of evidence.},
  affiliation = {Departments of Orthopaedic Surgery, West Bloomfield, MI 48322, USA. smandel2@hfhs.org},
  date-added = {2015-03-05T22:24:48GMT},
  date-modified = {2022-04-30T18:16:17GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2013/Mandel/2013\%20Mandel\%20J\%20Bone\%20Joint\%20Surg\%20Am.pdf},
  pmid = {23780532},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.2106/JBJS.L.00844},
  keywords = {ESI,fracture,steroid},
  file = {/Users/nately/Zotero/storage/5PPBV3XR/2013 Mandel J Bone Joint Surg Am.pdf;/Users/nately/Zotero/storage/6IHDSZU9/2013 Mandel J Bone Joint Surg Am.pdf;/Users/nately/Zotero/storage/RQT4LNID/2013 Mandel J Bone Joint Surg Am-1.pdf}
}

@article{mandlHowAICould2025,
  title = {How {{AI Could Reshape Health Care}}---{{Rise}} in {{Direct-to-Consumer Models}}},
  author = {Mandl, Kenneth D.},
  year = {2025},
  month = feb,
  journal = {JAMA},
  issn = {0098-7484},
  doi = {10.1001/jama.2025.0946},
  urldate = {2025-02-25},
  abstract = {A time may be approaching when wise patients demand artificial intelligence (AI)--informed care as a standard of quality. How this expectation will be met remains unclear; indeed, AI may put the health system at a crossroads. Even at this formative stage, and despite limitations, predictive AI and large language models (LLMs) show potential for accurately diagnosing and prognosticating across domains, including medicine, pathology, and radiology.Yet traditional health care organizations (HCOs) grapple with the complexities of AI, from integrating it into rigid electronic health record (EHR) workflows to ensuring fairness and monitoring performance. HCOs are often constrained in innovation by entrenched operational structures. Deploying AI demands rigorous oversight, including surveillance for data drift and shift (ie, changes in data patterns that can degrade model performance), while promoting fairness, transparency, and avoidance of bias. Meanwhile, an emerging direct-to-consumer (DTC) health care market bypasses traditional HCOs. For example, Amazon integrates telehealth, primary care, and pharmacy services into its Prime membership. Additionally, Big Pharma host consumer-facing portals streamlining access to medications and integrating telehealth consultations.},
  file = {/Users/nately/Zotero/storage/ID36FNU9/Mandl - 2025 - How AI Could Reshape Health Care—Rise in Direct-to-Consumer Models.pdf;/Users/nately/Zotero/storage/KFHJBF5I/2830738.html}
}

