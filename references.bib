@article{brooke-wavellStrongSteadyStraight2022,
  title = {Strong, Steady and Straight: {{UK}} Consensus Statement on Physical Activity and Exercise for Osteoporosis},
  shorttitle = {Strong, Steady and Straight},
  author = {{Brooke-Wavell}, Katherine and Skelton, Dawn A and Barker, Karen L and Clark, Emma M and De Biase, Sarah and Arnold, Susanne and Paskins, Zoe and Robinson, Katie R and Lewis, Rachel M and Tobias, Jonathan H and Ward, Kate A and Whitney, Julie and Leyland, Sarah},
  year = {2022},
  month = aug,
  journal = {British Journal of Sports Medicine},
  volume = {56},
  number = {15},
  pages = {837--846},
  issn = {0306-3674, 1473-0480},
  doi = {10.1136/bjsports-2021-104634},
  urldate = {2023-10-31},
  abstract = {Exercise and physical activity can improve bone strength and the risk of falls, which may offer benefits in the prevention and management of osteoporosis. However, uncertainty about the types of exercise that are safe and effective instigates lack of confidence in people with osteoporosis and health professionals. Existing guidelines leave some questions unresolved. This consensus statement aimed to determine the physical activity and exercise needed to optimise bone strength, reduce fall and fracture risk, improve posture and manage vertebral fracture symptoms, while minimising potential risks in people with osteoporosis. The scope of this statement was developed following stakeholder consultation.},
  langid = {english},
  file = {/Users/nately/Zotero/storage/Z8NSKZX3/Brooke-Wavell et al. - 2022 - Strong, steady and straight UK consensus statemen.pdf}
}

