@article{roperEffectsGaitRetraining2016,
  title = {The Effects of Gait Retraining in Runners with Patellofemoral Pain: {{A}} Randomized Trial.},
  author = {Roper, Jenevieve L and Harding, Elizabeth M and Doerfler, Deborah and Dexter, James G and Kravitz, Len and Dufek, Janet S and Mermier, Christine M},
  year = {2016},
  month = jun,
  journal = {Clinical biomechanics},
  volume = {35},
  pages = {14--22},
  address = {Bristol, Avon},
  doi = {10.1016/j.clinbiomech.2016.03.010},
  abstract = {BACKGROUND:Running popularity has increased resulting in a concomitant increase in running-related injuries with patellofemoral pain most commonly reported. The purpose of this study was to determine whether gait retraining by modifying footstrike patterns from rearfoot strike to forefoot strike reduces patellofemoral pain and improves associated biomechanical measures, and whether the modification influences risk of ankle injuries. METHODS:Sixteen subjects (n=16) were randomly placed in the control (n=8) or experimental (n=8) group. The experimental group performed eight gait retraining running sessions over two weeks where footstrike pattern was switched from rearfoot strike to forefoot strike, while the control group performed running sessions with no intervention. Variables were recorded pre-, post-, and one-month post-running trials. FINDINGS:Knee pain was significantly reduced post-retraining (P{\textexclamdown}0.05; effect size=0.294) and one-month follow-up (P{\textexclamdown}0.05; effect size=0.294). Knee abduction was significantly improved post-retraining (P{\textexclamdown}0.05; effect size=0.291) and one-month follow-up (P{\textexclamdown}0.05; effect size=0.291). Ankle flexion was significantly different post-retraining (P{\textexclamdown}0.05; effect size=0.547), as well as ankle range of motion post-retraining (P{\textexclamdown}0.05; effect size=0.425) and one-month follow-up (P{\textexclamdown}0.05; effect size=0.425). INTERPRETATION:Findings suggest running with a forefoot strike pattern leads to reduced knee pain, and should be considered a possible strategy for management of patellofemoral pain in recreational runners. This trial is registered at the US National Institutes of Health (clinicaltrials.gov) \#NCT02567123.},
  affiliation = {Department of Health Exercise, and Sports Sciences, University of New Mexico, Johnson Center, MSC04 2610, Albuquerque, NM 87131, USA. Electronic address: Jenevieve.roper@csusb.edu.},
  date-added = {2017-05-11T14:11:13GMT},
  date-modified = {2022-04-30T18:16:32GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/C/2016/Roper/2016\%20Roper\%20Clin\%20Biomech-1.pdf},
  pmid = {27111879},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.clinbiomech.2016.03.010},
  file = {/Users/nately/Zotero/storage/SG88BK5V/2016 Roper Clin Biomech-1.pdf}
}

@article{roppDidMissThat2015,
