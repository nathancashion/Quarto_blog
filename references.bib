@article{mettlerDayElectronicMedical2024,
  title = {The {{Day}} the {{Electronic Medical Records System Went Down}}},
  author = {Mettler, Sofia K.},
  year = {2024},
  month = apr,
  journal = {JAMA Internal Medicine},
  issn = {2168-6106},
  doi = {10.1001/jamainternmed.2024.1066},
  urldate = {2024-05-02},
  abstract = {It was at 7 am, the time when the night team signs out to the day team, that the incoming residents heard the horrifying news: our electronic medical records (EMR) system (Epic) was down. There was an unexpected fatal error to the system that the IT department was working to resolve. The estimated downtime was unknown. This news spread throughout the hospital as quickly as a code blue announced by overhead paging. Everyone panicked.Normally, maintenance work of our EMR system happens sometime between 2 and 5 am to minimize disruption to patient care and is completed before the night team prepares their sign-out to the day team. Uncertainty loomed over how long the disruption would last and how severely patient care would be impacted. The resident group chat flooded with questions: What do we do all morning without our EMR system? Can we complete our rounds at all before the system is back?},
  file = {/Users/nately/Zotero/storage/MR4LZXA5/2818023.html}
}

