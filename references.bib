  author = {Colella, Marina and Biran, Val{\'e}rie and Baud, Olivier},
  year = {2016},
  month = nov,
  journal = {Early human development},
  volume = {102},
  pages = {1--3},
  doi = {10.1016/j.earlhumdev.2016.09.001},
  abstract = {Brain injury related to preterm birth and neonatal asphyxia is a leading cause of childhood neuromotor and cognitive disabilities. Unfortunately, the strategies to prevent perinatal brain damages remain limited. Among the candidate molecules, melatonin appears to be one of the most promising agents for its antioxidant and neuromodulatory action. Robust preclinical evidences and few clinical studies have suggested a neuroprotective benefit conferred by neonatal exposure to melatonin. This review recapitulates current basic research, safety and pharmacokinetic data and ongoing clinical trials on the use of melatonin as a neuroprotective agent in the newborn.},
  affiliation = {Neonatal intensive care unit, Assistance Publique-H{\^o}pitaux de Paris, Robert Debr{\'e} Children's hospital, University Paris-Diderot, Sorbone Paris Cit{\'e}, Inserm U1141, Paris, France.},
