@article{tangMeatDairybasedComplementary2018,
  title = {A Meat- or Dairy-Based Complementary Diet Leads to Distinct Growth Patterns in Formula-Fed Infants: A Randomized Controlled Trial.},
  author = {Tang, Minghua and Hendricks, Audrey E and Krebs, Nancy F},
  year = {2018},
  month = may,
  journal = {The American journal of clinical nutrition},
  volume = {107},
  number = {5},
  pages = {734--742},
  doi = {10.1093/ajcn/nqy038},
  abstract = {Background:Protein intake from cow milk-based infant formula has been associated with rapid weight gain and increased adiposity, but the effect of protein from complementary foods has not been prospectively evaluated, and the effect of protein from sources other than formula during complementary feeding is not clear. Objective:The aim of this study was to directly compare the effect of protein from 2 common complementary food sources, meat and dairy, on infant growth and weight trajectory. Design:Healthy term, formula-fed infants were recruited from the metro Denver area, matched by sex and race/ethnicity and randomly assigned to a meat or a dairy complementary food group from 5 to 12 mo of age. Total protein intake during this 7-mo intervention was {$\sim$}3 g {$\cdot$} kg-1 {$\cdot$} d-1 for both groups. Intakes of infant formula, cereal, fruit, and vegetables were ad libitum. Caregivers also completed 3-d diet records at 5, 10, and 12 mo of age. Anthropometric measures were obtained during monthly home visits, and blood samples were collected at 5 and 12 mo of age. Results:Sixty-four infants completed the intervention (meat: n = 32; dairy: n = 32). The average total protein intake (mean  SD) increased from 2.01  0.06 g {$\cdot$} kg-1 {$\cdot$} d-1 at 5 mo to 3.35 0.12 g {$\cdot$} kg-1 {$\cdot$} d-1 at 12 mo and did not differ between groups. Over time, weight and weight-for-age z score increased by 0.48  0.07. However, there was a significant group-by-time interaction for both length-for-age z score (LAZ) and weight-for-length z score (WLZ). Post hoc analysis showed that LAZ increased in the meat group (+0.33  0.09; P = 0.001 over time) and decreased in the dairy group (-0.30  0.10; P = 0.0002 over time); WLZ significantly increased in the dairy group (0.76  0.21; P = 0.000002 over time) compared with the meat group (0.30  0.17; P = 0.55 over time). Insulin-like growth factor I and insulin-like growth factor-binding protein 3 both increased over time without group differences. Conclusions:Protein source may have an important role in regulating growth. In these formula-fed older infants, meat- and dairy-based complementary foods led to distinct growth patterns, especially for length. This trial was registered at www.clinicaltrials.gov as NCT02142647.},
  affiliation = {Section of Nutrition, Department of Pediatrics, University of Colorado School of Medicine, Aurora, CO.},
  date-added = {2018-05-16T14:50:28GMT},
  date-modified = {2022-04-30T18:17:00GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/A/2018/Tang/2018\%20Tang\%20Am.\%20J.\%20Clin.\%20Nutr-1.pdf},
  pmcid = {PMC6128676},
  pmid = {29722841},
  rating = {0},
  uri = {papers3://publication/doi/10.1093/ajcn/nqy038},
  file = {/Users/nately/Zotero/storage/8IM4WMVK/2018 Tang Am. J. Clin. Nutr-1.pdf}
}

