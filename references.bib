@article{solomonRiskMajorNSAID2017,
  title = {The Risk of Major {{NSAID}} Toxicity with Celecoxib, Ibuprofen, or Naproxen: {{A}} Secondary Analysis of the {{PRECISION}} Trial},
  author = {Solomon, Daniel H and Husni, M Elaine and Libby, Peter A and Yeomans, Neville D and Lincoff, A Michael and Lyscher, Thomas F and Menon, Venu and Brennan, Danielle M and Wisniewski, Lisa M and Nissen, Steven E and Borer, Jeffrey S},
  year = {2017},
  month = dec,
  journal = {The American Journal of Medicine},
  volume = {130},
  number = {12},
  pages = {1415--1422.e4},
  publisher = {Elsevier},
  doi = {10.1016/j.amjmed.2017.06.028},
  abstract = {{\textexclamdown}h2{\textquestiondown}Abstract{\textexclamdown}/h2{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Background{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}The relative safety of long-term use of nonsteroidal anti-inflammatory drugs is unclear. Patients and providers are interested in an integrated view of risk . We examined the risk of major nonsteroidal anti-inflammatory drug toxicity in the PRECISION trial.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Methods{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}We conducted a post hoc analysis of a double-blind, randomized, controlled, multicenter trial enrolling 24,081 patients with osteoarthritis or rheumatoid arthritis at moderate or high cardiovascular risk. Patients were randomized to receive celecoxib 100 to 200 mg twice daily, ibuprofen 600 to 800 mg thrice daily, or naproxen 375 to 500 mg twice daily. All patients were provided with a proton pump inhibitor. The outcome was major nonsteroidal anti-inflammatory drug toxicity, including time to first occurrence of major adverse cardiovascular events, important gastrointestinal events, renal events, and all-cause mortality.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}During follow-up, 4.1\% of subjects sustained any major toxicity in the celecoxib arm, 4.8\% in the naproxen arm, and 5.3\% in the ibuprofen arm. Analyses adjusted for aspirin use and geographic region found that subjects in the naproxen arm had a 20\% (95\% CI 4-39) higher risk of major toxicity than celecoxib users and that 38\% (95\% CI 19-59) higher risk. These risks translate into numbers needed to harm of 135 (95\% CI, 72-971) for naproxen and 82 (95\% CI, 53-173) for ibuprofen, both compared with celecoxib.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Among patients with symptomatic arthritis who had moderate to high risk of cardiovascular events, approximately 1 in 20 experienced a major toxicity over 1 to 2 years. Patients using naproxen or ibuprofen experienced significantly higher risk of major toxicity than those using celecoxib.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Brigham and Women's Hospital, Boston, Mass. Electronic address: dsolomon@partners.org.},
  date-added = {2020-03-01T21:30:04GMT},
  date-modified = {2022-03-21T19:09:30GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/9D/9D50796C-1E9B-42AF-A0D6-8AFF6FE66518.pdf},
  pmid = {28756267},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.amjmed.2017.06.028},
  keywords = {NNH,NSAIDs,risk},
  file = {/Users/nately/Zotero/storage/SQPD5YKW/Solomon et al. - 2017 - The risk of major NSAID toxicity with celecoxib, i.pdf}
}

