  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/I/2016/Imanimoghaddam/2016\%20Imanimoghaddam\%20Imaging\%20Sci\%20Dent.pdf},
  pmcid = {PMC4925649},
