@article{siegelBirthIllegitimateLinear2015,
  title = {The Birth of the Illegitimate Linear No-Threshold Model: {{An}} Invalid Paradigm for Estimating Risk Following Low-Dose Radiation Exposure.},
  author = {Siegel, Jeffry A and Pennington, Charles W and Sacks, Bill and Welsh, James S},
  year = {2015},
  month = nov,
  journal = {American journal of clinical oncology},
  volume = {41},
  number = {2},
  pages = {1--177},
  doi = {10.1097/COC.0000000000000244},
  abstract = {This paper examines the birthing process of the linear no-threshold model with respect to genetic effects and carcinogenesis. This model was conceived {\textquestiondown}70 years ago but still remains a foundational element within much of the scientific thought regarding exposure to low-dose ionizing radiation. This model is used today to provide risk estimates for cancer resulting from any exposure to ionizing radiation down to zero dose, risk estimates that are only theoretical and, as yet, have never been conclusively demonstrated by empirical evidence. We are literally bathed every second of every day in low-dose radiation exposure due to natural background radiation, exposures that vary annually from a few mGy to 260 mGy, depending upon where one lives on the planet. Irrespective of the level of background exposure to a given population, no associated health effects have been documented to date anywhere in the world. In fact, people in the United States are living longer today than ever before, likely due to always improving levels of medical care, including even more radiation exposure from diagnostic medical radiation (eg, x-ray and computed tomography imaging examinations) which are well within the background dose range across the globe. Yet, the persistent use of the linear no-threshold model for risk assessment by regulators and advisory bodies continues to drive an unfounded fear of any low-dose radiation exposure, as well as excessive expenditures on putative but unneeded and wasteful safety measures.},
  affiliation = {*Nuclear Physics Enterprises, Marlton, NJ NAC International, Norcross, GA Emeritus Medical Officer, FDA Center for Devices and Radiological Health, Rockville, MD {\S}Department of Radiation Oncology, Stritch School of Medicine Loyola University Chicago, Maywood, IL.},
  date-added = {2016-02-12T19:06:35GMT},
  date-modified = {2022-04-30T18:16:15GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/A/2015/Siegel/2015\%20Siegel\%20Am.\%20J.\%20Clin.\%20Oncol.pdf},
  pmid = {26535990},
