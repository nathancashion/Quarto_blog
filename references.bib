@article{rohatgiAddressingLifestylePatterns2024,
  title = {Addressing {{Lifestyle Patterns Among South Asian Individuals}} in the {{US}}: {{Implementing Meaningful Clinical Change Remains}} a {{Challenge}}},
  shorttitle = {Addressing {{Lifestyle Patterns Among South Asian Individuals}} in the {{US}}},
  author = {Rohatgi, Anand and Sharma, Parul and Anand, Sonia S.},
  year = {2024},
  month = sep,
  journal = {JAMA Cardiology},
  issn = {2380-6583},
  doi = {10.1001/jamacardio.2024.2832},
  urldate = {2024-09-11},
  abstract = {Lifestyle patterns, including diet, physical activity, and mental health, contribute significantly to cardiometabolic disorders by preventing or delaying their onset when ideal, and by exacerbating or accelerating their onset when less than ideal. These healthy active living strategies are incorporated globally into cardiovascular prevention guidelines, supported mostly by observational studies and a handful of randomized trials focused on improvements in risk factors such as blood pressure, blood glucose, and lipids. Randomized clinical trials (RCTs) with hard cardiovascular disease (CVD) outcomes such as the DASH and PREDIMED trials further support the benefits of intentionally modifying diet to prevent CVD. South Asian individuals represent about 25\% of the global population and over 60\% of the global coronary heart disease nonfatal and fatal events, signifying their excess CVD risk. The American College of Cardiology/American Heart Association and Canadian Cardiovascular Society prevention guidelines have labeled South Asian ethnicity as a CVD risk factor, and multiple observational studies have demonstrated that poor diet quality and low physical activity contribute to this excess risk. Therefore, studies focused on improvement in lifestyle are particularly relevant in South Asian individuals to reduce their excess CVD risk.},
  keywords = {asia,asian,culturally adapted,culture,CVD,RCT}
}

