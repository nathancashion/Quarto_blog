  journal = {JAMA},
  series = {{{JAMA Revisited}}},
  issn = {0098-7484},
  doi = {10.1001/jama.2023.18361},
  urldate = {2024-07-11},
  abstract = {Only a few years have elapsed since the existence of vitamins was first brought prominently to attention. The claims for the existence of such accessory food factors were received with skepticism for some time, for it seemed unlikely that substances playing a prominent part in nutrition could have escaped recognition so long. Most of the earlier observations and deductions have now been tested repeatedly and found to be correct. Within less than a decade after Funk coined the word vitamin, he felt justified in stating that the subject of vitamins, already beyond the stage of hypothesis, is based on a firm foundation and has received universal recognition. In spite of this, we are well aware, he adds, that great gaps exist in our knowledge, so that we cannot regard the chapter as closed. The skepticism in regard to the existence of such special and unique dietary essentials---substances characterized by a disproportion between the apparent large importance of their functions and the small amounts in which they are ordinarily consumed---has in part arisen from the failure heretofore to isolate and identify the vitamins as chemical entities.{\dots}},
  file = {/Users/nately/Zotero/storage/ZY7EEEC8/2024 - Vitamin Confusion.pdf;/Users/nately/Zotero/storage/Z4G8CUE7/2820977.html}
}

@article{vlaeyenLowBackPain2018,
  title = {Low Back Pain.},
  author = {Vlaeyen, Johan W S and Maher, Chris G and Wiech, Katja and Van Zundert, Jan and Meloto, Carolina Beraldo and Diatchenko, Luda and Batti{\'e}, Michele C and Goossens, Marielle and Koes, Bart and Linton, Steven J},
  year = {2018},
  month = dec,
  journal = {Nature reviews. Disease primers},
  volume = {4},
  number = {1},
  pages = {52},
  doi = {10.1038/s41572-018-0052-1},
  abstract = {Low back pain affects individuals of all ages and is a leading contributor to disease burden worldwide. Despite advancements in assessment and treatment methods, the management of low back pain remains a challenge for researchers and clinicians alike. One reason for the limited success in identifying effective treatments is the large variation in the manifestations, possible causes, precipitating and maintaining factors, course, prognosis and consequences in terms of activity interference and quality of life. However, despite these challenges, steady progress has been achieved in the understanding of back pain, and important steps in the understanding of the psychological and social risk factors, genetics and brain mechanisms of low back pain have been made. These new findings have given impetus to the development of new diagnostic procedures, evidence-based screening methods and more targeted interventions, which underscore the need for a multidisciplinary approach to the management of low back pain that integrates biological, psychological and social aspects.},
  affiliation = {Research Group Health Psychology, University of Leuven, Leuven, Belgium. johannes.vlaeyen@kuleuven.be.},
  date-added = {2019-08-10T02:12:18GMT},
