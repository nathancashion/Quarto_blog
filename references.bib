@article{poppeWHODigitalHealth2021,
  title = {{{WHO}} Digital Health Packages for Disseminating Data Standards and Data Use Practices},
  author = {Poppe, Olav and S{\ae}b{\o}, Johan Ivar and Braa, J{\o}rn},
  year = {2021},
