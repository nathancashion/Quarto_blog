  shorttitle = {Amsterdam 2022 Process},
  author = {Schneider, Kathryn J. and Patricios, Jon S. and Meeuwisse, Willem and Schneider, Geoff M. and Hayden, K. Alix and Premji, Zahra and Ahmed, Osman Hassan and Blauwet, Cheri and Broglio, Steven and Cantu, Robert C. and Davis, Gavin A. and Dvorak, Jiri and Echemendia, Ruben J. and Emery, Carolyn A. and Iverson, Grant L. and Leddy, John J. and Makdissi, Michael and McCrea, Michael and McNamee, Michael and Putukian, Margot and Yeates, Keith Owen and Black, Amanda M. and Burma, Joel S. and Critchley, Meghan and Eliason, Paul H. and R{\"a}is{\"a}nen, Anu M. and Tabor, Jason B. and Toomey, Clodagh and Ronksley, Paul E. and Cassidy, J. David},
  year = {2023},
  month = jun,
  journal = {British Journal of Sports Medicine},
  volume = {57},
  number = {11},
  pages = {712--721},
  publisher = {{BMJ Publishing Group Ltd and British Association of Sport and Exercise Medicine}},
  issn = {0306-3674, 1473-0480},
  doi = {10.1136/bjsports-2022-106663},
  urldate = {2024-08-20},
  abstract = {The purpose of this paper is to summarise the consensus methodology that was used to inform the International Consensus Statement on Concussion in Sport (Amsterdam 2022). Building on a Delphi process to inform the questions and outcomes from the 5th International Conference on Concussion in Sport, the Scientific Committee identified key questions, the answers to which would help encapsulate the current science in sport-related concussion and help guide clinical practice. Over 3{$\frac{1}{2}$} years, delayed by 2 years due to the pandemic, author groups conducted systematic reviews on each selected topic. The 6th International Conference on Concussion in Sport was held in Amsterdam (27--30 October 2022) and consisted of 2 days of systematic review presentations, panel discussions, question and answer engagement with the 600 attendees, and abstract presentations. This was followed by a closed third day of consensus deliberations by an expert panel of 29 with observers in attendance. The fourth day, also closed, was dedicated to a workshop to discuss and refine the sports concussion tools (Concussion Recognition Tool 6 (CRT6), Sport Concussion Assessment Tool 6 (SCAT6), Child SCAT6, Sport Concussion Office Assessment Tool 6 (SCOAT6) and Child SCOAT6). We include a summary of recommendations for methodological improvements for future research that grew out of the systematic reviews.},
  chapter = {Discussion},
  copyright = {{\copyright} Author(s) (or their employer(s)) 2023. No commercial re-use. See rights and permissions. Published by BMJ.},
  langid = {english},
  pmid = {37316208},
  keywords = {Brain Concussion,Consensus,Methodology,Sport},
  file = {/Users/nately/Zotero/storage/WFQXGPLY/Schneider et al. - 2023 - Amsterdam 2022 process A summary of the methodology for the Amsterdam International Consensus on Co.pdf}
}

