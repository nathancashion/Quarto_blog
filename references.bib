@article{schulmanAIAloneWill2023,
  title = {{{AI Alone Will Not Reduce}} the {{Administrative Burden}} of {{Health Care}}},
  author = {Schulman, Kevin A. and Nielsen, Jr, Perry Kent and Patel, Kavita},
  year = {2023},
