  file = {/Users/nately/Zotero/storage/85D24EHK/2012 Murray Lancet.pdf}
}

@article{murrayDoesReductionSerum2015,
  title = {Does a Reduction in Serum Sodium Concentration or Serum Potassium Concentration Increase the Prevalence of Exercise-Associated Muscle Cramps?},
  author = {Murray, Donal and Miller, Kevin C and Edwards, Jeffrey E},
  year = {2015},
  month = may,
  journal = {Journal of sport rehabilitation},
