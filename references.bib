@article{westendorfMusculoskeletalKnowledgePortal2021,
  title = {The {{Musculoskeletal Knowledge Portal}}: Improving Access to Multi-Omics Data},
  author = {Westendorf, Jennifer J and Bonewald, Lynda F and Kiel, Douglas P and Burtt, No{\"e}l P},
  year = {2021},
  month = oct,
  journal = {Nature Reviews Rheumatology},
  pages = {1--2},
  publisher = {Springer US},
  doi = {10.1038/s41584-021-00711-1},
  abstract = {Musculoskeletal diseases include more than 150 con- ditions and are a leading cause of chronic disability1. The development of genotyping and sequencing tech- nologies and computational resources for assembling genomes over the past two decades has produced an unprecedented opportunity to decipher the genetic and epigenetic underpinnings of disease. At the present time, genomic information is rarely used for diagnosing musculoskeletal diseases and is limited to early-onset forms and monogenic syndromes. This gap in apply- ing genomic information prevents early diagnosis and treatment of musculoskeletal diseases. Without geneti- cally determined targets, large phase II and III clinical trials of biologic agents might be less likely to succeed. The Musculoskeletal Knowledge Portal (MSK-KP) aims to bridge this gap by making genomic data relevant to musculoskeletal diseases accessible to the public.},
  date-added = {2021-10-22T19:25:54GMT},
  date-modified = {2022-03-21T19:10:28GMT},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/N/2021/Westendorf/2021\%20Westendorf\%20Nature\%20Reviews\%20Rheumatology.pdf},
  rating = {0},
