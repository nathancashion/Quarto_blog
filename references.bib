@article{jabreEffectBagmaskVentilation2018,
  title = {Effect of Bag-Mask Ventilation vs Endotracheal Intubation during Cardiopulmonary Resuscitation on Neurological Outcome after out-of-Hospital Cardiorespiratory Arrest},
  author = {Jabre, Patricia and Penaloza, Andrea and Pinero, David and Duchateau, Francois-Xavier and Borron, Stephen W and Javaudin, Francois and Richard, Olivier and {de Longueville}, Diane and Bouilleau, Guillem and Devaud, Marie-Laure and Heidet, Matthieu and Lejeune, Caroline and Fauroux, Sophie and Greingor, Jean-Luc and Manara, Alessandro and Hubert, Jean-Christophe and Guihard, Bertrand and Vermylen, Olivier and Lievens, Pascale and Auffret, Yannick and Maisondieu, Celine and Huet, Stephanie and Claessens, Beno{\^i}t and Lapostolle, Frederic and Javaud, Nicolas and Reuter, Paul-Georges and Baker, Elinor and Vicaut, Eric and Adnet, Fr{\'e}d{\'e}ric},
  year = {2018},
  month = feb,
  journal = {JAMA : the journal of the American Medical Association},
  volume = {319},
  number = {8},
  pages = {779--9},
  publisher = {American Medical Association},
  doi = {10.1001/jama.2018.0156},
  abstract = {{\textexclamdown}h3{\textquestiondown}Importance{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Bag-mask ventilation (BMV) is a less complex technique than endotracheal intubation (ETI) for airway management during the advanced cardiac life support phase of cardiopulmonary resuscitation of patients with out-of-hospital cardiorespiratory arrest. It has been reported as superior in terms of survival.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Objectives{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}To assess noninferiority of BMV vs ETI for advanced airway management with regard to survival with favorable neurological function at day 28.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Design, Settings, and Participants{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Multicenter randomized clinical trial comparing BMV with ETI in 2043 patients with out-of-hospital cardiorespiratory arrest in France and Belgium. Enrollment occurred from March 9, 2015, to January 2, 2017, and follow-up ended January 26, 2017.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Intervention{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Participants were randomized to initial airway management with BMV (n = 1020) or ETI (n = 1023).{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Main Outcomes and Measures{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}The primary outcome was favorable neurological outcome at 28 days defined as cerebral performance category 1 or 2. A noninferiority margin of 1\% was chosen. Secondary end points included rate of survival to hospital admission, rate of survival at day 28, rate of return of spontaneous circulation, and ETI and BMV difficulty or failure.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Among 2043 patients who were randomized (mean age, 64.7 years; 665 women [32\%]), 2040 (99.8\%) completed the trial. In the intention-to-treat population, favorable functional survival at day 28 was 44 of 1018 patients (4.3\%) in the BMV group and 43 of 1022 patients (4.2\%) in the ETI group (difference, 0.11\% [1-sided 97.5\% CI, 1.64\% to infinity];{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown}for noninferiority = .11). Survival to hospital admission (294/1018 [28.9\%] in the BMV group vs 333/1022 [32.6\%] in the ETI group; difference, 3.7\% [95\% CI, 7.7\% to 0.3\%]) and global survival at day 28 (55/1018 [5.4\%] in the BMV group vs 54/1022 [5.3\%] in the ETI group; difference, 0.1\% [95\% CI, 1.8\% to 2.1\%]) were not significantly different. Complications included difficult airway management (186/1027 [18.1\%] in the BMV group vs 134/996 [13.4\%] in the ETI group; difference, 4.7\% [95\% CI, 1.5\% to 7.9\%];{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .004), failure (69/1028 [6.7\%] in the BMV group vs 21/996 [2.1\%] in the ETI group; difference, 4.6\% [95\% CI, 2.8\% to 6.4\%];{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} \&lt; .001), and regurgitation of gastric content (156/1027 [15.2\%] in the BMV group vs 75/999 [7.5\%] in the ETI group; difference, 7.7\% [95\% CI, 4.9\% to 10.4\%];{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} \&lt; .001).{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions and Relevance{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Among patients with out-of-hospital cardiorespiratory arrest, the use of BMV compared with ETI failed to demonstrate noninferiority or inferiority for survival with favorable 28-day neurological function, an inconclusive result. A determination of equivalence or superiority between these techniques requires further research.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Trial Registration{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}clinicaltrials.gov Identifier:NCT02327026{\textexclamdown}/p{\textquestiondown}},
  date-added = {2018-03-09T21:03:06GMT},
  date-modified = {2022-04-30T18:16:48GMT},
  langid = {english},
