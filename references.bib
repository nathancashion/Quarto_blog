@article{brittonDoesFlyMatter1998,
  title = {Does the Fly Matter? The {{CRACKPOT}} Study in Evidence Based Trout Fishing. {{The}} Collaborative Randomised and Controlled Kennet Piscatorial Options Trail ({{CRACKPOT}}) Investigators.},
  author = {Britton, B J and Evans, J G and Potter, J M},
