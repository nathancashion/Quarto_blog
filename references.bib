@article{hoytDigitalFamilyHistories2013,
  title = {Digital {{Family Histories}} for {{Data Mining}}},
  author = {Hoyt, Robert and Linnville, Steven and Chung, Hui-Min and Hutfless, Brent and Rice, Courtney},
