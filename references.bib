@article{niggRunningShoesRunning2015,
  title = {Running Shoes and Running Injuries: Mythbusting and a Proposal for Two New Paradigms: `Preferred Movement Path' and `Comfort Filter'},
  author = {Nigg, B M and Baltich, J and Hoerzer, S and Enders, H},
  year = {2015},
  month = oct,
  journal = {British Journal of Sports Medicine},
  volume = {49},
  number = {20},
  pages = {1290--1294},
  publisher = {{BMJ Publishing Group Ltd and British Association of Sport and Exercise Medicine}},
  doi = {10.1136/bjsports-2015-095054},
  abstract = {{\textexclamdown}p{\textquestiondown}In the past 100 years, running shoes experienced dramatic changes. The question then arises whether or not running shoes (or sport shoes in general) influence the frequency of running injuries at all. This paper addresses five aspects related to running injuries and shoe selection, including (1) the changes in running injuries over the past 40 years, (2) the relationship between sport shoes, sport inserts and running injuries, (3) previously researched mechanisms of injury related to footwear and two new paradigms for injury prevention including (4) the `preferred movement path' and (5) the `comfort filter'. Specifically, the data regarding the relationship between impact characteristics and ankle pronation to the risk of developing a running-related injury is reviewed. Based on the lack of conclusive evidence for these two variables, which were once thought to be the prime predictors of running injuries, two new paradigms are suggested to elucidate the association between footwear and injury. These two paradigms, `the preferred movement path' and `the comfort filter', suggest that a runner intuitively selects a comfortable product using their own comfort filter that allows them to remain in the preferred movement path. This may automatically reduce the injury risk and may explain why there does not seem to be a secular trend in running injury rates.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Faculty of Kinesiology, Human Performance Laboratory, University of Calgary, Calgary, Alberta, Canada.},
  date-added = {2019-05-29T21:08:24GMT},
  date-modified = {2022-03-21T19:09:05GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/B/2015/Nigg/2015\%20Nigg\%20Br\%20J\%20Sports\%20Med.pdf},
  pmid = {26221015},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1136/bjsports-2015-095054},
  file = {/Users/nately/Zotero/storage/J7KLVRTU/2015 Nigg Br J Sports Med.pdf}
}

@article{nijsSpineBrainRecent2017,
  title = {In the Spine or in the Brain? {{Recent}} Advances in Pain Neuroscience Applied in the Intervention for Low Back Pain.},
  author = {Nijs, Jo and Clark, Jacqui and Malfliet, Anneleen and Ickmans, Kelly and Voogt, Lennard and Don, Sanneke and {den Bandt}, Hester and Goubert, Dorien and Kregel, Jeroen and Coppieters, Iris and Dankaerts, Wim},
  year = {2017},
  month = sep,
  journal = {Clinical and experimental rheumatology},
  volume = {35 Suppl 107},
  number = {5},
  pages = {108--115},
  abstract = {Conservative, surgical and pharmacological strategies for chronic low back pain (CLBP) management offer at best modest effect sizes in reducing pain and related disability, indicating a need for improvement. Such improvement may be derived from applying contemporary pain neuroscience to the management of CLBP. Current interventions for people with CLBP are often based entirely on a "biomedical" or "psychological" model without consideration of information concerning underlying pain mechanisms and contemporary pain neuroscience. Here we update readers with our current understanding of pain in people with CLBP, showing that CLBP is not limited to spinal impairments, but is also characterised by brain changes, including functional connectivity reorganisation in several brain regions and increased activation in brain regions of the so-called 'pain matrix' (or 'pain connectome'). Indeed, in a subgroup of the CLBP population brain changes associated with the presence of central sensitisation are seen. Understanding the role of these brain changes in CLBP improves our understanding not only of pain symptoms, but also of prevalent CLBP associated comorbidities such as sleep disturbances and fear avoidance behaviour. Applying contemporary pain neuroscience to improve care for people with CLBP includes identifying relevant pain mechanisms to steer intervention, addressing sleep problems and optimising exercise and activity interventions. This approach includes cognitively preparing patients for exercise therapy using (therapeutic) pain neuroscience education, followed by cognition-targeted functional exercise therapy.},
  affiliation = {Pain in Motion International Research Group; Dept.of Physiotherapy, Human Physiology and Anatomy, Faculty of Physical Education \& Physiotherapy, Vrije Universiteit Brussel; Dept.of Physical Medicine and Physiotherapy, University Hosp., Brussels, Belgium.},
  date-added = {2017-12-04T08:07:41GMT},
  date-modified = {2022-04-30T18:15:34GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/C/2017/Nijs/2017\%20Nijs\%20Clin\%20Exp\%20Rheumatol-1.pdf},
  pmid = {28967357},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/uuid/C82208A0-7632-465C-A77C-6D6D09895769},
  file = {/Users/nately/Zotero/storage/5MJP7YEH/2017 Nijs Clin Exp Rheumatol-1.pdf}
}

@article{niknejadAssociationPsychologicalInterventions2018,
  title = {Association between Psychological Interventions and Chronic Pain Outcomes in Older Adults: {{A}} Systematic Review and Meta-Analysis},
  author = {Niknejad, Bahar and Bolier, Ruth and Henderson, Charles R and Delgado, Diana and Kozlov, Elissa and L{\"o}ckenhoff, Corinna E and Reid, M Carrington},
  year = {2018},
  month = may,
  journal = {JAMA internal medicine},
  volume = {178},
  number = {6},
  pages = {830},
  doi = {10.1001/jamainternmed.2018.0756},
  abstract = {{\textexclamdown}h3{\textquestiondown}Importance{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Chronic noncancer pain (hereafter referred to as{\textexclamdown}i{\textquestiondown}chronic pain{\textexclamdown}/i{\textquestiondown}) is common among older adults and managed frequently with pharmacotherapies that produce suboptimal outcomes. Psychological treatments are recommended, but little information is available regarding their efficacy in older adults.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Objective{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}To determine the efficacy of psychological interventions in older adults with chronic pain and whether treatment effects vary by participant, intervention, and study characteristics.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Data Sources{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}MEDLINE, Embase, PsycINFO, and the Cochrane Library were searched from inception to March 29, 2017.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Study Selection{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Analysis included studies that (1) used a randomized trial design, (2) evaluated a psychological intervention that used cognitive behavioral modalities alone or in combination with another strategy, (3) enrolled individuals with chronic pain (pain 3 months) with a sample mean age of 60 years or older, and (4) reported preintervention and postintervention quantitative data.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Data Extraction and Synthesis{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Two of the authors independently extracted data. A mixed-model meta-analysis tested the effects of treatment on outcomes. Analyses were performed to investigate the association between participant (eg, age), intervention (eg, treatment mode delivery), and study (eg, methodologic quality) characteristics with outcomes.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Main Outcomes and Measures{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Pain intensity was the primary outcome; secondary outcomes included pain interference, depressive symptoms, anxiety, catastrophizing beliefs, self-efficacy for managing pain, physical function, and physical health.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Twenty-two studies with 2608 participants (1799 [69.0\%] women) were analyzed. Participants' mean (SD) age was 71.9 (7.1) years. Differences of standardized mean differences (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown}) at posttreatment were pain intensity (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.181,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .006), pain interference (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.133,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .12), depressive symptoms (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.128,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .14), anxiety (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.205,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .09), catastrophizing beliefs (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.184,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .046), self-efficacy (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.193,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .02), physical function (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.006,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .96), and physical health (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.160,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .24). There was evidence of effects persisting beyond the posttreatment assessment only for pain (d{\textexclamdown}sub{\textquestiondown}D{\textexclamdown}/sub{\textquestiondown} = 0.251,{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .002). In moderator analyses, only mode of therapy (group vs individual) demonstrated a consistent effect in favor of group-based therapy.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions and Relevance{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Psychological interventions for the treatment of chronic pain in older adults have small benefits, including reducing pain and catastrophizing beliefs and improving pain self-efficacy for managing pain. These results were strongest when delivered using group-based approaches. Research is needed to develop and test strategies that enhance the efficacy of psychological approaches and sustainability of treatment effects among older adults with chronic pain.{\textexclamdown}/p{\textquestiondown}},
  date-added = {2018-05-14T17:24:44GMT},
  date-modified = {2022-04-30T18:16:59GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2018/Niknejad/2018\%20Niknejad\%20JAMA\%20Intern\%20Med-1.pdf},
  rating = {0},
  uri = {papers3://publication/doi/10.1001/jamainternmed.2018.0756},
  file = {/Users/nately/Zotero/storage/A29CINVV/2018 Niknejad JAMA Intern Med-1.pdf}
}

