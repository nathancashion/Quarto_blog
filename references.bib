@article{maniValidityReliabilityInternetbased2017,
  title = {Validity and Reliability of {{Internet-based}} Physiotherapy Assessment for Musculoskeletal Disorders: A Systematic Review},
  shorttitle = {Validity and Reliability of {{Internet-based}} Physiotherapy Assessment for Musculoskeletal Disorders},
  author = {Mani, Suresh and Sharma, Shobha and Omar, Baharudin and Paungmali, Aatit and Joseph, Leonard},
  year = {2017},
  month = apr,
  journal = {Journal of Telemedicine and Telecare},
  volume = {23},
  number = {3},
  pages = {379--391},
  publisher = {SAGE Publications},
  issn = {1357-633X},
  doi = {10.1177/1357633X16642369},
  urldate = {2024-06-23},
  abstract = {PurposeThe purpose of this review is to systematically explore and summarise the validity and reliability of telerehabilitation (TR)-based physiotherapy assessment for musculoskeletal disorders.MethodA comprehensive systematic literature review was conducted using a number of electronic databases: PubMed, EMBASE, PsycINFO, Cochrane Library and CINAHL, published between January 2000 and May 2015. The studies examined the validity, inter- and intra-rater reliabilities of TR-based physiotherapy assessment for musculoskeletal conditions were included. Two independent reviewers used the Quality Appraisal Tool for studies of diagnostic Reliability (QAREL) and the Quality Assessment of Diagnostic Accuracy Studies (QUADAS) tool to assess the methodological quality of reliability and validity studies respectively.ResultsA total of 898 hits were achieved, of which 11 articles based on inclusion criteria were reviewed. Nine studies explored the concurrent validity, inter- and intra-rater reliabilities, while two studies examined only the concurrent validity. Reviewed studies were moderate to good in methodological quality. The physiotherapy assessments such as pain, swelling, range of motion, muscle strength, balance, gait and functional assessment demonstrated good concurrent validity. However, the reported concurrent validity of lumbar spine posture, special orthopaedic tests, neurodynamic tests and scar assessments ranged from low to moderate.ConclusionTR-based physiotherapy assessment was technically feasible with overall good concurrent validity and excellent reliability, except for lumbar spine posture, orthopaedic special tests, neurodynamic testa and scar assessment.},
  langid = {english},
  file = {/Users/nately/Zotero/storage/IKDUVUYX/Mani et al. - 2017 - Validity and reliability of Internet-based physiotherapy assessment for musculoskeletal disorders a.pdf}
}

@article{mannarinoSenolyticTreatmentLow2025,
  title = {Senolytic Treatment for Low Back Pain},
  author = {Mannarino, Matthew and Cherif, Hosni and Ghazizadeh, Saber and Martinez, Oliver Wu and Sheng, Kai and Cousineau, Elsa and Lee, Seunghwan and Millecamps, Magali and Gao, Chan and Gilbert, Alice and Peirs, Cedric and Naeini, Reza Sharif and Ouellet, Jean A. and S. Stone, Laura and Haglund, Lisbet},
  year = {2025},
  month = mar,
  journal = {Science Advances},
  volume = {11},
  number = {11},
  pages = {eadr1719},
  doi = {10.1126/sciadv.adr1719},
  urldate = {2025-04-21},
  abstract = {Senescent cells (SnCs) accumulate because of aging and external cellular stress throughout the body. They adopt a senescence-associated secretory phenotype (SASP) and release inflammatory and degenerative factors that actively contribute to age-related diseases, such as low back pain (LBP). The senolytics, o-vanillin and RG-7112, remove SnCs in human intervertebral discs (IVDs) and reduce SASP release, but it is unknown whether they can treat LBP. sparc-/- mice, with LBP, were treated orally with o-vanillin and RG-7112 as single or combination treatments. Treatment reduced LBP and SASP factor release and removed SnCs from the IVD and spinal cord. Treatment also lowered degeneration scores in the IVDs, improved vertebral bone quality, and reduced the expression of pain markers in the spinal cord. Together, our data suggest RG-7112 and o-vanillin as potential disease-modifying drugs for LBP and other painful disorders linked to cell senescence.},
  file = {/Users/nately/Zotero/storage/IXGTQC35/Mannarino et al. - 2025 - Senolytic treatment for low back pain.pdf}
}

