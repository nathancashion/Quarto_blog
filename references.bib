@article{dabhiAssessingLinkStatins,
  title = {Assessing the {{Link Between Statins}} and {{Insulin Intolerance}}: {{A Systematic Review}}},
  shorttitle = {Assessing the {{Link Between Statins}} and {{Insulin Intolerance}}},
  author = {Dabhi, Karan Nareshbhai and Gohil, Namra V and Tanveer, Nida and Hussein, Sally and Pingili, Shravya and Makkena, Vijaya Krishna and Jaramillo, Arturo P and Awosusi, Babatope L and Ayyub, Javaria and Nath, Tuheen Sankar},
  journal = {Cureus},
  volume = {15},
  number = {7},
  pages = {e42029},
  issn = {2168-8184},
  doi = {10.7759/cureus.42029},
  urldate = {2023-08-04},
  abstract = {There has been mixed and inconclusive evidence regarding the relationship between statin usage and insulin intolerance. This systematic review aims to comprehensively explore the link between the use of statins and insulin intolerance. We systematically searched MEDLINE, PubMed, PubMed Central (PMC), and Google Scholar databases for online English articles with full text. We excluded conference proceedings, editorials, commentaries, preclinical studies, abstracts, and preprints. The search across databases initially identified 667 articles. After eliminating duplicates and analyzing the remaining articles based on the inclusion and exclusion criteria, 11 articles were selected. The included studies had a total of 46,728,889 participants. The findings suggest that the use of statins is associated with a decrease in insulin sensitivity and insulin resistance. This systematic review provides evidence that the use of statins may have an adverse effect on insulin sensitivity and increase insulin resistance. These findings may have important clinical implications for individuals on statin therapy, especially those at risk of developing diabetes.},
  pmcid = {PMC10351747},
  pmid = {37465091},
  file = {/Users/nately/Zotero/storage/7KNMAEP4/Dabhi et al. - Assessing the Link Between Statins and Insulin Intolerance A Systematic Review.pdf}
}

