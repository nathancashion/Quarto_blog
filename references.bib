@article{hatzis50yearFollowupSeven2013,
  title = {A 50-Year Follow-up of the {{Seven Countries Study}}: {{Prevalence}} of Cardiovascular Risk Factors, Food and Nutrient Intakes among {{Cretans}}.},
  author = {Hatzis, Christos M and Papandreou, Christopher and Patelarou, Evridiki and Vardavas, Constantine I and Kimioni, Eleni and {Sifaki-Pistolla}, Dimitra and Vergetaki, Anna and Kafatos, Anthony G},
  year = {2013},
  month = jul,
  journal = {Hormones (Athens, Greece)},
  volume = {12},
  number = {3},
  pages = {379--385},
  doi = {10.1007/BF03401303},
  abstract = {OBJECTIVE:To identify the cardiovascular disease (CVD) risk-factor status and dietary habits of the surviving elderly participants of the initial Seven Countries Study (SCS) cohort and newly recruited middle-aged men from the same villages. DESIGN:Our total cohort of remaining survivors of the SCS consisted of 27 men aged 90 years old and over, while a younger cross-sectional study of 85 men between 53 and 73 years of age of the same catchment area were also examined. Biochemical, anthropometric, dietetic and lifestyle CVD risk factors information was obtained. RESULTS:It was found that being overweight and having systolic blood pressure higher than the recommended were highly prevalent ({\textquestiondown}75\%) among both age groups as well as abdominal obesity (about 50\%). Hypercholesterolemia was highly prevalent in the younger population (68.8\%), while smoking rates were relatively low among elderly. The daily meat consumption of SCS participants had doubled, from 35g in the 1960s to 76g among the SCS survivors in 2010 (p=0.002), while daily fruit and vegetable consumption had dropped from 656g to 266g (p{\textexclamdown}0.001). The younger participants also had increased dietary meat (130g/day) (p{\textexclamdown}0.001) and decreased fruits-vegetables intake (412g/day) (p{\textexclamdown}0.001) compared to 50 years ago. However, the younger population and elderly subjects showed higher fish intake (91g/day and 38g/day respectively, p{\textexclamdown}0.001) compared to 1960 and favorable olive oil consumption. In regard to nutrient intake, the majority of the subjects did not meet the recommendations for CVD prevention. CONCLUSIONS:The study population is at increased risk for the development of CVD, while current dietary habits of the SCS survivors partially differed from those of 50 years ago.},
  affiliation = {Department of Social Medicine, Preventive Medicine and Nutrition Clinic, Medical School, University of Crete, Greece.},
  date-added = {2019-01-21T18:59:36GMT},
  date-modified = {2022-03-21T19:08:54GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/B7/B7A841E9-1100-418C-B85F-CEF5C0C65C3C.pdf},
  pmid = {24121379},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1007/BF03401303},
  keywords = {Cholesterol,CVD,LCHF,lipids,nutrition}
}

@article{haugenManualTherapyInfantile2011,
