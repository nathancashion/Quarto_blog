  pmid = {34121482},
  rating = {0},
  uri = {papers3://publication/doi/10.1177/21925682211022311},
  keywords = {Spine,surgery,Telemedicine},
  file = {/Users/nately/Zotero/storage/RE7SAM3L/2021 Riew Global Spine Journal.pdf}
}

@article{righardEffectDeliveryRoom1990,
  title = {Effect of Delivery Room Routines on Success of First Breast-Feed.},
  author = {Righard, L and Alade, M O},
  year = {1990},
  month = nov,
  journal = {The Lancet},
  volume = {336},
  number = {8723},
  pages = {1105--1107},
  doi = {10.1016/0140-6736(90)92579-7},
  abstract = {72 infants delivered normally were observed for 2 h after birth. In the separation group (n = 34), the infant was placed on the mother's abdomen immediately after birth but removed after about 20 min for measuring and dressing. In the contact group (n = 38) contact between mother and infant was uninterrupted for at least 1 h. After about 20 min the infants began to make crawling movements towards the breast; the rooting reflex soon came into play, and at an average of 50 min after birth most of the infants were sucking at the breast. More infants in the contact group than in the separation group showed the correct sucking technique (24/38 vs 7/34). 40 (56\%) of the 72 mothers had received pethidine during labour; the infants were also sedated and most of them (25/40) did not suck at all. It is suggested that contact between mother and infant should be uninterrupted during the first hour after birth or until the first breast-feed has been accomplished, and that use of drugs such as pethidine should be restricted.},
  affiliation = {Department of Paediatrics, University of Lund, Malm{\"o} General Hospital, Sweden.},
  date-added = {2017-11-01T23:12:02GMT},
  date-modified = {2022-04-30T18:15:08GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/L/1990/Righard/1990\%20Righard\%20The\%20Lancet-1.pdf},
  pmid = {1977988},
