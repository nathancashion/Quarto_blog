@article{huttonAssociationsScreenbasedMedia2020,
  title = {Associations between Screen-Based Media Use and Brain White Matter Integrity in Preschool-Aged Children},
  author = {Hutton, John S and Dudley, Jonathan and {Horowitz-Kraus}, Tzipi and DeWitt, Tom and Holland, Scott K},
  year = {2020},
  month = jan,
  journal = {JAMA Pediatrics},
  volume = {174},
  number = {1},
  pages = {e193869--e193869},
  publisher = {American Medical Association},
  doi = {10.1001/jamapediatrics.2019.3869},
  abstract = {{\textexclamdown}h3{\textquestiondown}Importance{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}The American Academy of Pediatrics (AAP) recommends limits on screen-based media use, citing its cognitive-behavioral risks. Screen use by young children is prevalent and increasing, although its implications for brain development are unknown.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Objective{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}To explore the associations between screen-based media use and integrity of brain white matter tracts supporting language and literacy skills in preschool-aged children.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Design, Setting, and Participants{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}This cross-sectional study of healthy children aged 3 to 5 years (n = 47) was conducted from August 2017 to November 2018. Participants were recruited at a US children's hospital and community primary care clinics.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Exposures{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Children completed cognitive testing followed by diffusion tensor imaging (DTI), and their parent completed a ScreenQ survey.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Main Outcomes and Measures{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}ScreenQ is a 15-item measure of screen-based media use reflecting the domains in the AAP recommendations: access to screens, frequency of use, content viewed, and coviewing. Higher scores reflect greater use. ScreenQ scores were applied as the independent variable in 3 multiple linear regression models, with scores in 3 standardized assessments as the dependent variable, controlling for child age and household income: Comprehensive Test of Phonological Processing, Second Edition (CTOPP-2; Rapid Object Naming subtest); Expressive Vocabulary Test, Second Edition (EVT-2; expressive language); and Get Ready to Read! (GRTR; emergent literacy skills). The DTI measures included fractional anisotropy (FA) and radial diffusivity (RD), which estimated microstructural organization and myelination of white matter tracts. ScreenQ was applied as a factor associated with FA and RD in whole-brain regression analyses, which were then narrowed to 3 left-sided tracts supporting language and emergent literacy abilities.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Of the 69 children recruited, 47 (among whom 27 [57\%] were girls, and the mean [SD] age was 54.3 [7.5] months) completed DTI. Mean (SD; range) ScreenQ score was 8.6 (4.8; 1-19) points. Mean (SD; range) CTOPP-2 score was 9.4 (3.3; 2-15) points, EVT-2 score was 113.1 (16.6; 88-144) points, and GRTR score was 19.0 (5.9; 5-25) points. ScreenQ scores were negatively correlated with EVT-2 ({\textexclamdown}i{\textquestiondown}F{\textexclamdown}/i{\textquestiondown}{\textexclamdown}sub{\textquestiondown}2,43{\textexclamdown}/sub{\textquestiondown} = 5.14;{\textexclamdown}i{\textquestiondown}R{\textexclamdown}/i{\textquestiondown}{\textexclamdown}sup{\textquestiondown}2{\textexclamdown}/sup{\textquestiondown} = 0.19;{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} \&lt; .01), CTOPP-2 ({\textexclamdown}i{\textquestiondown}F{\textexclamdown}/i{\textquestiondown}{\textexclamdown}sub{\textquestiondown}2,35{\textexclamdown}/sub{\textquestiondown} = 6.64;{\textexclamdown}i{\textquestiondown}R{\textexclamdown}/i{\textquestiondown}{\textexclamdown}sup{\textquestiondown}2{\textexclamdown}/sup{\textquestiondown} = 0.28;{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} \&lt; .01), and GRTR ({\textexclamdown}i{\textquestiondown}F{\textexclamdown}/i{\textquestiondown}{\textexclamdown}sub{\textquestiondown}2,44{\textexclamdown}/sub{\textquestiondown} = 17.08;{\textexclamdown}i{\textquestiondown}R{\textexclamdown}/i{\textquestiondown}{\textexclamdown}sup{\textquestiondown}2{\textexclamdown}/sup{\textquestiondown} = 0.44;{\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} \&lt; .01) scores, controlling for child age. Higher ScreenQ scores were correlated with lower FA and higher RD in tracts involved with language, executive function, and emergent literacy abilities ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} \&lt; .05, familywise error--corrected), controlling for child age and household income.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions and Relevance{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}This study found an association between increased screen-based media use, compared with the AAP guidelines, and lower microstructural integrity of brain white matter tracts supporting language and emergent literacy skills in prekindergarten children. The findings suggest further study is needed, particularly during the rapid early stages of brain development.{\textexclamdown}/p{\textquestiondown}},
  date-added = {2022-02-17T10:50:59GMT},
  date-modified = {2022-03-21T19:10:53GMT},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2020/Hutton/2020\%20Hutton\%20JAMA\%20Pediatr.pdf},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1001/jamapediatrics.2019.3869},
  file = {/Users/nately/Zotero/storage/5RFWK4JW/2020 Hutton JAMA Pediatr.pdf}
}

