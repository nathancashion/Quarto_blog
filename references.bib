@article{carrickShortLongtermEffectiveness2015,
  title = {Short- and Long-Term Effectiveness of a Subjects Specific Novel Brain and Vestibular Rehabilitation Treatment Modality in Combat Veterans Suffering from {{PTSD}}},
  author = {Carrick, Frederick Robert and Pagnacco, Guido and McLellan, Kate and Solis, Ross and Shores, Jacob and Fredieu, Andre and Brock, Joel Brandon and Randall, Cagan and Wright, Cameron and Oggero, Elena},
  year = {2015},
  month = jun,
  journal = {Frontiers in Public Health},
  volume = {3},
  pages = {15--11},
  doi = {10.3389/fpubh.2015.00151},
