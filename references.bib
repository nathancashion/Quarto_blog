@article{wyonAssessmentMaximumAerobic2016,
  title = {Assessment of Maximum Aerobic Capacity and Anaerobic Threshold of Elite Ballet Dancers.},
  author = {Wyon, Matthew A and Allen, Nick and Cloak, Ross and Beck, Sarah and Davies, Paul and Clarke, Frances},
  year = {2016},
  month = sep,
  journal = {Medical problems of performing artists},
  volume = {31},
  number = {3},
  pages = {145--150},
  doi = {10.21091/mppa.2016.3027},
  abstract = {An athlete's cardiorespiratory profile, maximal aerobic capacity, and anaerobic threshold is affected by training regimen and competition demands. The present study aimed to ascertain whether there are company rank differences in maximal aerobic capacity and anaerobic threshold in elite classical ballet dancers. Seventy-four volunteers (M 34, F 40) were recruited from two full-time professional classical ballet companies. All participants completed a continuous incremental treadmill protocol with a 1-km/hr speed increase at the end of each 1-min stage until termination criteria had been achieved (e.g., voluntary cessation, respiratory exchange ratio {\textexclamdown}1.15, HR 5 bpm of estimated HRmax). Peak VO2 (5-breathe smooth) was recorded and anaerobic threshold calculated using ventilatory curve and ventilatory equivalents methods. Statistical analysis reported between-subject effects for gender (F1,67=35.18, p{\textexclamdown}0.001) and rank (F1,67=8.67, p{\textexclamdown}0.001); post hoc tests reported soloists (39.55.15 mL/kg/min) as having significantly lower VO2 peak than artists (45.95.75 mL/kg/min, p{\textexclamdown}0.001) and principal dancers (48.073.24 mL/kg/min, p{\textexclamdown}0.001). Significant differences in anaerobic threshold were reported for age (F1,67=7.68, p=0.008) and rank (F1,67=3.56, p=0.034); post hoc tests reported artists (75.85.45\%) having significantly lower anaerobic threshold than soloists (80.95.71, p{\textexclamdown}0.01) and principals (84.14.84\%, p{\textexclamdown}0.001). The observed differences in VO2 peak and anaerobic threshold between the ranks in ballet companies are probably due to the different rehearsal and performance demands.},
  affiliation = {Research Centre for Sport, Exercise, and Performance, University of Wolverhampton, Gorway Rd., Walsall WS1 3BD, UK. Tel +44-1902-323144. m.wyon@wlv.ac.uk.},
  date-added = {2016-10-26T04:02:26GMT},
  date-modified = {2022-03-21T19:08:43GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/F5/F51A9884-EBD1-42DA-9CD6-19023CD6AF47.pdf},
  pmid = {27575290},
  rating = {0},
  uri = {papers3://publication/doi/10.21091/mppa.2016.3027},
  file = {/Users/nately/Zotero/storage/TPJ865RP/Wyon et al. - 2016 - Assessment of maximum aerobic capacity and anaerob.pdf}
}

