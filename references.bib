@article{blumCervicalArteryDissection2015,
  title = {Cervical {{Artery Dissection}}: {{A Review}} of the {{Epidemiology}}, {{Pathophysiology}}, {{Treatment}}, and {{Outcome}}},
  shorttitle = {Cervical {{Artery Dissection}}},
  author = {Blum, Christina A. and Yaghi, Shadi},
