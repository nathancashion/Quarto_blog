@article{osullivanCognitiveFunctionalTherapy2018,
  title = {Cognitive Functional Therapy: {{An}} Integrated Behavioral Approach for the Targeted Management of Disabling Low Back Pain.},
  author = {O'Sullivan, Peter B and Caneiro, J P and O'Keeffe, Mary and Smith, Anne and Dankaerts, Wim and Fersum, Kjartan and O'Sullivan, Kieran},
  year = {2018},
  month = may,
  journal = {Physical therapy},
  volume = {98},
