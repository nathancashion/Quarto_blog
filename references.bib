@article{gouirandKetogenicHMGCoALyase2022,
  title = {Ketogenic {{HMG}}-{{CoA}} Lyase and Its Product {$\beta$}-hydroxybutyrate Promote Pancreatic Cancer Progression},
  author = {Gouirand, Victoire and Gicquel, Tristan and Lien, Evan C and Jaune-Pons, Emilie and Da Costa, Quentin and Finetti, Pascal and Metay, Elodie and Duluc, Camille and Mayers, Jared R and Audebert, Stephane and Camoin, Luc and Borge, Laurence and Rubis, Marion and Leca, Julie and Nigri, Jeremy and Bertucci, Fran{\c c}ois and Dusetti, Nelson and Iovanna, Juan Lucio and Tomasini, Richard and Bidaut, Ghislain and Guillaumond, Fabienne and Vander Heiden, Matthew G and Vasseur, Sophie},
  year = {2022},
  month = may,
  journal = {The EMBO Journal},
  volume = {41},
  number = {9},
  pages = {e110466},
  publisher = {John Wiley \& Sons, Ltd},
  issn = {0261-4189},
  doi = {10.15252/embj.2021110466},
  urldate = {2024-01-31},
  abstract = {Pancreatic ductal adenocarcinoma (PDA) tumor cells are deprived of oxygen and nutrients and therefore must adapt their metabolism to ensure proliferation. In some physiological states, cells rely on ketone bodies to satisfy their metabolic needs, especially during nutrient stress. Here, we show that PDA cells can activate ketone body metabolism and that {$\beta$}-hydroxybutyrate ({$\beta$}OHB) is an alternative cell-intrinsic or systemic fuel that can promote PDA growth and progression. PDA cells activate enzymes required for ketogenesis, utilizing various nutrients as carbon sources for ketone body formation. By assessing metabolic gene expression from spontaneously arising PDA tumors in mice, we find HMG-CoA lyase (HMGCL), involved in ketogenesis, to be among the most deregulated metabolic enzymes in PDA compared to normal pancreas. In vitro depletion of HMGCL impedes migration, tumor cell invasiveness, and anchorage-independent tumor sphere compaction. Moreover, disrupting HMGCL drastically decreases PDA tumor growth in vivo, while {$\beta$}OHB stimulates metastatic dissemination to the liver. These findings suggest that {$\beta$}OHB increases PDA aggressiveness and identify HMGCL and ketogenesis as metabolic targets for limiting PDA progression.},
  keywords = {-hydroxybutyrate,HMGCL,ketone bodies,metastasis,pancreatic cancer},
  file = {/Users/nately/Zotero/storage/K7ZPLB8W/Gouirand et al. - 2022 - Ketogenic HMG‐CoA lyase and its product β‐hydroxyb.pdf}
}

