@article{schlieterScaleupDigitalInnovations2022,
  title = {Scale-up of {{Digital Innovations}} in {{Health Care}}: {{Expert Commentary}} on {{Enablers}} and {{Barriers}}},
  shorttitle = {Scale-up of {{Digital Innovations}} in {{Health Care}}},
  author = {Schlieter, Hannes and Marsch, Lisa A and Whitehouse, Diane and Otto, Lena and Londral, Ana Rita and Teepe, Gisbert Wilhelm and Benedict, Martin and Ollier, Joseph and Ulmer, Tom and Gasser, Nathalie and Ultsch, Sabine and Wollschlaeger, Bastian and Kowatsch, Tobias},
  year = {2022},
