  urldate = {2025-06-26},
  abstract = {The global health workforce crisis poses a significant challenge to achieving universal health coverage (UHC), particularly in low- and middle-income countries (LMICs). Task-shifting, the delegation of clinical responsibilities to less-specialised health workers, has been widely implemented to address workforce shortages. While this strategy has improved healthcare access and efficiency, concerns persist regarding its long-term sustainability, quality of care and the risk of reinforcing systemic weaknesses. This commentary examines the benefits and limitations of task-shifting, highlighting its impact on healthcare outcomes, training and supervision challenges, and potential unintended consequences.},
