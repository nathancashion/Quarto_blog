  uri = {papers3://publication/doi/10.1007/s00421-005-0125-1},
  file = {/Users/nately/Zotero/storage/3FB6UDHF/2006 McLean Eur J Appl Physiol-1.pdf;/Users/nately/Zotero/storage/QA97N6PK/2006 McLean Eur J Appl Physiol-1.pdf;/Users/nately/Zotero/storage/RZT9WM2G/2006 McLean Eur J Appl Physiol.pdf}
