  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/C/2013/Brady/2013\%20Brady\%20Chiropr\%20Man\%20Therap-1.pdf},
  pmcid = {PMC4029163},
  pmid = {24499590},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1186/2045-709X-21-35},
  file = {/Users/nately/Zotero/storage/KKCPAETF/2013 Brady Chiropr Man Therap-1.pdf}
