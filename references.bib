  author = {Nolet, Paul S. and Yu, Hainan and C{\^o}t{\'e}, Pierre and Meyer, Anne-Laure and Kristman, Vicki L. and Sutton, Deborah and Murnaghan, Kent and Lemeunier, Nad{\`e}ge},
  year = {2021},
