@phdthesis{cashionNextStepsAltitude,
  type = {Poster},
  title = {Next {{Steps}} in {{Altitude Training Research}}},
  author = {Cashion, Nathan and Mason, Travis and Ramp, Brittni},
  address = {Portland, Oregon},
  abstract = {Humans have existed at high elevation for thousands of years. Legends speak of the supernatural ability of the Incans to run long distances or the Nepalese sherpas to climb great heights. Modern science has revealed physiological differences among these people, namely an increased oxygen carrying capacity due to higher levels of red blood cells and hemoglobin. Today, many athletes want to take advantage of altitude training to improve performance, but few are willing to make the long trek to these remote, elevated areas. Instead, they opt for a variety of devices to simulate altitude: hypobaric tents, training masks, and oxygen filters creating normobaric hypoxia. All of these devices attempt to lower the amount of oxygen available to the athlete, but by various mechanisms. How do all of these methods compare? Is the fraction of oxygen the key variable that stimulates an increase in oxygen carrying capacity? Are there physiological differences between hypobaric and normobaric hypoxia? Researchers have explored these questions, yet the volume of variables and differences in study methods leave many questions unanswered. This review will focus on the comparison of normobaric hypoxia and hypobaric hypoxia, attempting to evaluate whether there is an ideal training approach that leads to improved athletic performance.},
  copyright = {Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License (CC-BY-NC-SA)},
  langid = {english},
  school = {University of Western States},
  file = {/Users/nately/Zotero/storage/AE52DJH6/ACA Rehab Poster.pdf}
}

