@article{zafrenInducedHypothermia42degC2020,
  title = {Induced Hypothermia to 4.2{$^\circ$}{{C}} with Neurologically Intact Survival: {{A}} Forgotten Case Series},
  author = {Zafren, Ken and Paal, Peter and Brugger, Hermann and Lechner, Raimund},
  year = {2020},
  month = sep,
  journal = {Wilderness \& environmental medicine},
  volume = {31},
  number = {3},
  pages = {367--370},
  publisher = {Elsevier},
  doi = {10.1016/j.wem.2020.02.003},
  abstract = {{\textexclamdown}p{\textquestiondown}The lowest recorded core temperature from which a person with accidental hypothermia has survived neurologically intact is 11.8{$^\circ$}C in a 2-y-old boy. The lowest recorded temperature from which an adult has been resuscitated neurologically intact is 13.7{$^\circ$}C in a 29-y-old woman. The lowest core temperature with survival from induced hypothermia has been quoted as 9{$^\circ$}C. We discovered a case series (n=50) from 1961 in which 5 patients with core temperatures below 11.8{$^\circ$}C survived neurologically intact. The lowest core temperature in this group was 4.2{$^\circ$}C. The authors also presented cardiovascular and other physiologic data at various core temperatures. The patients in the case series showed a wide variation in individual physiological responses to hypothermia. It is not known whether survival from accidental hypothermia is possible with a core temperature below 11.8{$^\circ$}C, but this case series suggests that the lower limit for successful resuscitation may be far lower. We advise against using core temperature alone to decide whether a hypothermic patient in cardiac arrest has a chance of survival.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Department of Emergency Medicine, Alaska Native Medical Center, Anchorage, AK; Department of Emergency Medicine, Stanford University Medical Center, Stanford, CA; International Commission for Mountain Emergency Medicine (ICAR MEDCOM), Z{\"u}rich, Switzerland.},
  date-added = {2021-01-20T13:49:54GMT},
  date-modified = {2022-03-21T19:09:54GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/0F/0FEC912E-62C7-4347-95DB-7FFFDE6C1A57.pdf},
  pmid = {32482520},
