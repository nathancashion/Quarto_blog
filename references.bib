@inproceedings{melhartMomenttomomentEngagementPrediction2020,
  title = {Moment-to-Moment {{Engagement Prediction}} through the {{Eyes}} of the {{Observer}}: {{PUBG Streaming}} on {{Twitch}}},
  shorttitle = {Moment-to-Moment {{Engagement Prediction}} through the {{Eyes}} of the {{Observer}}},
  booktitle = {Proceedings of the 15th {{International Conference}} on the {{Foundations}} of {{Digital Games}}},
  author = {Melhart, David and Gravina, Daniele and Yannakakis, Georgios N.},
  year = {2020},
  month = sep,
  series = {{{FDG}} '20},
  pages = {1--10},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3402942.3402958},
  urldate = {2024-05-28},
  abstract = {Is it possible to predict moment-to-moment gameplay engagement based solely on game telemetry? Can we reveal engaging moments of gameplay by observing the way the viewers of the game behave? To address these questions in this paper, we reframe the way gameplay engagement is defined and we view it, instead, through the eyes of a game's live audience. We build prediction models for viewers' engagement based on data collected from the popular battle royale game PlayerUnknown's Battlegrounds as obtained from the Twitch streaming service. In particular, we collect viewers' chat logs and in-game telemetry data from several hundred matches of five popular streamers (containing over 100,000 game events) and machine learn the mapping between gameplay and viewer chat frequency during play, using small neural network architectures. Our key findings showcase that engagement models trained solely on 40 gameplay features can reach accuracies of up to 80\% on average and 84\% at best. Our models are scalable and generalisable as they perform equally well within- and across-streamers, as well as across streamer play styles.},
  isbn = {978-1-4503-8807-8},
  keywords = {artificial neural networks,battle royale games,engagement,Machine learning,PUBG,streaming,viewer modelling},
  file = {/Users/nately/Zotero/storage/ZX4G5IN6/Melhart et al. - 2020 - Moment-to-moment Engagement Prediction through the Eyes of the Observer PUBG Streaming on Twitch.pdf}
}

@article{melhemEOSBiplanarXray2016,
  title = {{{EOS}}{\textregistered} Biplanar {{X-ray}} Imaging: {{Concept}}, Developments, Benefits, and Limitations},
  shorttitle = {{{EOS}}{\textregistered} Biplanar {{X-ray}} Imaging},
  author = {Melhem, Elias and Assi, Ayman and El Rachkidi, Rami and Ghanem, Ismat},
  year = {2016},
  month = feb,
  journal = {Journal of Children's Orthopaedics},
  volume = {10},
  number = {1},
  pages = {1--14},
  publisher = {SAGE Publications},
  issn = {1863-2521},
  doi = {10.1007/s11832-016-0713-0},
  urldate = {2023-12-16},
  abstract = {Purpose In 1992, Georges Charpak invented a new type of X-ray detector, which in turn led to the development of the EOS{\textregistered} 2D/3D imaging system. This system takes simultaneous anteroposterior and lateral 2D images of the whole body and can be utilized to perform 3D reconstruction based on statistical models. The purpose of this review is to present the state of the art for this EOS{\textregistered} imaging technique, to report recent developments and advances in the technique, and to stress its benefits while also noting its limitations. Methods The review was based on a thorough literature search on the subject as well as personal experience gained from many years of using the EOS{\textregistered} system. Results While EOS{\textregistered} imaging could be proposed for many applications, it is most useful in relation to scoliosis and sagittal balance, due to its ability to take simultaneous orthogonal images while the patient is standing, to perform 3D reconstruction, and to determine various relationships among adjacent segments (cervical spine, pelvis, and lower limbs). The technique has also been validated for the study of pelvic and lower-limb deformity and pathology in adult and pediatric populations; in such a study it has the advantage of allowing the measurement of torsional deformity, which classically requires a CT scan. Conclusions The major advantages of EOS{\textregistered} are the relatively low dose of radiation (50--80 \% less than conventional X-rays) that the patient receives and the possibility of obtaining a 3D reconstruction of the bones. However, this 3D reconstruction is not created automatically; a well-trained operator is required to generate it. The EOS{\textregistered} imaging technique has proven itself to be a very useful research and diagnostic tool.},
  langid = {english},
  file = {/Users/nately/Zotero/storage/NTY3TI4Q/Melhem et al. - 2016 - EOS® biplanar X-ray imaging Concept, developments.pdf}
}

