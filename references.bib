@article{hillNewZealandersLow2023,
  title = {New {{Zealanders}} with Low Back Pain Seeking Healthcare: {{A}} Retrospective Descriptive Analysis of {{Accident Compensation Corporation-funded}} Low Back Pain Healthcare Service Usage},
  shorttitle = {New {{Zealanders}} with Low Back Pain Seeking Healthcare},
  author = {Hill, Julia and Kay, Dylan and Gordon, Jacob and Niazi, Imran and Saywell, Nicola},
  year = {2023},
  month = may,
  doi = {10.1071/HC23010},
  abstract = {Introduction: Most New Zealanders experience low back pain at least once throughout their lifetime and many seek help from the large range of health providers in primary care.  Accident Compensation Corporation (ACC) fund a significant proportion of those claims, but which services are they funding and what are the costs? Method: This was a retrospective audit and descriptive analysis of ACC-funded, non-public hospital healthcare service use by people with low back pain in NZ. Outcome measures were the healthcare services accessed by people with ACC-funded low back pain. The claims (all occurrences for a service that has generated a payment/year), single contact (with a service), and costs (NZ\$) for services between 2009-2020 Results: The number of claims for services were physiotherapy (129,000), GP (105,000) and radiology services (59,000). Per single contact, elective surgery and radiology services were the most expensive. During 2009-2020 there were 3.3 million ACC claims for low back pain with a total cost of NZ\$4billion. Over this time there was an increase in claims, costs and single contacts. During 2010 costs decreased slightly due to changes in healthcare funding and decreased in 2020 due to the COVID19 pandemic. Discussion: Consumers have considerable choice in where they access healthcare for ACC-funded LBP. This study shows the services they use most frequently and the cost to NZ for those services. These data can inform service planning for ACC-funded LBP in NZ},
  file = {/Users/nately/Zotero/storage/HMWZ4CZX/Hill et al. - 2023 - New Zealanders with low back pain seeking healthcare A retrospective descriptive analysis of Accident Compensation Corporation-funded low back pain healthcare service usage.pdf}
}

