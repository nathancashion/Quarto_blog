  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/8B/8B01DE6D-9CFD-4AFD-A7B8-196B48A90B3B.pdf},
  pmid = {2253845},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/uuid/28B334E5-BF46-4F91-888C-A95A6B7B1607}
