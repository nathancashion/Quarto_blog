@article{shelleyFaceChiropracticEvidencebased2015,
  title = {The Face of Chiropractic: Evidence-Based?},
  shorttitle = {The Face of Chiropractic},
  author = {Shelley, Jacob and Clark, Marianne and Caulfield, Timothy},
  year = {2015},
  journal = {Focus on Alternative and Complementary Therapies},
  volume = {20},
  number = {1},
  pages = {13--22},
  issn = {2042-7166},
  doi = {10.1111/fct.12151},
  urldate = {2024-07-18},
  abstract = {Background Chiropractors are the most accessed providers of complementary and alternative medicine care in Canada. However, some scepticism exists around the evidentiary base of the chiropractic profession. Objectives To examine the messages utilised by the chiropractic profession around issues of scope and efficacy through website communication with the public. Methods Website content of major Canadian chiropractic associations and colleges (n=11), and commercial clinics (n=80) was submitted to a mixed-methods analysis. Content was reviewed to quantify specific health conditions described as treatable by chiropractic care. A qualitative textual analysis identified the primary messages related to evidence and efficacy utilised by the websites. Results Website content claimed that chiropractic is capable of addressing a wide range of health issues. Quantitative analysis revealed that association and college websites identified a total of 41 unique conditions treatable by chiropractic, while private clinic websites named 159 distinct conditions. The most commonly cited conditions included back pain, headaches/migraines and neck pain. Qualitative analysis revealed three prominent themes drawn upon in discussions of efficacy and evidence: grounded in science, the conflation of safety and efficacy and ``natural'' healing. Conclusions The chiropractic profession claims the capacity to treat health conditions that exceed those more traditionally associated with chiropractic. Website content persistently declared that such claims are supported by research and scientific evidence, and at times blurred the lines between safety and efficacy. The chiropractic profession may be struggling to define themselves both within the paradigm of conventional science as well as an alternative paradigm that embraces natural approaches.},
  copyright = {{\copyright} 2014 Royal Pharmaceutical Society},
  langid = {english},
  keywords = {Chiropractic,complementary therapies - general,discourse analysis},
  file = {/Users/nately/Zotero/storage/IEFKKCDE/Shelley et al. - 2015 - The face of chiropractic evidence-based.pdf;/Users/nately/Zotero/storage/NT4UK6JJ/fct.html}
}

@article{shenoyInappropriateICDDischarge2017,
  title = {Inappropriate {{ICD}} Discharge Related to Electrical Muscle Stimulation in Chiropractic Therapy: {{A}} Case Report.},
  author = {Shenoy, Abhishek and Sharma, Abhishek and Achamyeleh, Firehiwot},
  year = {2017},
  month = mar,
  journal = {Cardiology and therapy},
  volume = {8},
  number = {5},
  pages = {863--143},
  doi = {10.1007/s40119-017-0086-6},
  abstract = {Implantable cardioverter defibrillators (ICDs) have been shown to reduce mortality in high-risk patients. Despite several advances in programming ICDs, inappropriate shocks persist and continue to be psychologically and physically disturbing. External electromagnetic interference from electrocautery, welding, acupunctures, low-output transcutaneous electric nerve stimulators, and electronic muscle stimulators may result in inappropriate ICD sensing and shock. We present a 63-year-old female who presented to the emergency department after an ICD shock while undergoing electronic muscle stimulation in chiropractic treatment, during which light electrical pulses were sent through skin electrodes. Our case highlights the importance of recognizing methods used by alternative medicine doctors, including electrical muscle stimulation that may cause electromagnetic interference and inappropriate ICD discharge and therefore, a higher overall mortality risk.},
  affiliation = {College of Medicine, SUNY Downstate Medical Center, Brooklyn, USA.},
  date-added = {2017-03-11T16:50:52GMT},
  date-modified = {2022-04-30T18:16:59GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/C/2017/Shenoy/2017\%20Shenoy\%20Cardiol\%20Ther-1.pdf},
  pmid = {28258389},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1007/s40119-017-0086-6},
  file = {/Users/nately/Zotero/storage/UNA44SMU/2017 Shenoy Cardiol Ther-1.pdf}
}

@article{shepherdCulturalAwarenessWorkshops2019,
  title = {Cultural Awareness Workshops: Limitations and Practical Consequences},
  shorttitle = {Cultural Awareness Workshops},
  author = {Shepherd, Stephane M.},
  year = {2019},
  month = jan,
  journal = {BMC Medical Education},
  volume = {19},
  number = {1},
  pages = {14},
  issn = {1472-6920},
  doi = {10.1186/s12909-018-1450-5},
  urldate = {2024-07-19},
  abstract = {Cultural awareness training for health professionals is now commonplace across a variety of sectors. Its popularity has spawned several alternatives (i.e., cultural competence, cultural safety, cultural humility, cultural intelligence) and overlapping derivatives (diversity training, anti-racism training, micro-aggression training). The ever-increasing reach of cultural awareness initiatives in health settings has generally been well intentioned - to improve cross-cultural clinical encounters and patient outcomes with the broader expectation of reducing health disparities. Yet the capacity of cultural awareness training to accomplish or even impact such outcomes is seldom comprehensively scrutinized. In response, this paper applies a much needed critical lens to cultural awareness training and its derivatives by examining their underpinning philosophies, assumptions and most importantly, verification of their effectiveness. The paper finds cultural awareness approaches to be over-generalizing, simplistic and impractical. They may even induce unintended negative consequences. Decades of research point to their failure to realize meaningful outcomes in health care settings and beyond. Broader expectations of their capacity to reduce health disparities are almost certainly unachievable. Alternative suggestions for improving cross-cultural health care interactions and research are discussed within.},
  keywords = {Cross-cultural health care,Cross-cultural psychology,cultural awareness,Cultural awareness,cultural competence,Cultural competence,Cultural humility,Cultural intelligence,Cultural safety,Cultural sensitivity,culture,Health professionals,international,training},
  file = {/Users/nately/Zotero/storage/85N8M4AG/Shepherd - 2019 - Cultural awareness workshops limitations and practical consequences.pdf;/Users/nately/Zotero/storage/KERW2WZK/s12909-018-1450-5.html}
}

@article{sheridanAchievementsLimitationsEvidencebased2016,
  title = {Achievements and Limitations of Evidence-Based Medicine.},
  author = {Sheridan, Desmond J and Julian, Desmond G},
  year = {2016},
  month = jul,
  journal = {Journal of the American College of Cardiology},
  volume = {68},
  number = {2},
  pages = {204--213},
  doi = {10.1016/j.jacc.2016.03.600},
  abstract = {Evidence-based medicine (EBM) has a long history, but was revived in the early 1990s by a campaign mounted by a movement that took its name. The EBM movement focused attention on the need for greater objectivity in medical decision-making and led to the Cochrane Collaboration, which provides reviews of evidence on the basis of comparative research. Important limitations of EBM's effect on medicine have also emerged. Failure to acknowledge the limitations of clinical trials and systematic reviews has limited their applicability to individual patients' circumstances. An almost exclusive focus on drugs and devices has left vast areas of health care in an evidence vacuum. An overdependence on commissions for its research may have limited its independence in selecting what it investigates. EBM needs to widen its scope beyond drugs and devices to address many areas that often lack evidence at present, notably, health policy, management, and reforms.},
  affiliation = {Division of National Heart and Lung Institute, Imperial College, London, United Kingdom. Electronic address: d.sheridan@ic.ac.uk.},
  date-added = {2017-04-10T02:56:39GMT},
  date-modified = {2022-04-30T18:16:47GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2016/Sheridan/2016\%20Sheridan\%20J.\%20Am.\%20Coll.\%20Cardiol-1.pdf},
  pmid = {27386775},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.jacc.2016.03.600},
  file = {/Users/nately/Zotero/storage/5XBCQEE4/2016 Sheridan J. Am. Coll. Cardiol-1.pdf}
}

@article{sherifiSymbioticRelationshipHealth2021,
  title = {The {{Symbiotic Relationship Between Health Information Management}} and {{Health Informatics}}: {{Opportunities}} for {{Growth}} and {{Collaboration}}},
