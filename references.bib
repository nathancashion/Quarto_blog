  volume = {31},
  number = {2},
  pages = {215--219},
  publisher = {Elsevier},
  doi = {10.1016/j.wem.2019.12.012},
  abstract = {{\textexclamdown}h3{\textquestiondown}Introduction{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Metallic survival blankets are multifunctional medical devices frequently used to provide thermal insulation in sport and leisure activities and in emergency care. To assess further properties of survival blankets, we investigated their breaking strength under laboratory conditions.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Methods{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}An experimental study was performed with 2 commercially available survival blankets used by emergency medical services. Breaking strength measured with a tensile testing machine was determined consecutively with 10 tests conducted per brand.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Breaking strength (meanSD) of the tested brands was 3.80.4 kN, (range: 2.8--4.1 kN) and 4.00.5 kN (range: 3.2--4.6 kN). When using the windlass of a commercially available tourniquet for the longitudinally folded survival blanket, the windlass bent at a force of 0.8 kN; when using a carabiner, the force exceeded 3.6 kN before failure occurred in both blanket brands.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Both brands of survival blankets show impressive tensile strength, indicating that they have the potential to serve as temporary pelvic binders or even as makeshift tourniquets when urgent bleeding control is needed.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Medical Division, Mountain Rescue Tyrol, Innsbruck, Austria.},
  date-added = {2021-01-20T13:46:57GMT},
  date-modified = {2022-04-30T18:19:01GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/W/2020/Isser/2020\%20Isser\%20Wilderness\%20Environ\%20Med-1.pdf},
  pmid = {32312648},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.wem.2019.12.012},
  file = {/Users/nately/Zotero/storage/ZLFBWG3A/2020 Isser Wilderness Environ Med-1.pdf}
}

