  title = {Is Manipulative Therapy More Effective than Sham Manipulation in Adults?: A Systematic Review and Meta-Analysis},
  author = {{Scholten-Peeters}, Gwendolijne GM and Thoomes, Erik and Konings, Sophie and Beijer, Michelle and Verkerk, Karin and Koes, Bart W and Verhagen, Arianne P},
  year = {2013},
