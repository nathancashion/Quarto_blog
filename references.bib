}

@article{nagataScreenTimeAddictive2025,
  title = {Beyond {{Screen Time}}---{{Addictive Screen Use Patterns}} and {{Adolescent Mental Health}}},
  author = {Nagata, Jason M. and Helmer, Christiane K. and {Al-Shoaibi}, Abubakr A.},
  year = {2025},
  month = jul,
  journal = {JAMA},
  volume = {334},
  number = {3},
  pages = {214--216},
  issn = {0098-7484},
  doi = {10.1001/jama.2025.8135},
  urldate = {2025-07-16},
  abstract = {Screen use, the time spent engaging with electronic devices such as mobile phones and tablets, can become addictive when individuals experience difficulty stopping despite attempts to do so, as well as symptoms of withdrawal, tolerance, conflict, and relapse (Box). Adolescence is a vulnerable period for addictive behaviors, and recent findings suggest that young adolescents are particularly susceptible to screen addiction. Notably, in the US, 48\% of young adolescents report losing track of how much they are using their phone, 25\% use social media to forget about their problems, and 25\% admit to spending a considerable amount of time thinking about social media apps. Furthermore, 17\% have tried to reduce their social media use but cannot, and 11\% acknowledge that their screen use has negatively affected their schoolwork. These statistics highlight the need to study screen addiction and its specific health effects, as understanding these behaviors is crucial for addressing the risks they pose to adolescents' well-being.},
  file = {/Users/nately/Zotero/storage/8YT2BB8E/Nagata et al. - 2025 - Beyond Screen Time—Addictive Screen Use Patterns and Adolescent Mental Health.pdf;/Users/nately/Zotero/storage/J35WMV5S/jama.2025.html}
}

