@article{trippaEmpiricalEvaluationsClinical2022,
  title = {Empirical {{Evaluations}} of {{Clinical Trial Designs}}},
  author = {Trippa, Lorenzo and Bacallado, Sergio},
  year = {2022},
  month = may,
  journal = {JAMA Network Open},
  volume = {5},
  number = {5},
  pages = {e2211620},
  issn = {2574-3805},
  doi = {10.1001/jamanetworkopen.2022.11620},
  urldate = {2022-05-12},
  abstract = {Broglio et al present an insightful comparison of 2 clinical trial designs: (1) the actual study design that was implemented in the Stroke Hyperglycemia Insulin Network Effort (SHINE) trial and (2) an alternative nonimplemented design. This comparison was planned before the SHINE study started enrolling patients. Each design can be described as a sequence of decisions after preplanned interim analyses and a plan for final analyses and reporting. The statistical design specifies how the study adapts to the interim data, including actions such early stopping and variations of the randomization probabilities. Broglio and coauthors describe what would have happened if the study team had followed the nonimplemented design. They provide the sequence of decisions that would have been made by using the data that were available for interim analyses during the SHINE clinical trial. Their study precisely mimics the interim decisions that would have been made.},
  file = {/Users/nately/Zotero/storage/2UXLVPWC/Trippa and Bacallado - 2022 - Empirical Evaluations of Clinical Trial Designs.pdf;/Users/nately/Zotero/storage/LUDCDALN/2792182.html}
}

