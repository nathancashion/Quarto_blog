@article{mohammed-rajputOpenMRSGlobalMedical2011,
  title = {{{OpenMRS}}, {{A Global Medical Records System Collaborative}}: {{Factors Influencing Successful Implementation}}},
  shorttitle = {{{OpenMRS}}, {{A Global Medical Records System Collaborative}}},
  author = {{Mohammed-Rajput}, Nareesa A. and Smith, Dawn C. and Mamlin, Burke and Biondich, Paul and Doebbeling, Brad N.},
  year = {2011},
  journal = {AMIA Annual Symposium Proceedings},
  volume = {2011},
  pages = {960--968},
  issn = {1942-597X},
  urldate = {2023-05-28},
  abstract = {OpenMRS is an open-source, robust electronic health record (EHR) platform that is supported by a large global network and used in over forty countries. We explored what factors lead to successful implementation of OpenMRS in resource constrained settings. Data sources included in-person and telephone key informant interviews, focus groups and responses to an electronic survey from 10 sites in 7 countries. Qualitative data was coded through independent coding, discussion and consensus. The most common perceived benefits of implementation were for providing clinical care, reporting to funders, managing operations and research. Successful implementation factors include securing adequate infrastructure, and sociotechnical system factors, particularly adequate staffing, computers, and ability to use software. Strategic and tactical planning were successful strategies, including understanding and addressing the infrastructure and human costs involved, training or hiring personnel technically capable of modifying the software and integrating it into the daily work flow to meet clinicians' needs.},
  pmcid = {PMC3243141},
  pmid = {22195155},
  file = {/Users/nately/Zotero/storage/LRMSGBZZ/Mohammed-Rajput et al. - 2011 - OpenMRS, A Global Medical Records System Collabora.pdf}
}

