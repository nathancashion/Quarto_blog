@article{babuMedicineExtremeEnvironments2020,
  title = {Medicine in Extreme Environments: {{A}} New Medical Student Elective Class for Wilderness, Aerospace, Hyperbaric, Exercise, and Combat Medicine},
  author = {Babu, Gautam and Upchurch, Bradley D and Young, William H and Levine, Benjamin D},
  year = {2020},
