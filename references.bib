  shorttitle = {Harnessing the Power of Clinical Decision Support Systems},
  author = {Chen, Zhao and Liang, Ning and Zhang, Haili and Li, Huizhen and Yang, Yijiu and Zong, Xingyu and Chen, Yaxin and Wang, Yanping and Shi, Nannan},
