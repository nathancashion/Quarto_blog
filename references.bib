  number = {3},
  pages = {301--304},
  doi = {10.1123/jsr.2014-0293},
  abstract = {Although exercise-associated muscle cramps (EAMC) are common in ultra-distance runners and athletes in general, their etiology remains unclear. EAMC are painful, sudden, involuntary contractions of skeletal muscle occurring during or after exercise and are recognized by visible bulging or knotting of the whole, or part of, a muscle.1 Many clinicians believe EAMC occur following an imbalance in electrolyte concentrations, specifically serum sodium concentration ([Na+]s) and serum potassium concentration ([K+]s)2. Studies that have established a link between EAMC occurrence and serum electrolyte concentrations following an athletic event are unhelpful.},
  affiliation = {Central Michigan University, Mount Pleasant, MI.},
  date-added = {2015-12-18T04:28:10GMT},
  date-modified = {2022-03-21T19:08:24GMT},
