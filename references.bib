@techreport{worldhealthorganization.regionalofficeforeuropeRehabilitationFactSheet2019,
  title = {Rehabilitation: Fact Sheet on {{Sustainable Development Goals}} ({{SDGs}}): Health Targets},
  shorttitle = {Rehabilitation},
  author = {{World Health Organization. Regional Office for Europe}},
  year = {2019},
  address = {Copenhagen},
  institution = {World Health Organization. Regional Office for Europe},
  urldate = {2022-06-21},
  abstract = {The Sustainable Development Goals (SDGs) aim to transform our world. They are a call to action to end poverty and inequality, protect the planet, and ensure that all people enjoy health, justice and prosperity. It is critical that no one is left behind. In 2015, all the countries in the United Nations adopted the 2030 Agenda for Sustainable Development. It sets out 17 Goals, which include 169 targets. These wide-ranging and ambitious Goals interconnect. SDG 3 is to ensure healthy lives and promote well-being for all at all ages. It has 13 targets measured through 26 indicators. However, a person's health and well-being are affected not only by disease and treatment, but also by social and economic factors such as housing, poverty and education. Health targets can therefore also be found across the other SDGs. As populations age and chronic health problems become increasingly prevalent, more people are living with multimorbidity and disability. For them, rehabilitation is essential for remaining as independent as possible, participating in education and work, and fulfilling meaningful roles in life. Rehabilitation should not be a luxury service: it can promote health, reduce complications and prevent decline, and it is a cost-effective investment. This fact sheet provides an overview of the issues, facts and figures, commitments, workforce needs, and a summary of Rehabilitation 2030: A Call for Action.},
  chapter = {16 p.},
  langid = {english},
  keywords = {Chronic Disease,Europe,Global Health,Health Services for Persons with Disabilities,Intersectoral Collaboration,Multimorbidity,Noncommunicable Diseases,Rehabilitation,Sustainable Development,trends,United Nations},
  annotation = {WHO/EURO:2019-2384-42139-58051},
  file = {/Users/nately/Zotero/storage/HKIZA5WF/World Health Organization. Regional Office for Europe - 2019 - Rehabilitation fact sheet on Sustainable Developm}
}

