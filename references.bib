  urldate = {2023-04-22},
  abstract = {Clinical guidelines for management of low back pain (LBP) are not routinely implemented in practice, and guidelines rarely offer tools for implementation. Therefore, we developed GLA:D{\textregistered} Back, a standardised intervention of patient education and supervised exercises. This pilot study tested the feasibility of implementing GLA:D Back in clinical practice in Denmark by delivering a course for physiotherapists and chiropractors. It should further inform the planning of an implementation-effectiveness study using a pre-post group design alongside nation-wide implementation.},
