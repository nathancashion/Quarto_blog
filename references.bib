@article{hsiehScreeningSevereObstructive2021,
  title = {Screening Severe Obstructive Sleep Apnea in Children with Snoring},
  author = {Hsieh, Hui-Shan and Kang, Chung-Jan and Chuang, Hai-Hua and Zhuo, Ming-Ying and Lee, Guo-She and Huang, Yu-Shu and Chuang, Li-Pang and Kuo, Terry B J and Yang, Cheryl C H and Lee, Li-Ang and Li, Hsueh-Yu},
  year = {2021},
  month = jul,
  journal = {Diagnostics},
  volume = {11},
  number = {7},
  pages = {1168},
  publisher = {Multidisciplinary Digital Publishing Institute},
  doi = {10.3390/diagnostics11071168},
  abstract = {Efficient screening for severe obstructive sleep apnea (OSA) is important for children with snoring before time-consuming standard polysomnography. This retrospective cross-sectional study aimed to compare clinical variables, home snoring sound analysis, and home sleep pulse oximetry on their predictive performance in screening severe OSA among children who habitually snored. Study 1 included 9 (23\%) girls and 30 (77\%) boys (median age of 9 years). Using univariate logistic regression models, 3\% oxygen desaturation index (ODI3)  6.0 events/h, adenoidal-nasopharyngeal ratio (ANR)  0.78, tonsil size = 4, and snoring sound energy of 801--1000 Hz  22.0 dB significantly predicted severe OSA in descending order of odds ratio. Multivariate analysis showed that ODI3  6.0 events/h independently predicted severe pediatric OSA. Among several predictive models, the combination of ODI3, tonsil size, and ANR more optimally screened for severe OSA with a sensitivity of 91\% and a specificity of 94\%. In Study 2 (27 (27\%) girls and 73 (73\%) boys; median age, 7 years), this model was externally validated to predict severe OSA with an accuracy of 76\%. Our results suggested that home sleep pulse oximetry, combined with ANR, can screen for severe OSA more optimally than ANR and tonsil size among children with snoring.},
  date-added = {2021-11-12T23:58:25GMT},
  date-modified = {2022-03-21T19:10:29GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/D/2021/Hsieh/2021\%20Hsieh\%20Diagnostics.pdf},
  rating = {0},
  uri = {papers3://publication/doi/10.3390/diagnostics11071168},
  keywords = {apnea,children,sleep,snoring},
  file = {/Users/nately/Zotero/storage/X5F2QDFG/2021 Hsieh Diagnostics.pdf}
}

