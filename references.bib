@article{porterImprovisedVsStandard2019,
  title = {Improvised vs Standard Cervical Collar to Restrict Spine Movement in the Backcountry Environment},
  author = {Porter, Anne and Difrancesca, Matthew and Slack, Sean and Hudecek, Laura and McIntosh, Scott E},
  year = {2019},
  month = nov,
  journal = {Wilderness \& environmental medicine},
  volume = {0},
  number = {0},
  pages = {412--416},
  publisher = {Elsevier},
  doi = {10.1016/j.wem.2019.07.002},
  abstract = {{\textexclamdown}h2{\textquestiondown}Abstract{\textexclamdown}/h2{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Introduction{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}To compare the effectiveness of a molded fleece jacket with that of a standard cervical collar at limiting movement of the cervical spine in 3 different directions.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Methods{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}This is a prospective study using 24 healthy volunteers to measure cervical flexion/extension, rotation, and lateral flexion with both the fleece collar and the standard cervical collar. A hand-held goniometer was used for measurements. The results were then analyzed for the 3 independent movements using a noninferiority test.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}The fleece collar was determined to be noninferior at limiting the designated motions. Comfort was greater while wearing the improvised fleece collar.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Our small study demonstrated that mountain travelers and rescuers may be able to use an improvised fleece jacket collar in place of a standard collar if spine trauma is suspected after a backcountry accident. Further research should examine different types of improvised collars, their ability to remain in place over extended evacuations, and when to apply collars to backcountry patients.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Division of Emergency Medicine, University of Utah, Salt Lake City, UT.},
  date-added = {2019-12-06T03:15:37GMT},
  date-modified = {2022-03-21T19:09:25GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/24/24480E87-8B4E-44AB-867F-9B4E68B00236.pdf},
  pmid = {31706730},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.wem.2019.07.002},
  file = {/Users/nately/Zotero/storage/CHS47WS7/Porter et al. - 2019 - Improvised vs standard cervical collar to restrict.pdf}
}

