  pages = {469--470},
  issn = {1067-5027},
  doi = {10.1093/jamia/ocx001},
  urldate = {2024-02-08},
  abstract = {Why are you passionate about informatics? What is your informatics story? If you attended the 2016 Annual Symposium, someone might have asked you these questions, or asked you to make a video to answer the questions. As informatics professionals, we might think these are silly or trivial questions, but they are a vital part of helping the informatics community grow and increase our influence in health and health care.As was noted in one of my previous letters, the AMIA Board of Directors believes that informatics is at a tipping point; it has been critical in yielding the insights necessary to improve health and health care in the United States and around the globe. Yet many people outside of our field do not understand what informatics is and the increasingly influential role it plays in many critical decision that affect how health IT is developed, implemented, optimized, and integrated into our daily lives. As individual ambassadors and part of the larger community within AMIA, we recognize the importance of communicating more clearly about informatics to increase our impact and enhance leadership for the profession.},
  file = {/Users/nately/Zotero/storage/2MDJZJXR/Payne and Fridsma - 2017 - Why informatics Discovering health insights. Accelerating health care transformation..pdf}
}

