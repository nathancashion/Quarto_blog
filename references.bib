@article{engelterCervicalArteryDissection2013,
  title = {Cervical Artery Dissection: Trauma and Other Potential Mechanical Trigger Events.},
  author = {Engelter, Stefan T and {Grond-Ginsbach}, Caspar and Metso, Tiina M and Metso, Antti J and Kloss, Manja and Debette, St{\'e}phanie and Leys, Didier and Grau, Armin and Dallongeville, Jean and Bodenant, Marie and Samson, Yves and Caso, Valeria and Pezzini, Alessandro and Bonati, Leo H and Thijs, Vincent and Gensicke, Henrik and Martin, Juan J and Bersano, Anna and Touz{\'e}, Emmanuel and Tatlisumak, Turgut and Lyrer, Philippe A and Brandt, Tobias and {Cervical Artery Dissection and Ischemic Stroke Patients Study Group}},
  year = {2013},
  month = may,
  journal = {Neurology},
  volume = {80},
  number = {21},
  pages = {1950--1957},
  publisher = {Wolters Kluwer Health, Inc. on behalf of the American Academy of Neurology},
  doi = {10.1212/WNL.0b013e318293e2eb},
  abstract = {OBJECTIVE:To examine the import of prior cervical trauma (PCT) in patients with cervical artery dissection (CeAD). METHODS:In this observational study, the presence of and the type of PCT were systematically ascertained in CeAD patients using 2 different populations for comparisons: 1) age- and sex-matched patients with ischemic stroke attributable to a cause other than CeAD (non-CeAD-IS), and 2) healthy subjects participating in the Cervical Artery Dissection and Ischemic Stroke Patients Study. The presence of PCT within 1 month was assessed using a standardized questionnaire. Crude odds ratios (ORs) with 95\% confidence intervals (CIs) and ORs adjusted for age, sex, and center were calculated. RESULTS:We analyzed 1,897 participants (n = 966 with CeAD, n = 651 with non-CeAD-IS, n = 280 healthy subjects). CeAD patients had PCT in 40.5\% (38.2\%-44.5\%) of cases, with 88\% (344 of 392) classified as mild. PCT was more common in CeAD patients than in non-CeAD-IS patients (ORcrude 5.6 [95\% CI 4.20-7.37], p {\textexclamdown} 0.001; ORadjusted 7.6 [95\% CI 5.60-10.20], p {\textexclamdown} 0.001) or healthy subjects (ORcrude 2.8 [95\% CI 2.03-3.68], p {\textexclamdown} 0.001; ORadjusted 3.7 [95\% CI 2.40-5.56], p {\textexclamdown} 0.001). CeAD patients with PCT were younger and presented more often with neck pain and less often with stroke than CeAD patients without PCT. PCT was not associated with functional 3-month outcome after adjustment for age, sex, and stroke severity. CONCLUSION:PCT seems to be an important environmental determinant of CeAD, but was not an independent outcome predictor. Because of the characteristics of most PCTs, the term mechanical trigger event rather than trauma may be more appropriate.},
  affiliation = {Department of Neurology, Basel University Hospital, Basel, Switzerland.},
  date-added = {2022-02-28T21:00:01GMT},
  date-modified = {2022-03-21T19:11:04GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/N/2013/Engelter/2013\%20Engelter\%20Neurology.pdf},
  pmid = {23635964},
  rating = {0},
  uri = {papers3://publication/doi/10.1212/WNL.0b013e318293e2eb},
  file = {/Users/nately/Zotero/storage/9ADDMHNA/2013 Engelter Neurology.pdf}
}

