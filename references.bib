  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/P/2015/Jones/2015\%20Jones\%20Proceedings\%20(Baylor\%20University.\%20Medical\%20Center)-1.pdf},
  pmcid = {PMC4264725},
