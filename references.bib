  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2008/Marchiori/2008\%20Marchiori\%20J\%20Manipulative\%20Physiol\%20Ther-1.pdf},
  pmid = {19028252},
