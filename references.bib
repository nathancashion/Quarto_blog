  uri = {papers3://publication/doi/10.1097/BRS.0000000000003548},
  file = {/Users/nately/Zotero/storage/8UAZD9XL/Sääksjärvi et al. - 2020 - Disc degeneration of young low back pain patients.pdf}
}

