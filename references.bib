  publisher = {Nature Publishing Group},
  doi = {10.1038/s41539-018-0024-y},
  abstract = {In recent years evidence has accumulated showing that interim testing of studied information facilitates learning and retrieval of new information---the forward testing effect. In the current article, we review the empirical evidence and putative mechanisms underlying this effect. The possible negative effects of administering interim tests and how these negative effects can be mitigated are discussed. We also propose some important directions for future research to explore. Finally, we summarize the practical implications for optimizing learning and teaching in educational settings.},
