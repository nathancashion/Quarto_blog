  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/C/2008/Choi/2008\%20Choi\%20Clinical\%20and\%20investigative\%20medicine.\%20Medecine\%20clinique\%20et\%20experimentale.pdf},
  pmid = {18312747},
  rating = {0},
  uri = {papers3://publication/doi/10.25011/cim.v31i1.3140},
  keywords = {multidisciplinary},
  file = {/Users/nately/Zotero/storage/RGKUSV7M/2008 Choi Clinical and investigative medicine. Medecine clinique et experimentale.pdf}
}

