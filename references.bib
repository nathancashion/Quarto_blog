@article{priceFiveyearFollowupHarms2012,
  title = {Five-Year Follow-up of Harms and Benefits of Behavioral Infant Sleep Intervention: {{Randomized}} Trial},
  author = {Price, Anna M H and Wake, Melissa and Ukoumunne, Obioha C and Hiscock, Harriet},
  year = {2012},
  month = oct,
  journal = {PEDIATRICS},
  volume = {130},
  number = {4},
  pages = {643--651},
  publisher = {American Academy of Pediatrics},
  doi = {10.1542/peds.2011-3467},
  abstract = {{\textexclamdown}h3{\textquestiondown}BACKGROUND AND OBJECTIVES:{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Randomized trials have demonstrated the short- to medium-term effectiveness of behavioral infant sleep interventions. However, concerns persist that they may harm children's emotional development and subsequent mental health. This study aimed to determine long-term harms and/or benefits of an infant behavioral sleep program at age 6 years on (1) child, (2) child-parent, and (3) maternal outcomes.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}METHODS:{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Three hundred twenty-six children (173 intervention) with parent-reported sleep problems at age 7 months were selected from a population sample of 692 infants recruited from well-child centers. The study was a 5-year follow-up of a population-based cluster-randomized trial. Allocation was concealed and researchers (but not parents) were blinded to group allocation. Behavioral techniques were delivered over 1 to 3 individual nurse consultations at infant age 8 to 10 months, versus usual care. The main outcomes measured were (1) child mental health, sleep, psychosocial functioning, stress regulation; (2) child-parent relationship; and (3) maternal mental health and parenting styles.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}RESULTS:{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Two hundred twenty-five families (69\%) participated. There was no evidence of differences between intervention and control families for any outcome, including (1) children's emotional ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .8) and conduct behavior scores ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .6), sleep problems (9\% vs 7\%, {\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .2), sleep habits score ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .4), parent- ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .7) and child-reported ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .8) psychosocial functioning, chronic stress (29\% vs 22\%, {\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .4); (2) child-parent closeness ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .1) and conflict ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .4), global relationship ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .9), disinhibited attachment ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .3); and (3) parent depression, anxiety, and stress scores ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .9) or authoritative parenting (63\% vs 59\%, {\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown} = .5).{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}CONCLUSIONS:{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Behavioral sleep techniques have no marked long-lasting effects (positive or negative). Parents and health professionals can confidently use these techniques to reduce the short- to medium-term burden of infant sleep problems and maternal depression.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Centre for Community Child Health, The Royal Children's Hospital, Flemington Rd, Parkville VIC 3052, Australia. anna.price@mcri.edu.au},
  date-added = {2018-07-24T22:35:56GMT},
  date-modified = {2022-04-30T18:17:01GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/P/2012/Price/2012\%20Price\%20PEDIATRICS.pdf},
  pmid = {22966034},
