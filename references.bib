  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/W/2015/Myers/2015\%20Myers\%20Wilderness\%20Environ\%20Med-1.pdf},
  pmid = {25935312},
  rating = {0},
  read = {Yes},
