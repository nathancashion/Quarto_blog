@article{morrisonOptimizingSpecialistPalliative2025,
  title = {Optimizing {{Specialist Palliative Care Referral}} to {{Improve Dementia Care}}},
  author = {Morrison, Laura J.},
  year = {2025},
  month = may,
  journal = {JAMA Network Open},
  volume = {8},
  number = {5},
  pages = {e2510304},
  issn = {2574-3805},
  doi = {10.1001/jamanetworkopen.2025.10304},
  urldate = {2025-05-15},
  abstract = {How can we best care for the rapidly increasing population of people with dementia and their loved ones worldwide? Specialist palliative care is crucial to optimizing dementia care globally. Identifying effective models for specialist palliative care integration into dementia care has been a challenge. Even models for specialist palliative care integration in severe dementia have been few and mostly single interventions in nursing homes. A key step to creating and testing models is to identify which elements in a patient's dementia course should trigger a referral to specialist palliative care. To date, proposed referral criteria have varied greatly without international consensus. This lack of standardization may mean that specialist palliative care teams do not meet patients and families who may benefit most from their interventions, or they may meet them later in their course with less time for benefit. More concerning, finite specialist palliative care resources across all settings may not be used most effectively.},
