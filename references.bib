@article{pestanaImprovingHealthCare2020,
  title = {Improving {{Health Care Management}} in {{Hospitals Through}} a {{Productivity Dashboard}}},
  author = {Pestana, Miguel and Pereira, Ruben and Moro, S{\'e}rgio},
