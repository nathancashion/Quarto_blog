@incollection{rosaCraniocervicalJunctionObservations2015,
  title = {The Craniocervical Junction: {{Observations}} Regarding the Relationship between Misalignment, Obstruction of Cerebrospinal Fluid Flow, Cerebellar Tonsillar Ectopia, and Image-Guided Correction},
  booktitle = {The Craniocervical Syndrome and {{MRI}}},
  author = {Rosa, Scott and Baird, John W},
  year = {2015},
  pages = {48--66},
  publisher = {Karger Publishers},
  doi = {10.1159/000365470},
  abstract = {The craniocervical junction is the most complex area of the spinal axis. Due to its complexity it is extremely vulnerable to injuries to the soft tissue stabilizing ligaments and membranous structures. Proper imaging in this area is an essential key to proper diagnosis directing towards the most appropriate and safe treatment options when injury occurs. Misalignments of C\&\#8320;-C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown}, C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown}-C{\textexclamdown}sub{\textquestiondown}2{\textexclamdown}/sub{\textquestiondown} brought on by head or neck trauma can manifest in different outcomes. Some of those outcomes can affect or cause neural compromise, and/or some may contribute to cerebrospinal fluid (CSF) flow obstruction as well as arteriovenous compromise. C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown} misalignment may also contribute to distention of the cerebellar tonsils (cerebellar tonsillar ectopia), i.e. down through the foramen magnum due to caudal tension by way of dentate ligament pathological stress on the spinal cord leading to obstruction of the normal flow of CSF. Mechanical compression of the jugular vein by the transverse process of C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown} has been found to lead to obstruction of outgoing venous blood flow. Such obstruction has been found in chronic cerebral spinal venous insufficiency which has been observed in neurodegenerative brain diseases such as multiple sclerosis. Image-Guided Atlas Treatment{\textexclamdown}sup{\textquestiondown}TM{\textexclamdown}/sup{\textquestiondown} (IGAT{\textexclamdown}sup{\textquestiondown}TM{\textexclamdown}/sup{\textquestiondown}) has been shown to be a method of gentle correction of misalignment of C\&\#8320;-C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown}, C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown}-C{\textexclamdown}sub{\textquestiondown}2{\textexclamdown}/sub{\textquestiondown}, resulting in improved CSF flow as well as venous outflow. Image-guided atlas treatment utilizes advanced dynamic upright MRI as the means of evaluating misalignments at the craniocervical junction, and the images obtained are used to calculate the appropriate alignment vectors to correct the misalignment. Post-correction advanced upright MRI images are then used to validate the appropriate realignment of C\&\#8320;-C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown}, C{\textexclamdown}sub{\textquestiondown}1{\textexclamdown}/sub{\textquestiondown}-C{\textexclamdown}sub{\textquestiondown}2{\textexclamdown}/sub{\textquestiondown} to establish improvement in proper CSF as well as arteriovenous flow.},
  date-added = {2021-05-20T22:30:53GMT},
  date-modified = {2022-03-21T19:10:13GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/0F/0F6A6620-F64C-483F-9DF1-0D03A24BA735.pdf},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1159/000365470}
}

