  keywords = {Special Issue},
  file = {/Users/nately/Zotero/storage/NQRXZZTV/2015 Campbell Clin J Sport Med-2.pdf}
}

@article{campbellRiskStratificationAthletes2015,
  title = {Risk Stratification for Athletes and Adventurers in High-Altitude Environments: {{Recommendations}} for Preparticipation Evaluation.},
  author = {Campbell, Aaron D and McIntosh, Scott E and Nyberg, Andy and Powell, Amy P and Schoene, Robert B and Hackett, Peter},
