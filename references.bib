@article{panagopoulosProspectiveComparisonChanges2017,
  title = {Prospective Comparison of Changes in Lumbar Spine {{MRI}} Findings over Time between Individuals with Acute Low Back Pain and Controls: {{An}} Exploratory Study.},
  author = {Panagopoulos, J and Magnussen, J S and Hush, J and Maher, C G and {Crites-Battie}, M and Jarvik, J G and Jensen, T S and Hancock, M J},
  year = {2017},
  month = sep,
  journal = {American journal of neuroradiology},
  volume = {38},
  number = {9},
  pages = {1826--1832},
  doi = {10.3174/ajnr.A5357},
  abstract = {BACKGROUND AND PURPOSE:The clinical importance of lumbar MR imaging findings is unclear. This study was an exploratory investigation of whether lumbar spine MR imaging findings change more commonly during a 12-week period in individuals with acute low back pain compared with pain-free controls. MATERIALS AND METHODS:Twenty individuals with recent-onset low back pain and 10 pain-free controls were recruited into an exploratory prospective cohort study. All participants had a lumbar spine MR imaging at baseline and repeat MR imaging scans at 1, 2, 6, and 12 weeks. The proportion of individuals who had MR imaging findings that changed during the 12-week period was compared with the same proportion in the controls. RESULTS:In 85\% of subjects, we identified a change in at least 1 MR imaging finding during the 12 weeks; however, the proportion was similar in the controls (80\%). A change in disc herniation, annular fissure, and nerve root compromise was reported more than twice as commonly in the subjects as in controls (65\% versus 30\%, 25\% versus 10\%, and 15\% versus 0\%, respectively). Caution is required in interpreting these findings due to wide confidence intervals, including no statistical difference. For all other MR imaging findings, the proportions of subjects and controls in whom MR imaging findings were reported to change during 12 weeks were similar. CONCLUSIONS:Changes in MR imaging findings were observed in a similar proportion of the low back pain and control groups, except for herniations, annular fissures, and nerve root compromise, which were twice as common in subjects with low back pain.},
  affiliation = {From the Faculty of Medicine and Health Sciences (J.P., M.J.H., J.S.M., J.H.).},
  date-added = {2017-09-05T03:43:31GMT},
  date-modified = {2022-04-30T18:16:20GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/A/2017/Panagopoulos/2017\%20Panagopoulos\%20Am\%20J\%20Neuroradiol-1.pdf},
  pmcid = {PMC7963711},
  pmid = {28775056},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.3174/ajnr.A5357},
  file = {/Users/nately/Zotero/storage/QJWJS4C9/2017 Panagopoulos Am J Neuroradiol-1.pdf}
}

@article{pandeySmartInterfaceTemplate2020,
  title = {Smart {{Interface Template}} and {{Conceptual Framework}} for {{Auto Interoperability}} in {{Healthcare Delivery System}}},
  author = {Pandey, Sanjib Raj and Kazi, Abdul and Mahul, Dahya and Babatunde, John},
  year = {2020},
  month = sep,
  journal = {Applied Medical Informatics},
  volume = {42},
  number = {3},
  pages = {142--156},
  issn = {2067-7855},
  urldate = {2023-10-01},
  abstract = {This paper describes two components of health care delivery system, the Smart Interface Template (SIT) and the Auto Data Mapping (interoperability) Process. The SIT, a reusable interface development method, has been designed and implemented successfully in the Chelsea and Westminster NHS Foundation Trust, London, UK.\&nbsp; It has been used to develop various new Health Level Seven (HL7) message interfaces such as Patient Admission, Discharge and Transfer Messages (ADT), Order Messages (ORM), Result Messages (ORU), and Patient Visit (PV1 \&amp; PV2) between the diverse health care delivery systems. The Auto Data Mapping (ADM) on the other hand is a conceptual framework for automating data mapping processes between the healthcare applications. This framework has the potential of increasing the efficiency of data by reducing human involvement in data mapping particularly in the heterogeneous healthcare delivery applications. The ADM framework is an evidence-based tool which employs computer-aided knowledge-based technique to generate HL7 message mapping rules.},
  copyright = {Copyright (c) 2020 Sanjib Raj PANDEY, Abdul KAZI, Dahya MAHUL, John BABATUNDE},
  langid = {english},
  keywords = {HL7,Integration Engine,Intelligent Agent,Knowledge-based,Machine Learning,Rule-based},
  file = {/Users/nately/Zotero/storage/CJ5L5UIW/Pandey et al. - 2020 - Smart Interface Template and Conceptual Framework for Auto Interoperability in Healthcare Delivery System.pdf}
}

