@article{gyerSpinalManipulationTherapy2019,
  title = {Spinal Manipulation Therapy: {{Is}} It All about the Brain? {{A}} Current Review of the Neurophysiological Effects of Manipulation.},
  author = {Gyer, Giles and Michael, Jimmy and Inklebarger, James and Tedla, Jaya Shanker},
  year = {2019},
  month = sep,
  journal = {Journal of Integrative Medicine},
  volume = {17},
  number = {5},
  pages = {328--337},
  doi = {10.1016/j.joim.2019.05.004},
  abstract = {Spinal manipulation has been an effective intervention for the management of various musculoskeletal disorders. However, the mechanisms underlying the pain modulatory effects of spinal manipulation remain elusive. Although both biomechanical and neurophysiological phenomena have been thought to play a role in the observed clinical effects of spinal manipulation, a growing number of recent studies have indicated peripheral, spinal and supraspinal mechanisms of manipulation and suggested that the improved clinical outcomes are largely of neurophysiological origin. In this article, we reviewed the relevance of various neurophysiological theories with respect to the findings of mechanistic studies that demonstrated neural responses following spinal manipulation. This article also discussed whether these neural responses are associated with the possible neurophysiological mechanisms of spinal manipulation. The body of literature reviewed herein suggested some clear neurophysiological changes following spinal manipulation, which include neural plastic changes, alteration in motor neuron excitability, increase in cortical drive and many more. However, the clinical relevance of these changes in relation to the mechanisms that underlie the effectiveness of spinal manipulation is still unclear. In addition, there were some major methodological flaws in many of the reviewed studies. Future mechanistic studies should have an appropriate study design and methodology and should plan for a long-term follow-up in order to determine the clinical significance of the neural responses evoked following spinal manipulation.},
  affiliation = {The London College of Osteopathic Medicine, London NW1 6QH, United Kingdom. Electronic address: info@osteon.co.uk.},
  date-added = {2021-06-23T22:05:46GMT},
  date-modified = {2022-03-21T19:10:16GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2019/Gyer/2019\%20Gyer\%20Journal\%20of\%20Integrative\%20Medicine.pdf},
  pmid = {31105036},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.joim.2019.05.004},
  keywords = {brain,Manipulation,Spinal Manipulation},
  file = {/Users/nately/Zotero/storage/7G3KRYWT/2019 Gyer Journal of Integrative Medicine.pdf}
}

@article{gyerYAXISMANIPULATIONCLINICAL2025,
  title = {{{THE Y-AXIS MANIPULATION}}---{{THE CLINICAL EFFICACY AND ASSOCIATED PATIENT SAFETY EXPLORED}}---{{A CLINICAL COMMENTARY}}},
  author = {Gyer, Giles and Williams, Brogan and Cox, Robert and Bowie, Jaimie and Michael, Jimmie},
  year = {2025},
  month = jan,
  journal = {Journal of Contemporary Chiropractic},
  volume = {8},
  number = {1},
  pages = {50--60},
  publisher = {Parker University},
  urldate = {2025-02-11},
  abstract = {Manual therapy is a broad term that includes various techniques, including soft tissue mobilization (STM), joint mobilization, and high-velocity, low-amplitude (HVLA) thrust manipulation. Recently, a new manual technique known as the Y-axis manipulation, or "Y-strap," has gained popularity on social media platforms. The term "Y-Strap" refers to the way this Y-shaped strap design extends the spine along the Y-axis of the body. This technique, which claims to reduce spinal stress, is based on manual traction techniques; however, some in the industry believe it is appropriate for use as an HVLA application. Osteopaths, chiropractors, and physiotherapists have taken significant liberties with this device, despite the fact that the Y-strap manufacturers state it is not suitable for HVLA manipulation. Questions have been raised within the chiropractic and osteopathic communities regarding the safety and efficacy of Y-strap manipulation. This article reviews and comments on the safety and efficacy claims while appraising whether the clinical benefits outweigh the risks.},
  langid = {english},
  file = {/Users/nately/Zotero/storage/SK66KWYR/Gyer et al. - 2025 - THE Y-AXIS MANIPULATION—THE CLINICAL EFFICACY AND ASSOCIATED PATIENT SAFETY EXPLORED—A CLINICAL COMM.pdf}
}

