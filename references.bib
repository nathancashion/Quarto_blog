@article{ProfessionalOutcomesSatisfaction,
  title = {Professional Outcomes and Satisfaction among Graduate Medical Education Wilderness Medicine Fellowship Alumni in the United States},
  journal = {Wilderness \& environmental medicine},
  volume = {0},
  number = {0},
  publisher = {Elsevier},
  doi = {10.1016/j.wem.2022.02.002},
  abstract = {{\textexclamdown}h3{\textquestiondown}Introduction{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Wilderness medicine (WM) graduate medical education (GME) fellowships were established in 2003. Outcomes and satisfaction of US WM GME fellowship alumni can inform prospective applicants and program directors of the strengths of fellowships and professional gaps in them.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Methods{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}A 34-question Qualtrics survey was emailed to 111 alumni from 17 institutions listed in the Wilderness Medical Society's GME database in May 2019. Professional service, scholarship, and satisfaction were queried. Results are represented as percent response (n=answered affirmative) based on the number of respondents per question.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}The survey response rate was 41\% (n=46); 67\% reported (n=31) Fellowship of the Academy of Wilderness Medicine recognition. Within the last 5 y, 71\% (n=32) reported publications in WM. Free text entry questions had 78\% (n=28) describe improved clinical skills, and 68\% (n=26) were exposed to new career choices in fellowship. Those who rated exposure to a variety of WM knowledge and skills highly rated the overall fellowship experience higher ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown}{\textexclamdown}0.001), as did those reporting a higher number of WM publications ({\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown}=0.023). Nearly half, 48\% (n=21), felt they could hold their current position without fellowship training. In hindsight, 76\% (n=34) would follow the same professional path.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}WM GME fellowship alumni reported high rates of professional engagement and scholarly productivity in the subspecialty. Responding alumni overwhelmingly rated the fellowship experience positively. Fellowships that ensure a wide exposure to experiences and foster scholarly productivity are more likely to yield professionally satisfied graduates.{\textexclamdown}/p{\textquestiondown}},
  date-added = {2022-03-20T02:39:19GMT},
  date-modified = {2022-03-21T19:11:08GMT},
  rating = {0},
  uri = {papers3://publication/doi/10.1016/j.wem.2022.02.002}
}

