  doi = {10.1016/j.jmpt.2006.03.001},
  abstract = {{\textexclamdown}h3{\textquestiondown}Objective{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}To discuss the case of a patient with chronic headache. Although not in severe pain at time of consultation, signs and symptoms raised concern. The patient later had a cerebrovascular accident.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Clinical Features{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}A 49-year-old man with non-traumatic chronic episodic head and neck pain presented for care. Examination and plain film radiographs were unremarkable, suggesting a mechanical origin for the symptoms; however, information in the case history raised concerns.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Intervention and Outcome{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}The patient was examined and not manipulated by the doctor of chiropractic but referred back to his general practitioner for a second opinion. The following week, the patient was admitted to hospital having had a cerebrovascular accident.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusion{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}The possible indication of the prodrome to a stroke may lie in the case history rather than the examination findings and provocative testing.{\textexclamdown}/p{\textquestiondown}},
  date-added = {2022-02-10T00:04:40GMT},
  date-modified = {2022-03-21T19:10:50GMT},
  rating = {0},
  uri = {papers3://publication/doi/10.1016/j.jmpt.2006.03.001}
}

