@article{futchVertebralArteryDissection2015,
  title = {Vertebral Artery Dissection in Evolution Found during Chiropractic Examination.},
  author = {Futch, Dan and Schneider, Michael J and Grayev, Allison and Jan Hartvigsen DC, PhD and Michael Schneider DC, PhD and Murphy, Donald R},
  year = {2015},
  journal = {BMJ case reports},
  volume = {2015},
  number = {nov12 1},
  pages = {bcr2015212568--bcr2015212568},
  doi = {10.1136/bcr-2015-212568},
  abstract = {A 30-year-old woman presented to an emergency department with sudden onset of transient loss of left peripheral vision. Owing to a history of migraine headaches, she was released with a diagnosis of ocular migraine. Two days later, she sought chiropractic care for the chief symptom of severe neck pain. The chiropractor suspected the possibility of vertebral artery dissection (VAD). No manipulation was performed; instead, MR angiography (MRA) of the neck was obtained, which revealed an acute left VAD with early thrombus formation. The patient was placed on aspirin therapy. Repeat MRA of the neck 3 months later revealed resolution of the thrombus, without progression to stroke. This case illustrates the importance for all healthcare providers who see patients with neck pain and headache to be attentive to the symptomatic presentation of possible VAD in progress.},
  affiliation = {Department of Chiropractic Medicine, Group Health Cooperative of South Central Wisconsin, Madison, Wisconsin, USA.},
