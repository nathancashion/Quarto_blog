  file = {/Users/nately/Zotero/storage/XITKI6JF/Boysen et al. - 2018 - Impacting public health by affecting individual he.pdf}
}

@article{bozerCaseCerebrospinalFluid2024,
  title = {A {{Case}} of a {{Cerebrospinal Fluid Leak Secondary}} to {{Chiropractic Manipulation}} of the {{Thoracic Spine}}},
  author = {Bozer, Jordan J. and Helfrich, Katelynn M. and Seidler, Gabriella R. and Garrett, Alexandrea L. and Hussain, Nasir},
  year = {2024},
  month = sep,
  journal = {A\&A Practice},
  volume = {18},
  number = {9},
  pages = {e01844},
  issn = {2575-3126},
  doi = {10.1213/XAA.0000000000001844},
  urldate = {2025-03-26},
  abstract = {Chiropractic spinal manipulation therapy (CSMT) of the cervical spine has been reported to cause mechanical dural injuries that result in cerebrospinal fluid (CSF) leaks. We present a case of symptomatic intracranial hypotension after isolated thoracic CSMT. Initial imaging was unable to definitively localize the CSF leak, but dynamic imaging was able to better identify the defect. Multiple epidural blood patches were attempted, including image-guided approaches and with fibrin sealant, but surgical repair was ultimately required. Our case illustrates the risk of dural tear in the setting of recent CSMT and the challenges of managing such an injury.}
}

