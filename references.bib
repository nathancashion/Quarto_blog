@article{adiaEHRDataInclusion2024,
  title = {{{EHR Data}} and {{Inclusion}} of {{Multiracial Asian American}}, {{Native Hawaiian}}, and {{Pacific Islander People}}---{{Opportunities}} for {{Advancing Data-Centered Equity}} in {{Health Research}}},
  author = {Adia, Alexander C. and Nguyen, Kevin H. and Ponce, Ninez A.},
  year = {2024},
  month = mar,
  journal = {JAMA Network Open},
  volume = {7},
  number = {3},
  pages = {e240719},
  issn = {2574-3805},
  doi = {10.1001/jamanetworkopen.2024.0719},
  urldate = {2024-03-23},
  abstract = {Appropriate health data collection and reporting are core elements of achieving health equity for minoritized racial and ethnic populations in the US. Without strong data practices, it is possible to underestimate the burden of disease for these groups, thereby reducing attention and resources committed to interventions aimed at reducing disparities. For years, community advocates and researchers have noted the importance of disaggregating data for Asian American, Native Hawaiian, and Pacific Islander (AANHPI) people, because grouping these diverse subgroups together can obscure individual subgroups' health needs. For example, people from different subgroups (eg, Filipino, Vietnamese, and Samoan) may have structural barriers or core differences in socioeconomic statuses, immigration histories, and health behaviors that impact their health outcomes. However, aggregation based on ethnic group, which is determined largely by country of origin or ancestral descent, may mask such heterogeneity. Many prior studies that have access to disaggregated data have shown that use of such data allows identification of health inequities that are hidden when using these aggregate data. Although progress has been made on this front, aggregation of AANHPI data remains the standard practice and, thus, a key obstacle to achieving health equity.},
  keywords = {data,EHR,equity,race},
  file = {/Users/nately/Zotero/storage/FMRMBLLP/Adia et al. - 2024 - EHR Data and Inclusion of Multiracial Asian American, Native Hawaiian, and Pacific Islander People—O.pdf;/Users/nately/Zotero/storage/6DAXFBTD/2816466.html}
}

