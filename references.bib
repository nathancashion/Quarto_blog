  publisher = {Institute of Medical Ethics},
  doi = {10.1136/medethics-2020-106253},
  abstract = {Beneficent clinical usage of placebos has been a problem for the application of Kant's deontology in medical ethics, which, in its strictest form, rejects deception universally. Some defenders of deontology have countered this by arguing placebos can be used by a physician without necessarily being deceptive. In this paper we argue that such a manipulation of Kant's absolutism is not credible, and therefore, that we should look beyond deontology in our consideration of placebo usage in clinical practice. We conclude that Kant's deontology cannot be made compatible with placebo use in clinical practice due to the primacy it affords to the principle of autonomy.},
  affiliation = {Medicine, University of London St George's, London, UK.},
  date-added = {2021-07-25T18:11:25GMT},
  date-modified = {2022-03-21T19:10:20GMT},
  langid = {english},
  pmid = {32913115},
  rating = {0},
  uri = {papers3://publication/doi/10.1136/medethics-2020-106253},
  keywords = {placebo}
}

