@article{vuApplicationsMachineLearning2023,
  title = {Applications of {{Machine Learning}} in {{Palliative Care}}: {{A Systematic Review}}},
  shorttitle = {Applications of {{Machine Learning}} in {{Palliative Care}}},
  author = {Vu, Erwin and Steinmann, Nina and Schr{\"o}der, Christina and F{\"o}rster, Robert and Aebersold, Daniel M. and Eychm{\"u}ller, Steffen and Cihoric, Nikola and Hertler, Caroline and Windisch, Paul and Zwahlen, Daniel R.},
  year = {2023},
  month = mar,
  journal = {Cancers},
  volume = {15},
  number = {5},
  pages = {1596},
  issn = {2072-6694},
  doi = {10.3390/cancers15051596},
  urldate = {2024-05-26},
  abstract = {Simple Summary To investigate the adoption of machine learning in palliative care research and clinical practice, we systematically searched for published research papers on the topic. We found several publications that used different kinds of machine learning in palliative care for different use cases. However, on average, there needs to be more rigorous testing of the models to ensure that they work well in different settings. Abstract Objective: To summarize the available literature on using machine learning (ML) for palliative care practice as well as research and to assess the adherence of the published studies to the most important ML best practices. Methods: The MEDLINE database was searched for the use of ML in palliative care practice or research, and the records were screened according to PRISMA guidelines. Results: In total, 22 publications using machine learning for mortality prediction (n = 15), data annotation (n = 5), predicting morbidity under palliative therapy (n = 1), and predicting response to palliative therapy (n = 1) were included. Publications used a variety of supervised or unsupervised models, but mostly tree-based classifiers and neural networks. Two publications had code uploaded to a public repository, and one publication uploaded the dataset. Conclusions: Machine learning in palliative care is mainly used to predict mortality. Similarly to other applications of ML, external test sets and prospective validations are the exception.},
  pmcid = {PMC10001037},
  pmid = {36900387},
  file = {/Users/nately/Zotero/storage/T5BD5KI9/Vu et al. - 2023 - Applications of Machine Learning in Palliative Care A Systematic Review.pdf}
}

