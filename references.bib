  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/C/2016/Paulus/2016\%20Paulus\%20Chiropr\%20Man\%20Therap-1.pdf},
  pmcid = {PMC5097396},
