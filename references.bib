@article{maileyReducingOccupationalSitting2022,
  title = {Reducing {{Occupational Sitting While Working From Home}}: {{Individual}} and {{Combined Effects}} of a {{Height-Adjustable Desk}} and an {{Online Behavioral Intervention}}},
  shorttitle = {Reducing {{Occupational Sitting While Working From Home}}},
  author = {Mailey, Emily L. and Rosenkranz, Richard and Rosenkranz, Sara K. and Ablah, Elizabeth and Talley, Mia and Biggins, Anna and Towsley, Alissa and Honn, Allison},
  year = {2022},
  month = feb,
  journal = {Journal of Occupational and Environmental Medicine},
  volume = {64},
  number = {2},
  pages = {91--98},
  issn = {1076-2752},
  doi = {10.1097/JOM.0000000000002410},
  urldate = {2022-05-09},
  abstract = {Objective:~         This study examined the individual and combined effects of a height-adjustable desk and an online behavioral intervention on sedentary behavior and health among university employees working from home.         Methods:~         Participants (N = 95) were randomly assigned to one of four conditions: Desk Only, Program Only, Desk + Program, or Control. Desk participants received a height-adjustable desk; program participants received a 12-week web-based intervention. Outcomes measured at baseline and post-intervention included workday sitting and cardiometabolic health outcomes.         Results:~         Reductions in sitting were largest in the Desk + Program condition (-206 min/workday; d = 1.84), followed by the Desk Only condition (-122 min/workday; d = 0.98), and the Program Only condition (-96 min/workday; d = 1.13). There were no significant changes in the health outcomes assessed.         Conclusions:~         Both a height-adjustable desk and an online behavioral intervention effectively reduced occupational sitting, and a combined approach was most effective.},
  langid = {american},
  keywords = {desk,sit to stand,sitting,standing desk},
  file = {/Users/nately/Zotero/storage/JSDEDI3R/Reducing_Occupational_Sitting_While_Working_From.1.html}
}

