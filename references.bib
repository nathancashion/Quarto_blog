@article{winnickaPiracetamOldDrug2005,
  title = {Piracetam--an Old Drug with Novel Properties?},
  author = {Winnicka, Katarzyna and Tomasiak, Marian and Bielawska, Anna},
  year = {2005},
  month = sep,
  journal = {Acta poloniae pharmaceutica},
  volume = {62},
  number = {5},
  pages = {405--409},
  abstract = {Piracetam (2-oxo-1-pyrrolidine-acetamide), the most common of the nootropic drugs, is a cyclic derivative of gamma-aminobutyric acid. The treatment with piracetam improves learning, memory, brain metabolism, and capacity. Piracetam has been shown to alter the physical properties of the plasma membrane by increasing its fluidity and by protecting the cell against hypoxia. It increases red cell deformability and normalizes aggregation of hyperactive platelets. Piracetam is an agent with antithrombotic, neuroprotective and rheological properties. The interaction of this molecule with the membrane phospholipids restores membrane fluidity and could explain the efficacy of piracetam in various disorders ranging from dementia and vertigo to myoclonus and stroke.},
  affiliation = {Department of Drug Technology, Medical University of Bia{\l}ystok, 1 Kili{\'n}skiego Str., 15-089 Bia{\l}ystok, Poland.},
