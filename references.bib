@article{kawchukTwoyearFollowupTwitter2023,
  title = {A Two-Year Follow-up: {{Twitter}} Activity Regarding Misinformation about Spinal Manipulation, Chiropractic Care and Boosting Immunity during the {{COVID-19}} Pandemic},
