}

@incollection{haddadBusinessValueIT2014,
  title = {Business {{Value}} of {{IT}} in {{Healthcare}}},
  booktitle = {Lean {{Thinking}} for {{Healthcare}}},
  author = {Haddad, Peter and Gregory, Mark and Wickramasinghe, Nilmini},
  editor = {Wickramasinghe, Nilmini and {Al-Hakim}, Latif and Gonzalez, Chris and Tan, Joseph},
  year = {2014},
  series = {Healthcare {{Delivery}} in the {{Information Age}}},
  pages = {55--81},
  publisher = {Springer},
