@article{coulterComparativeStudyChiropractic1998,
  title = {A Comparative Study of Chiropractic and Medical Education.},
  author = {Coulter, I and Adams, A and Coggan, P and Wilkes, M and Gonyea, M},
  year = {1998},
  month = sep,
  journal = {Alternative therapies in health and medicine},
  volume = {4},
  number = {5},
  pages = {64--75},
  publisher = {Altern Ther Health Med},
  abstract = {BACKGROUND:Chiropractic is the largest of the alternative/complementary health professions in North America. However, little attention has been given in the health sciences literature to the formal curriculum of chiropractic education or to its similarities to and differences from the curriculum of allopathic medical education. This lack of information precludes extensive referrals and interaction between the 2 professions, even when historical and political barriers can be overcome. METHOD:This is a descriptive, comparative study of the curriculum content of North American chiropractic and medical colleges, supplemented by in-depth data obtained through site visits with 6 institutions (3 chiropractic and 3 medical). DISCUSSION:Considerable commonality exists between chiropractic and medical programs. Regarding the basic sciences, these programs are more similar than dissimilar, both in the types of subjects offered and in the time allotted to each subject. The programs also share some common areas in the clinical sciences. Chiropractic and allopathic medicine differ the greatest in clinical practice, which in medical school far exceeds that in chiropractic school. The therapies that chiropractic and medical students learn are distinct from one another, and the settings in which students receive clinical training are different and isolated from one another. With these similarities and differences established, future studies should examine the quality of the 2 educational programs in detail.},
  affiliation = {School of Dentistry, University of California, Los Angeles (UCLA), USA.},
  date-added = {2020-12-09T23:50:51GMT},
  date-modified = {2022-03-21T19:09:50GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/3F/3FFCFD4E-35A3-4448-B7FA-01419EC73F49.pdf},
  pmid = {9737032},
  rating = {0},
  uri = {papers3://publication/uuid/04E630FA-3754-4F8B-B4C3-4AE4FCFC0400}
}

