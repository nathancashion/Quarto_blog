  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/DF/DFB556B7-976E-44FF-A712-5427A86BBFA0.pdf},
  pmcid = {PMC6911905},
  pmid = {31871436},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.echu.2019.09.002},
