@article{kuehlEfficacyTartCherry2010,
  title = {Efficacy of Tart Cherry Juice in Reducing Muscle Pain during Running: A Randomized Controlled Trial.},
  author = {Kuehl, Kerry S and Perrier, Erica T and Elliot, Diane L and Chesnutt, James C},
  year = {2010},
  journal = {Journal of the International Society of Sports Nutrition},
  volume = {7},
  number = {1},
  pages = {17},
  publisher = {BioMed Central Ltd},
  doi = {10.1186/1550-2783-7-17},
  abstract = {BACKGROUND:Long distance running causes acute muscle damage resulting in inflammation and decreased force production. Endurance athletes use NSAIDs during competition to prevent or reduce pain, which carries the risk of adverse effects. Tart cherries, rich in antioxidant and anti-inflammatory properties, may have a protective effect to reduce muscle damage and pain during strenuous exercise. This study aimed to assess the effects of tart cherry juice as compared to a placebo cherry drink on pain among runners in a long distance relay race. METHODS:The design was a randomized, double blind, placebo controlled trial. Fifty-four healthy runners (36 male, 18 female; 35.8 +/- 9.6 yrs) ran an average of 26.3 +/- 2.5 km over a 24 hour period. Participants ingested 355 mL bottles of tart cherry juice or placebo cherry drink twice daily for 7 days prior to the event and on the day of the race. Participants assessed level of pain on a standard 100 mm Visual Analog Scale (VAS) at baseline, before the race, and after the race. RESULTS:While both groups reported increased pain after the race, the cherry juice group reported a significantly smaller increase in pain (12 +/- 18 mm) compared to the placebo group (37 +/- 20 mm) (p {\textexclamdown} .001). Participants in the cherry juice group were more willing to use the drink in the future (p {\textexclamdown} 0.001) and reported higher satisfaction with the pain reduction they attributed to the drink (p {\textexclamdown} 0.001). CONCLUSIONS:Ingesting tart cherry juice for 7 days prior to and during a strenuous running event can minimize post-run muscle pain.},
  affiliation = {Department of Medicine, Oregon Health \& Science University, Portland, OR, USA, 97239. kuehlk@ohsu.edu.},
  date-added = {2014-10-22T03:06:28GMT},
  date-modified = {2022-04-30T18:16:29GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2010/Kuehl/2010\%20Kuehl\%20J\%20Int\%20Soc\%20Sports\%20Nutr-1.pdf},
  pmcid = {PMC2874510},
