@incollection{krishnamurthyComparativeAnalysisEBay2004,
  title = {A {{Comparative Analysis}} of {{eBay}} and {{Amazon}}},
  author = {Krishnamurthy, Sandeep},
  year = {2004},
  month = jan,
  doi = {10.4018/9781591401605.ch003},
  abstract = {Even though Amazon.com has received most of the initial hype and publicity surrounding e-commerce, eBay has quietly built an innovative business truly suited to the Internet. Initially, Amazon sought to merely replicate a catalog business model online. Its technology may have been innovative- but its business model was not. On the other hand, eBay recognized the unique nature of the Internet and enabled both buying and selling online with spectacular results. Its auction format was a winner. eBay also clearly demonstrated that profits do not have to come in the way of growth---an argument that Bezos never tired of making. Amazon was initially focused on BN.com as a competitor. Over time, Amazon came to recognize eBay as the competitor. Its initial foray into auctions was a spectacular failure. Now, Amazon is trying to compete with eBay by facilitating selling and strengthening its affiliates program.},
  file = {/Users/nately/Zotero/storage/2CKCS3QX/Krishnamurthy - 2004 - A Comparative Analysis of eBay and Amazon.pdf}
}

@article{kristensenIbuprofenAltersHuman2018,
  title = {Ibuprofen Alters Human Testicular Physiology to Produce a State of Compensated Hypogonadism.},
  author = {Kristensen, David M{\o}bjerg and {Desdoits-Lethimonier}, Christ{\`e}le and Mackey, Abigail L and Dalgaard, Marlene Danner and De Masi, Federico and Munkb{\o}l, Cecilie Hurup and Styrishave, Bjarne and Antignac, Jean-Philippe and Le Bizec, Bruno and Platel, Christian and {Hay-Schmidt}, Anders and Jensen, Tina Kold and Lesn{\'e}, Laurianne and {Mazaud-Guittot}, S{\'e}verine and Kristiansen, Karsten and Brunak, S{\o}ren and Kjaer, Michael and Juul, Anders and J{\'e}gou, Bernard},
  year = {2018},
  month = jan,
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {96},
  number = {4},
  pages = {201715035--E724},
  doi = {10.1073/pnas.1715035115},
  abstract = {Concern has been raised over increased male reproductive disorders in the Western world, and the disruption of male endocrinology has been suggested to play a central role. Several studies have shown that mild analgesics exposure during fetal life is associated with antiandrogenic effects and congenital malformations, but the effects on the adult man remain largely unknown. Through a clinical trial with young men exposed to ibuprofen, we show that the analgesic resulted in the clinical condition named "compensated hypogonadism," a condition prevalent among elderly men and associated with reproductive and physical disorders. In the men, luteinizing hormone (LH) and ibuprofen plasma levels were positively correlated, and the testosterone/LH ratio decreased. Using adult testis explants exposed or not exposed to ibuprofen, we demonstrate that the endocrine capabilities from testicular Leydig and Sertoli cells, including testosterone production, were suppressed through transcriptional repression. This effect was also observed in a human steroidogenic cell line. Our data demonstrate that ibuprofen alters the endocrine system via selective transcriptional repression in the human testes, thereby inducing compensated hypogonadism.},
  affiliation = {Danish Headache Center, Department of Neurology, Rigshospitalet, University of Copenhagen, 1165 Copenhagen, Denmark; david.moebjerg.boslev.kristensen@regionh.dk bernard.jegou@inserm.fr.},
  date-added = {2018-01-14T04:30:06GMT},
  date-modified = {2022-04-30T18:15:50GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/P/2018/Kristensen/2018\%20Kristensen\%20PNAS-1.pdf},
  pmcid = {PMC5789927},
  pmid = {29311296},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1073/pnas.1715035115},
  file = {/Users/nately/Zotero/storage/DQJWSRGD/2018 Kristensen PNAS-1.pdf}
}

@article{kroemerRoleInterleukin21989,
