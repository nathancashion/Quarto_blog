  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2017/Schreck\%20Bird/2017\%20Schreck\%20Bird\%20J\%20Pharm\%20Pract-1.pdf},
  pmid = {26940647},
