@article{srbelyImmediateEffectsSpinal2013,
  title = {Immediate Effects of Spinal Manipulative Therapy on Regional Antinociceptive Effects in Myofascial Tissues in Healthy Young Adults.},
  author = {Srbely, John Z and Vernon, Howard and Lee, David and Polgar, Miranda},
  year = {2013},
  month = jul,
  journal = {Journal of manipulative and physiological therapeutics},
  volume = {36},
  number = {6},
  pages = {333--341},
  doi = {10.1016/j.jmpt.2013.01.005},
  abstract = {OBJECTIVE:The purpose of this study was to investigate if spinal manipulative therapy (SMT) can evoke immediate regional antinociceptive effects in myofascial tissues by increasing pressure pain thresholds (PPTs) over myofascial trigger points in healthy young adults. METHODS:A total of 36 participants (19 men, 17 women; age, 28.0 [5.3] years; body mass index, 26.5 [5.7] kg/m(2)) with clinically identifiable myofascial trigger points in the infraspinatus and gluteus medius muscles were recruited from the University of Guelph, Ontario, Canada. Participants were randomly allocated to 2 groups. Participants in the test group received chiropractic SMT targeted to the C5-C6 spinal segment. Participants in the control group received sham SMT. The PPT was recorded from the right infraspinatus and gluteus medius muscles at baseline (preintervention) and 1, 5, 10, and 15 minutes postintervention. RESULTS:Three participants were disqualified, resulting in a total of 33 participants analyzed. Significant increases in the PPT (decreased pain sensitivity) were observed in the test infraspinatus group when compared with test gluteus medius, control infraspinatus, and control gluteus medius groups (P {\textexclamdown} .05). No significant differences in PPT were observed at any time point when comparing test gluteus medius, control infraspinatus, and control gluteus medius groups (P {\textquestiondown} .05). CONCLUSIONS:This study showed that SMT evokes short-term regional increases in PPT within myofascial tissues in healthy young adults.},
  affiliation = {Department of Human Health and Nutritional Science, University of Guelph, Guelph, Ontario, Canada. jsrbely@uoguelph.ca},
  date-added = {2015-09-09T00:45:00GMT},
  date-modified = {2022-04-30T18:16:47GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2013/Srbely/2013\%20Srbely\%20J\%20Manipulative\%20Physiol\%20Ther-1.pdf},
  pmid = {23830709},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.jmpt.2013.01.005},
  file = {/Users/nately/Zotero/storage/KDZ6QTLZ/2013 Srbely J Manipulative Physiol Ther-1.pdf}
}

@article{srbelyNewTrendsTreatment2010,
