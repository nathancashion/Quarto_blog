  author = {Guzman, Jaime and Haldeman, Scott and Carroll, Linda J and Carragee, Eugene J and Hurwitz, Eric L and Peloso, Paul and Nordin, Margareta and Cassidy, J David and Holm, Lena W and C{\^o}t{\'e}, Pierre and {van der Velde}, Gabrielle and {Hogg-Johnson}, Sheilah and {Bone and Joint Decade 2000-2010 Task Force on Neck Pain and Its Associated Disorders}},
