@misc{GlobalAgesexspecificMortality,
  title = {Global Age-Sex-Specific Mortality, Life Expectancy, and Population Estimates in 204 Countries and Territories and 811 Subnational Locations, 1950--2021: A Comprehensive Demographic Analysis for the {{Global Burden}} of {{Disease Study}} 2021},
  series = {Global {{Burden}} of {{Disease}}},
  abstract = {Our paper presents a comprehensive assessment of mortality, life expectancy, and population between 1950 and 2021, with a particular emphasis on the 2020--2021 years of the COVID-19 pandemic. The GBD 2021 demographic analysis improved upon past iterations of GBD by using additional data sources and refined methods to generate updated estimates and also incorporated the COVID-19 pandemic into the modelling process for the first time. We integrated excess mortality modelling into our demographic analysis to produce a unified estimation of excess mortality and all-cause mortality, representing an innovation in current demographic research methods unique to GBD 2021. Our research reveals the impact of the first two years of the COVID-19 pandemic at a novel level of granularity, demonstrating unprecedented reversals in mortality and life expectancy trends at the global, regional, and national levels---though not among children under 5 years. Beyond the pandemic, our paper delves into slowing global population growth and a shifting age distribution away from younger ages and towards older ages. The findings from this research may inform policies and practices surrounding health-care, economic, and social challenges that emerge from important shifts in population age structures.},
  file = {/Users/nately/Zotero/storage/47PWWFDJ/Global age-sex-specific mortality, life expectancy.pdf;/Users/nately/Zotero/storage/6G3CYPCX/Methods_Appendix.pdf;/Users/nately/Zotero/storage/6VPIZIRR/Figures.pdf;/Users/nately/Zotero/storage/EEKGH73I/Supplementary_Results_Appendix.pdf;/Users/nately/Zotero/storage/YH93AC29/Tables.pdf}
}

