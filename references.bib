@article{resendeNeckPainText2025,
  title = {Neck Pain and Text Neck Using {{Hill}}'s Criteria of Causation: {{A}} Scoping Review},
  shorttitle = {Neck Pain and Text Neck Using {{Hill}}'s Criteria of Causation},
  author = {Resende, Paula Auxiliadora and Tavares Correia, Igor Macedo and {de S{\'a} Ferreira}, Arthur and {Meziat-Filho}, Ney and Lunkes, Luciana Crepaldi},
  year = {2025},
  month = jun,
  journal = {Journal of Bodywork and Movement Therapies},
  volume = {42},
  pages = {132--138},
  issn = {1360-8592},
  doi = {10.1016/j.jbmt.2024.12.016},
  urldate = {2025-04-19},
  abstract = {Background Technological advances make mobile devices (smartphones, tablets) increasingly part of individuals' routines. The most diverse functionalities can prolong the use of these devices for hours, which instigates discussions about possible musculoskeletal consequences and their association with neck pain. Aim To describe the current state of concepts involving text neck and neck pain using Hill's criteria of causation. Methods Scoping review of the literature conducted in the EMBASE, MEDLINE/PubMed, The Cochrane Library, and CINAHL databases. Articles published until August/2023 were analyzed based on the title and abstract and subsequently by general content. Then, causality verification applying Hill's criteria was carried out by two independent reviewers. Results 21 articles were included. The majority of studies (90\%) had an observational design, with the total sample having a mean age of 24~{\textpm}~6,32 years. None of Hill's criteria of causation were met by any of the selected articles, with no causal association being evident. Conclusion The causal association between text neck and neck pain is not supported by current literature based on the evaluation of Hill's criteria, widely used in epidemiology to establish causal links.},
  keywords = {Neck pain,Posture,Scope review,Smartphone,Text neck}
}

