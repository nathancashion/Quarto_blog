  doi = {10.1037/rep0000035},
  abstract = {1. Purpose/Objective: Chronic pain has a significant negative impact on the quality of life, including sleep disruption. There is compelling evidence that cognitive--behavioral therapy can be effective in treating sleep disorders. To our knowledge, no research has been ...},
