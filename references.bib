@article{vieiraEffectWaterTemperature2016,
  title = {The Effect of Water Temperature during Cold-Water Immersion on Recovery from Exercise-Induced Muscle Damage},
  author = {Vieira, A and Siqueira, A and {Ferreira-Junior}, J and {do Carmo}, J and Durigan, J and Blazevich, A and Bottaro, M},
  year = {2016},
  month = nov,
  journal = {International Journal of Sports Medicine},
  volume = {37},
  number = {12},
  pages = {937--943},
  publisher = {{\copyright} Georg Thieme Verlag KG},
  doi = {10.1055/s-0042-111438},
  abstract = {This study investigated the effects of 5 and 15{$^\circ$}C cold-water immersion on recovery from exercise resulting in exercise-induced muscle damage. 42 college-aged men performed 5{\texttimes}20 drop-jumps and were randomly allocated into one of 3 groups: (1) 5{$^\circ$}C; (2) 15{$^\circ$}C; or (3) control. After exercise, individuals from the cold-water immersion groups had their lower limbs immerged in iced water for 20 min. Isometric knee extensor torque, countermovement jump, muscle soreness, and creatine kinase were measured before, immediately after, 24, 48, 72, 96 and 168 h post-exercise. There was no between-group difference in isometric strength recovery (p=0.73). However, countermovement jump recovered quicker in cold-water immersion groups compared to control group (p{\textexclamdown}0.05). Countermovement jump returned to baseline after 72 h in 15{$^\circ$}C, 5{$^\circ$}C group recovered after 96 h and control did not recovered at any time point measured. Also, creatine kinase returned to baseline at 72 h and remained stable for all remaining measurements for 15{$^\circ$}C group, whereas remained elevated past 168 h in both 5{$^\circ$}C and control groups. There was a trend toward lower muscle soreness (p=0.06) in 15{$^\circ$}C group compared to control at 24 h post-exercise. The result suggests that cold-water immersion promote recovery of stretch-shortening cycle performance, but not influence the recovery of maximal contractile force. Immersion at warmer temperature may be more effective than colder temperatures promoting recovery from strenuous exercise.},
  date-added = {2016-12-27T23:50:25GMT},
  date-modified = {2022-04-30T18:16:49GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/I/2016/Vieira/2016\%20Vieira\%20Int\%20J\%20Sports\%20Med-1.pdf},
  rating = {0},
  uri = {papers3://publication/doi/10.1055/s-0042-111438},
  file = {/Users/nately/Zotero/storage/M85QQ7EG/2016 Vieira Int J Sports Med-1.pdf}
}

@article{vieiraTelerehabilitationMusculoskeletalPain2023,
  title = {Telerehabilitation for Musculoskeletal Pain -- {{An}} Overview of Systematic Reviews},
  author = {Vieira, Ludmilla Maria Souza Mattos de Ara{\'u}jo and {de Andrade}, Marcela Alves and Sato, Tatiana de Oliveira},
  year = {2023},
