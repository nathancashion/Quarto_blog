  number = {2},
  pages = {e70013},
  issn = {2832-9023},
  doi = {10.1002/cesm.70013},
  urldate = {2025-03-06},
  abstract = {The aim of this article is to present the most common statistical errors in meta-analyses included in systematic reviews; these are confusing standard deviation and standard error, using heterogeneity estimators for choosing between a common-effect and random-effects model, improper handling of multiarm trials, and unnecessary and misinterpreted subgroup analyses. We introduce some useful terminology and explain what authors can do to avoid these errors and how peer reviewers can spot them. We have also developed a micro-learning module to provide practical hands-on tutorial.},
