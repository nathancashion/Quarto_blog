  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/N/2018/Stokes/2018\%20Stokes\%20Nutrients\%202015\%20Vol.\%207\%20Pages\%205628-5645-1.pdf},
  pmcid = {PMC5852756},
  pmid = {29414855},
