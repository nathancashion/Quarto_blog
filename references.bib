  author = {Colberg, Sheri R and Albright, Ann L and Blissmer, Bryan J and Braun, Barry and {Chasan-Taber}, Lisa and Fernhall, Bo and Regensteiner, Judith G and Rubin, Richard R and Sigal, Ronald J and {American College of Sports Medicine} and {American Diabetes Association}},
  year = {2010},
