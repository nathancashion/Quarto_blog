  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/I/2014/Bradley/2014\%20Bradley\%20Int\%20J\%20Sports\%20Phys\%20Ther-1.pdf},
  pmcid = {PMC3924606},
  pmid = {24567853},
