  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2017/Pollard-Smith/2017\%20Pollard-Smith\%20Journal\%20of\%20Bodywork\%20and\%20Movement\%20Therapies-1.pdf},
  pmid = {28167171},
