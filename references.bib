@article{belavyRunningExerciseStrengthens2017,
  title = {Running Exercise Strengthens the Intervertebral Disc.},
  author = {Belav{\'y}, Daniel L and Quittner, Matthew J and Ridgers, Nicola and Ling, Yuan and Connell, David and Rantalainen, Timo},
  year = {2017},
  month = apr,
  journal = {Scientific reports},
  volume = {7},
  number = {1},
  pages = {45975},
  doi = {10.1038/srep45975},
  abstract = {There is currently no evidence that the intervertebral discs (IVDs) can respond positively to exercise in humans. Some authors have argued that IVD metabolism in humans is too slow to respond anabolically to exercise within the human lifespan. Here we show that chronic running exercise in men and women is associated with better IVD composition (hydration and proteoglycan content) and with IVD hypertrophy. Via quantitative assessment of physical activity we further find that accelerations at fast walking and slow running (2 m/s), but not high-impact tasks, lower intensity walking or static positions, correlated to positive IVD characteristics. These findings represent the first evidence in humans that exercise can be beneficial for the IVD and provide support for the notion that specific exercise protocols may improve IVD material properties in the spine. We anticipate that our findings will be a starting point to better define exercise protocols and physical activity profiles for IVD anabolism in humans.},
  affiliation = {Deakin University, School of Exercise and Nutrition Sciences, Institute for Physical Activity and Nutrition, 221 Burwood Highway, Burwood, Victoria, 3125, Australia.},
  date-added = {2017-06-06T00:00:22GMT},
  date-modified = {2022-04-30T18:16:24GMT},
