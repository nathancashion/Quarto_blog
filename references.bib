@article{goodingHardLessonsSchoolBased2023,
  title = {Hard {{Lessons From}} a {{School-Based Intervention}} to {{Improve Cardiovascular Health}} in {{Adolescence}}},
  author = {Gooding, Holly C. and Aguayo, Liliana},
  year = {2023},
  month = aug,
  journal = {JAMA Cardiology},
  issn = {2380-6583},
  doi = {10.1001/jamacardio.2023.2244},
  urldate = {2023-08-12},
  abstract = {Adolescence is a critical period for the prevention of cardiovascular diseases (CVDs). Cardiovascular health (CVH) is a concept introduced in 2010 by the American Heart Association that uses a positive paradigm to measure, monitor, and modify CVD risk. This measurement combines 4 health risk factors (body mass index, blood pressure, total cholesterol level, and fasting blood glucose level) and 3 health behaviors (smoking, physical activity, and diet) into 1 score, ranging from 0 to 14. Research has shown that people who maintain high CVH levels from adolescence onward live longer, healthier lives free of major CVD risk factors and multiple chronic comorbidities. Youth who maintain higher CVH levels have a lower risk of developing premature CVD in adulthood and very low mortality rates over 32 years. In fact, it is estimated that if everyone had high CVH levels in late adolescence or young adulthood, the vast majority of cardiovascular events would be avoided. Unfortunately, very few people have high levels of CVH. Longitudinal analyses have shown that CVH is highest in people of younger ages and decreases gradually throughout the life course. Given that prospective cohort studies have found the greatest CVH decrease occurs around age 17 years, interventions that slow or reverse this loss in adolescence are especially needed.},
  file = {/Users/nately/Zotero/storage/HWS6CQ3D/2807850.html}
}

