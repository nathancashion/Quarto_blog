@book{StratifiedCarePrevent,
  title = {Stratified Care to Prevent Chronic Low Back Pain in High-Risk Patients: {{The TARGET}} Trial. {{A}} Multi-Site Pragmatic Cluster Randomized Trial},
  volume = {34},
  publisher = {Elsevier},
  doi = {10.1016/j.eclinm.2021.100795},
  abstract = {{\textexclamdown}h2{\textquestiondown}Abstract{\textexclamdown}/h2{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Background{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Many patients with acute low back pain (LBP) first seek care from primary care physicians. Evidence is lacking for interventions to prevent transition to chronic LBP in this setting. We aimed to test if implementation of a risk-stratified approach to care would result in lower rates of chronic LBP and improved self-reported disability.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Methods{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}We conducted a pragmatic, cluster randomized trial using 77 primary care clinics in four health care systems across the United States. Practices were randomly assigned to a stratified approach to care (intervention) or usual care (control). Using the STarTBack screening tool, adults with acute LBP were screened low, medium, and high-risk. Patients screened as high-risk were eligible. The intervention included electronic best practice alerts triggering referrals for psychologically informed physical therapy (PIPT). PIPT education was targeted to community clinics geographically close to intervention primary care clinics. Primary outcomes were transition to chronic LBP and self-reported disability at six months. Trial Registry: ClinicalTrials.gov NCT02647658{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Findings{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Between May 2016 and June 2018, 1207 patients from 38 intervention and 1093 from 37 control practices were followed. In the intervention arm, around 50\% of patients were referred for physical therapy (36\% for PIPT) compared to 30\% in the control. At 6 months, 47\% of patients reported transition to chronic LBP in the intervention arm (38 practices, {\textexclamdown}i{\textquestiondown}n{\textexclamdown}/i{\textquestiondown} = 658) versus 51\% of patients in the control arm (35 practices, {\textexclamdown}i{\textquestiondown}n{\textexclamdown}/i{\textquestiondown} = 635; OR=0.83 95\% CI 0.64, 1.09; {\textexclamdown}i{\textquestiondown}p{\textexclamdown}/i{\textquestiondown} = 0.18). No differences in disability were detected (difference -2˙1, 95\% CI -4.9--0.6; {\textexclamdown}i{\textquestiondown}p{\textexclamdown}/i{\textquestiondown} = 0.12). Opioids and imaging were prescribed in 22\%--25\% and 23\%--26\% of initial visits, for intervention and control, respectively. Twelve-month LBP utilization was similar in the two groups.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Interpretation{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}There were no differences detected in transition to chronic LBP among patients presenting with acute LBP using a stratified approach to care. Opioid and imaging prescribing rates were non-concordant with clinical guidelines.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Funding{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Patient-Centered Outcomes Research Institute (PCORI) contract \# PCS-1402--10867{\textexclamdown}/p{\textquestiondown}},
  date-added = {2021-04-10T00:55:52GMT},
  date-modified = {2022-03-21T19:10:05GMT},
  rating = {0},
  uri = {papers3://publication/doi/10.1016/j.eclinm.2021.100795}
}

