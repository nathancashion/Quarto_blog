@article{abdollahMRIEvaluationEffects2017,
  title = {{{MRI}} Evaluation of the Effects of Extension Exercises on the Disc Fluid Content and Location of the Centroid of the Fluid Distribution.},
  author = {Abdollah, Vahid and Parent, Eric C and Batti{\'e}, Michele C},
  year = {2017},
  month = nov,
  journal = {Musculoskeletal Science and Practice},
  volume = {33},
  pages = {67--70},
  doi = {10.1016/j.msksp.2017.11.008},
  abstract = {BACKGROUND:McKenzie prone press-up exercises have been hypothesised to reduce intradiscal pressure, allowing fluid to be reabsorbed into the disc, which could improve the internal stability and local chemical milieu of the disc, potentially reducing symptoms. OBJECTIVE:To investigate the immediate effects of prone press-up exercises on lumbar disc fluid content and movement. DESIGN:Quantification of MRI changes before and after a single exercise session. METHODS:The mid-sagittal T2-weighted MR images of 22 volunteers with low back pain were obtained before and immediately after performing press-up exercises. The whole disc and nucleus regions of the L4-5 and L5-S1 discs were then segmented, and their mean signal intensity (MSI) and signal intensity weighted centroid (SIWC) were computed to estimate disc fluid content and displacement. RESULTS:There were no significant differences between the MSI and the vertical position of the SIWC of the whole disc before and after extension at either disc level (effect size [ES]: -0.23 to 0.09). There was a significant anterior displacement (0.1  5.4 mm) of the location of the SIWC of the disc after extension exercise at L4-5 (ES: 0.22), but not at L5-S1 (ES: 0.00) or at either level for the nucleus region (ES: -0.06; 0.16). CONCLUSION:Little evidence was found supporting the hypothesis that press-up exercises affect disc fluid content and distribution. Novel parameters reflecting fluid distribution detected similar or larger effects of the extension than MSI. If such exercises are effective in reducing symptoms, it is likely through other mechanisms than by changing fluid content or distribution.},
  affiliation = {Department of Physical Therapy, Faculty of Rehabilitation Medicine, 3-48 Corbett Hall, University of Alberta, Edmonton, AB T6G 2G4, Canada.},
  date-added = {2017-12-04T04:34:42GMT},
  date-modified = {2022-04-30T18:16:48GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/M/2017/Abdollah/2017\%20Abdollah\%20Musculoskeletal\%20Science\%20and\%20Practice-1.pdf},
  pmid = {29180112},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.msksp.2017.11.008},
  file = {/Users/nately/Zotero/storage/QXDLRHDX/2017 Abdollah Musculoskeletal Science and Practice-1.pdf}
}

@article{abdollahMRIEvaluationEffects2018,
  title = {{{MRI}} Evaluation of the Effects of Extension Exercises on the Disc Fluid Content and Location of the Centroid of the Fluid Distribution},
  author = {Abdollah, Vahid and Parent, Eric C. and Batti{\'e}, Michele C.},
  year = {2018},
  month = feb,
  journal = {Musculoskeletal Science and Practice},
  volume = {33},
  pages = {67--70},
  issn = {2468-7812},
  doi = {10.1016/j.msksp.2017.11.008},
  urldate = {2023-01-14},
  abstract = {Background McKenzie prone press-up exercises have been hypothesised to reduce intradiscal pressure, allowing fluid to be reabsorbed into the disc, which could improve the internal stability and local chemical milieu of the disc, potentially reducing symptoms. Objective To investigate the immediate effects of prone press-up exercises on lumbar disc fluid content and movement. Design Quantification of MRI changes before and after a single exercise session. Methods The mid-sagittal T2-weighted MR images of 22 volunteers with low back pain were obtained before and immediately after performing press-up exercises. The whole disc and nucleus regions of the L4-5 and L5-S1 discs were then segmented, and their mean signal intensity (MSI) and signal intensity weighted centroid (SIWC) were computed to estimate disc fluid content and displacement. Results There were no significant differences between the MSI and the vertical position of the SIWC of the whole disc before and after extension at either disc level (effect size [ES]: -0.23 to 0.09). There was a significant anterior displacement (0.1~{\textpm}~5.4~mm) of the location of the SIWC of the disc after extension exercise at L4-5 (ES: 0.22), but not at L5-S1 (ES: 0.00) or at either level for the nucleus region (ES: -0.06; 0.16). Conclusion Little evidence was found supporting the hypothesis that press-up exercises affect disc fluid content and distribution. Novel parameters reflecting fluid distribution detected similar or larger effects of the extension than MSI. If such exercises are effective in reducing symptoms, it is likely through other mechanisms than by changing fluid content or distribution.},
  langid = {english},
  keywords = {Exercise therapy,Intervertebral disc degeneration,low back pain,Magnetic resonance imaging,McKenzie method,T weighted MR images},
