@article{myersHikerFatalitySevere2015,
  title = {Hiker Fatality from Severe Hyponatremia in Grand Canyon National Park.},
  author = {Myers, Thomas M and Hoffman, Martin D},
  year = {2015},
  month = sep,
  journal = {Wilderness \& environmental medicine},
  volume = {26},
  number = {3},
  pages = {371--374},
  doi = {10.1016/j.wem.2015.03.001},
  abstract = {We present the case of a hiker who died of severe hyponatremia at Grand Canyon National Park. The woman collapsed on the rim shortly after finishing a 5-hour hike into the Canyon during which she was reported to have consumed large quantities of water. First responders transported her to the nearest hospital. En route, she became unresponsive, and subsequent treatment included intravenous normal saline. Imaging and laboratory data at the hospital confirmed hypervolemic hyponatremia with encephalopathy. She never regained consciousness and died of severe cerebral edema less than 24 hours later. We believe this is the first report of a fatality due to acute hyponatremia associated with hiking in a wilderness setting. This case demonstrates the typical pathophysiology, which includes overconsumption of fluids, and demonstrates the challenges of diagnosis and the importance of appropriate acute management. Current treatment guidelines indicate that symptomatic exercise-associated hyponatremia should be acutely managed with hypertonic saline and can be done so without concern over central pontine myelinolysis, whereas treatment with high volumes of isotonic fluids may delay recovery and has even resulted in deaths.},
  affiliation = {Branch of Emergency Services, Grand Canyon National Park, Grand Canyon, AZ (Dr Myers). Electronic address: canyondoc@gmail.com.},
  date-added = {2015-09-10T05:38:53GMT},
  date-modified = {2022-04-30T18:15:37GMT},
