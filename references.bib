  doi = {10.1001/jama.2024.2087},
  urldate = {2024-03-23},
  abstract = {People who were infected with SARS-CoV-2 tended to score slightly worse on cognitive assessments---particularly in memory, reasoning, and tasks that require executive function---than those who were not infected, according to data from about 113\,000 participants in England. The score was the equivalent of a 3-point loss on an IQ scale, the researchers reported in the New England Journal of Medicine.This small cognitive decline was the same for people who recovered within 1 month as it was for those whose symptoms took at least 3 months to resolve. But participants with long-lasting symptoms that hadn't improved by the time they took the assessment had the equivalent of a 6-point loss in IQ and those who were hospitalized had the equivalent of a 9-point drop.},
