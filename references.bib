@article{mohamadaliTechnologyFactorsBarriers2017,
  title = {The {{Technology Factors}} as {{Barriers}} for {{Sustainable Health Information Systems}} ({{HIS}}) -- {{A Review}}},
  author = {Mohamadali, Noor Azizah and Ab Aziz, Nur Faizah},
  year = {2017},
  month = jan,
  journal = {Procedia Computer Science},
  series = {4th {{Information Systems International Conference}} 2017, {{ISICO}} 2017, 6-8 {{November}} 2017, {{Bali}}, {{Indonesia}}},
