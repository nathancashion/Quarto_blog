  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/B/2017/Riel/2017\%20Riel\%20Br\%20J\%20Sports\%20Med-1.pdf},
  pmid = {28219944},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1136/bjsports-2017-097519},
