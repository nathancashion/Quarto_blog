  pages = {403--410},
  doi = {10.11138/mltj/2017.7.3.403},
  abstract = {Writing a scientific article is not an easy task, but it is definitely a great satisfaction to be able to conclude and publish it. Indeed, each publication is a service we make to the entire scientific community and to the advancement of science even before our personal career. There is and there will not be a final book/article for writing a scientific paper. Therefore, some knowledge is a decisive factor to increase the chances of our work being accepted by a specialized scientific journal. The purpose of this editorial is to trace an ideal path, based on our personal experience, useful to properly structure a scientific article, from bibliographic research to cover letter. Articles should not be written in a polished way to gratify one's own ego, but they must be written for anyone who can read and understand them. Level of evidence:V.},
