  author = {Padulo, Johnny and Padulo, Johnny and De Giorgio, Andrea and De Giorgio, Andrea and Oliva, Francesco and Oliva, Francesco and Frizziero, Antonio and Frizziero, Antonio and Maffulli, Nicola},
