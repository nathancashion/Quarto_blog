@article{rahimiMethodsEvaluateHealth2007,
  title = {Methods to {{Evaluate Health}} Information {{Systems}} in {{Healthcare Settings}}: {{A Literature Review}}},
  shorttitle = {Methods to {{Evaluate Health}} Information {{Systems}} in {{Healthcare Settings}}},
  author = {Rahimi, Bahlol and Vimarlund, Vivian},
