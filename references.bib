  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.7899/JCE-17-4},
  file = {/Users/nately/Zotero/storage/887LZUN3/2017 Mansholt J Chiropr Educ-1.pdf}
}

@article{mansilla-ferragutImmediateEffectsAtlantooccipital2009,
