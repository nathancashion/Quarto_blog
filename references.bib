@article{kimCuppingTreatingPain2011,
  title = {Cupping for Treating Pain: {{A}} Systematic Review},
  author = {Kim, Jong-In and Kim, Jong-In and Lee, Myeong Soo and Lee, Myeong Soo and Lee, Dong-Hyo and Lee, Dong-Hyo and Boddy, Kate and Boddy, Kate and Ernst, Edzard},
  year = {2011},
  journal = {Evidence-based complementary and alternative medicine : eCAM},
  volume = {2011},
  number = {4},
  pages = {467014--7},
  doi = {10.1093/ecam/nep035},
  abstract = {The objective of this study was to assess the evidence for or against the effectiveness of cupping as a treatment option for pain. Fourteen databases were searched. Randomized clinical trials (RCTs) testing cupping in patients with pain of any origin were considered. Trials using cupping with or without drawing blood were included, while trials comparing cupping with other treatments of unproven efficacy were excluded. Trials with cupping as concomitant treatment together with other treatments of unproven efficacy were excluded. Trials were also excluded if pain was not a central symptom of the condition. The selection of studies, data extraction and validation were performed independently by three reviewers. Seven RCTs met all the inclusion criteria. Two RCTs suggested significant pain reduction for cupping in low back pain compared with usual care (P {\textexclamdown} .01) and analgesia (P {\textexclamdown} .001). Another two RCTs also showed positive effects of cupping in cancer pain (P {\textexclamdown} .05) and trigeminal neuralgia (P {\textexclamdown} .01) compared with anticancer drugs and analgesics, respectively. Two RCTs reported favorable effects of cupping on pain in brachialgia compared with usual care (P = .03) or heat pad (P {\textexclamdown} .001). The other RCT failed to show superior effects of cupping on pain in herpes zoster compared with anti-viral medication (P = .065). Currently there are few RCTs testing the effectiveness of cupping in the management of pain. Most of the existing trials are of poor quality. Therefore, more rigorous studies are required before the effectiveness of cupping for the treatment of pain can be determined.},
  affiliation = {Korea Institute of Oriental Medicine, Daejeon 305-811, Republic of Korea.},
  date-added = {2016-08-11T17:51:55GMT},
  date-modified = {2022-04-30T18:15:36GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/E/2011/Kim/2011\%20Kim\%20Evid\%20Based\%20Complement\%20Alternat\%20Med-1.pdf},
  pmcid = {PMC3136528},
  pmid = {19423657},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1093/ecam/nep035},
  file = {/Users/nately/Zotero/storage/4ZC725ZQ/2011 Kim Evid Based Complement Alternat Med-1.pdf}
}

