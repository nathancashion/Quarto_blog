  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/J/2010/Fryer/2010\%20Fryer\%20Journal\%20of\%20Bodywork\%20and\%20Movement\%20Therapies.pdf},
  pmid = {20226359},
