@article{liuEvidenceDryNeedling2018,
  title = {Evidence for Dry Needling in the Management of Myofascial Trigger Points Associated with Low Back Pain: {{A}} Systematic Review and Meta-Analysis},
  author = {Liu, Lin and Huang, Qiang-Min and Liu, Qing-Guang and Thitham, Nguyen and Li, Li-Hui and Ma, Yan-Tao and Zhao, Jia-Min},
  year = {2018},
  month = jan,
  journal = {Archives of Physical Medicine and Rehabilitation},
  volume = {99},
  number = {1},
  pages = {144--152.e2},
  publisher = {Elsevier},
  doi = {10.1016/j.apmr.2017.06.008},
  abstract = {{\textexclamdown}h2{\textquestiondown}Abstract{\textexclamdown}/h2{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Objective{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}To evaluate the current evidence of the effectiveness of dry needling of myofascial trigger points (MTrPs) associated with low back pain (LBP).{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Data Sources{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}PubMed, Ovid, EBSCO, ScienceDirect, Web of Science, Cochrane Library, CINAHL, and China National Knowledge Infrastructure databases were searched until January 2017.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Study Selection{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Randomized controlled trials (RCTs) that used dry needling as the main treatment and included participants diagnosed with LBP with the presence of MTrPs were included.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Data Extraction{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Two reviewers independently screened articles, scored methodologic quality, and extracted data. The primary outcomes were pain intensity and functional disability at postintervention and follow-up.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Data Synthesis{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}A total of 11 RCTs involving 802 patients were included in the meta-analysis. Results suggested that compared with other treatments, dry needling of MTrPs was more effective in alleviating the intensity of LBP (standardized mean difference [SMD], 1.06; 95\% confidence interval [CI], 1.77 to 0.36; {\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown}=.003) and functional disability (SMD, 0.76; 95\% CI, 1.46 to 0.06; {\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown}=.03); however, the significant effects of dry needling plus other treatments on pain intensity could be superior to dry needling alone for LBP at postintervention (SMD, 0.83; 95\% CI, 0.55--1.11; {\textexclamdown}i{\textquestiondown}P{\textexclamdown}/i{\textquestiondown}{\textexclamdown}.00001).{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusions{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Moderate evidence showed that dry needling of MTrPs, especially if associated with other therapies, could be recommended to relieve the intensity of LBP at postintervention; however, the clinical superiority of dry needling in improving functional disability and its follow-up effects still remains unclear.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Department of Sport Medicine and the Center of Rehabilitation, School of Sport Science, Shanghai University of Sport, Shanghai, China.},
  date-added = {2018-01-17T18:11:57GMT},
  date-modified = {2022-04-30T18:15:29GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/EC/EC3C2C25-9849-49F9-BFBF-ABFE45392E42.pdf},
  pmid = {28690077},
