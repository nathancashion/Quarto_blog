  uri = {papers3://publication/doi/10.1056/NEJMoa2034577},
  keywords = {coronavirus,COVID-19,vaccine},
  file = {/Users/nately/Zotero/storage/7HIL8E8B/Polack et al. - 2020 - Safety and efficacy of the BNT162b2 mRNA covid-19 .pdf}
}

