  title = {Improving Transparency and Scientific Rigor in Academic Publishing.},
  author = {Prager, Eric M and Chambers, Karen E and Plotkin, Joshua L and McArthur, David L and Bandrowski, Anita E and Bansal, Nidhi and Martone, Maryann E and Bergstrom, Hadley C and Bespalov, Anton and Graf, Chris},
  year = {2019},
  month = apr,
  journal = {Journal of neuroscience research},
  volume = {97},
