@article{boylePatientExperiencesReferral2022,
  title = {Patient Experiences of Referral Practices and Primary Care Physiotherapy for Chronic Nonspecific Low Back Pain},
  author = {Boyle, Eileen M and Evans, Kerrie and Coates, Sonia and Fary, Robyn E and Bennell, Kim and Sterling, Michele and Rebbeck, Trudy and Beales, Darren J},
  year = {2022},
  month = nov,
  journal = {Physiotherapy Theory and Practice},
  volume = {0},
  number = {0},
  pages = {1--17},
  publisher = {Taylor \& Francis},
  issn = {0959-3985},
  doi = {10.1080/09593985.2022.2141599},
  urldate = {2023-03-24},
  abstract = {Background Low back pain (LBP) clinical practice guidelines recommend referral for patients with persistent LBP however discordance persists between recommended care and implementation in practice. Understanding patient experiences of referral practices and physiotherapy care could be important for optimizing LBP management in primary care settings.Purpose This study explored referral experiences of people with nonspecific LBP in Australian primary care and their knowledge and experience of physiotherapy.Methods An interpretive descriptive qualitative framework was used with 17 participants interviewed from community-based physiotherapy practices.Results Four themes described the participants' experiences of referrals in primary care settings: 1) Referral practices ranged from formal to informal to non-existent; 2) Fragmented inter-and intra-professional LBP care management; 3) Patient perceived differences in the roles of physiotherapists and specialist physiotherapists; and 4) Patient nominated barriers and facilitators to optimal referral practices.Conclusion Physiotherapists support people with LBP to improve strength and function, whereas the specialist physiotherapist's role was seen as more holistic. Referral pathways that align to clinical guideline recommendations for non-surgical management and treatment remain underdeveloped. Improved referral pathways to clinicians such as physiotherapists with additional credentialed skills and competence in musculoskeletal care could improve people's experiences of care and health outcomes.},
  pmid = {36331383},
  keywords = {guideline recommendations,inter and intra-professional,primary care,referral pathways}
}

