@article{mabryPhysicalTherapistsAre2022,
  title = {Physical {{Therapists Are Routinely Performing}} the {{Requisite Skills}} to {{Directly Refer}} for {{Musculoskeletal Imaging}}: {{An Observational Study}}},
  shorttitle = {Physical {{Therapists Are Routinely Performing}} the {{Requisite Skills}} to {{Directly Refer}} for {{Musculoskeletal Imaging}}},
  author = {Mabry, Lance M. and Severin, Richard and Gisselman, Angela S. and Ross, Michael D. and Davenport, Todd E. and Young, Brian A. and Keil, Aaron P. and Goss, Don L.},
  year = {2022},
  month = sep,
  journal = {Journal of Manual \& Manipulative Therapy},
  volume = {30},
  number = {5},
  pages = {261--272},
  issn = {1066-9817, 2042-6186},
  doi = {10.1080/10669817.2022.2106729},
  urldate = {2025-05-29},
  abstract = {Objectives: To explore if physical therapists are practicing skills necessary to refer patients for musculoskeletal imaging. Methods: An expert panel established a list of nine requisite skills to refer for musculoskeletal imaging. A blinded expert panel validated the list using a 5-point Likert scale. The skills list was examined via an electronic survey distributed to United States physical therapists. Results: 4,796 respondents were included. Each of the nine skills were routinely performed by a majority of the respondents (range: 54.52--94.72\%). Respondents routinely performed 6.95 ({\textpm} 0.06) skills, with 67.41\% routinely performing seven or more skills. Doctors of physical therapy routinely performed more imaging skills (7.15 {\textpm} 0.06) compared to their masters- (6.44 {\textpm} 0.19) and bachelorstrained (5.95 {\textpm} 0.21) counterparts (p {$<$} 0.001). Residency/fellowship-trained physical therapists were more likely to routinely perform more imaging skills (7.60 {\textpm} 0.11 vs. 6.79 {\textpm} 0.07, p {$<$} 0.001). Imaging skill performance was greater among board-certified physical therapists (7.39 {\textpm} 0.09 vs. 6.71 {\textpm} 0.08, p {$<$} 0.001) and APTA members (7.06 {\textpm} 0.07 vs. 6.65 {\textpm} 0.12, p {$<$} 0.001). Conclusion: Physical therapists are routinely practicing the requisite imaging skills to directly refer to a radiologist for musculoskeletal imaging.},
  langid = {english},
  file = {/Users/nately/Zotero/storage/2Z7EYFTM/Mabry et al. - 2022 - Physical Therapists Are Routinely Performing the Requisite Skills to Directly Refer for Musculoskele.pdf}
}

