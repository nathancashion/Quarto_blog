@article{gallantTheoreticalPerspectiveRunningrelated2014,
  title = {A Theoretical Perspective on Running-Related Injuries.},
  author = {Gallant, Jodi Lynn and Pierrynowski, Michael Raymond},
  year = {2014},
  month = mar,
  journal = {Journal of the American Podiatric Medical Association},
  volume = {104},
  number = {2},
  pages = {211--220},
  doi = {10.7547/0003-0538-104.2.211},
  abstract = {The etiology of running-related injuries remains unknown; however, an implicit theory underlies much of the conventional research and practice in the prevention of these injuries. This theory posits that the cause of running-related injuries lies in the high-impact forces experienced when the foot contacts the ground and the subsequent abnormal movement of the subtalar joint. The application of this theory is seen in the design of the modern running shoe, with cushioning, support, and motion control. However, a new theory is emerging that suggests that it is the use of these modern running shoes that has caused a maladaptive running style, which contributes to a high incidence of injury among runners. The suggested application of this theory is to cease use of the modern running shoe and transition to barefoot or minimalist running. This new running paradigm, which is at present inadequately defined, is proposed to avoid the adverse biomechanical effects of the modern running shoe. Future research should rigorously define and then test both theories regarding their ability to discover the etiology of running-related injury. Once discovered, the putative cause of running-related injury will then provide an evidence-based rationale for clinical prevention and treatment.},
  affiliation = {School of Rehabilitation Science, McMaster University, Hamilton, ON, Canada.},
  date-added = {2020-12-15T16:29:16GMT},
  date-modified = {2022-03-21T19:09:50GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/EE/EE8B0583-B8F1-4DB5-BCF2-242816F23F24.pdf},
  pmid = {24725045},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.7547/0003-0538-104.2.211}
}

@article{gallikerLowBackPain2020,
  title = {Low Back Pain in the Emergency Department: {{Prevalence}} of Serious Spinal Pathologies and Diagnostic Accuracy of Red Flags},
  author = {Galliker, Gabriela and Scherer, Dominique Eva and Trippolini, Maurizio Alen and {Rasmussen-Barr}, Eva and LoMartire, Riccardo and Wertli, Maria Monika},
  year = {2020},
  month = jan,
  journal = {The American Journal of Medicine},
  volume = {133},
  number = {1},
  pages = {60--72.e14},
  publisher = {Elsevier},
  doi = {10.1016/j.amjmed.2019.06.005},
  abstract = {{\textexclamdown}h2{\textquestiondown}Abstract{\textexclamdown}/h2{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Background{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}Very little evidence is available on the prevalence of serious spinal pathologies and the diagnostic accuracy of red flags in patients presenting to the emergency department (ED). This systematic review aims to investigate the prevalence of serious spinal pathologies and the diagnostic accuracy of red flags in patients presenting with low back pain to the ED.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Methods{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}We systematically searched MEDLINE, PUBMED, EMBASE, Cochrane Library, and SCOPUS from inception to January 2019. Two reviewers independently reviewed the references and evaluated methodological quality.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}We analyzed 22 studies with a total of 41,320 patients. The prevalence of any requiring immediate/urgent treatment was 2.5\%-5.1\% in prospective and 0.7\%-7.4\% in retrospective studies (0.0\%--7.2\% for vertebral fractures, 0.0\%-2.1\% for spinal cancer, 0.0\%-1.9\% for infectious disorders, 0.1\%-1.9\% for pathologies with spinal cord/cauda equina compression, 0.0\%-0.9\% for vascular pathologies). Examples of red flags which increased the likelihood for a serious condition were suspicion or history of cancer (spinal cancer); intravenous drug use, indwelling vascular catheter, and other infection site (epidural abscess).{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusion{\textexclamdown}/h3{\textquestiondown}{\textexclamdown}p{\textquestiondown}We found a higher prevalence of serious spinal pathologies in the ED compared to the reported prevalence in primary care settings. As the diagnostic accuracy of most red flags was reported only by a single study, further validation in high-quality prospective studies is needed.{\textexclamdown}/p{\textquestiondown}},
  affiliation = {Department of Internal Medicine, University Hospital Bern, Bern, Switzerland. Electronic address: gabriela.galliker@hotmail.com.},
  date-added = {2020-01-08T23:02:58GMT},
  date-modified = {2022-03-21T19:09:26GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/8F/8F090CEC-54B0-495A-8640-F9234B613244.pdf},
  pmid = {31278933},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1016/j.amjmed.2019.06.005},
  file = {/Users/nately/Zotero/storage/AIX3DU47/Galliker et al. - 2020 - Low back pain in the emergency department Prevale.pdf}
}

