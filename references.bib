@article{loSharingClinicalResearch2017,
  title = {Sharing {{Clinical Research Data}}---{{Finding}} the {{Right Balance}}},
  author = {Lo, Bernard and Goodman, Steven N.},
  year = {2017},
  month = sep,
  journal = {JAMA Internal Medicine},
  volume = {177},
  number = {9},
  pages = {1241--1242},
  issn = {2168-6106},
  doi = {10.1001/jamainternmed.2017.1926},
  urldate = {2024-04-21},
  abstract = {Sharing full data from clinical trials has been extensively advocated to better understand the harms and benefits of current treatments, generate new hypotheses, and maximize knowledge gained through trial participants' altruism. Several pharmaceutical companies and the European Medicines Agency, which licenses drugs in Europe, are now sharing clinical trial data. An Institute of Medicine report presented a framework and the International Committee of Medical Journal Editors issued a draft proposal for clinical trial data sharing. The National Institutes of Health have expanded requirements for registration of clinical trials, reporting of summary results, and data management plans. The Patient Centered Outcomes Research Institute has been working on a data sharing policy almost since its inception. Beyond clinical trials, researchers can study the effectiveness or safety of therapies via observational data collected in electronic health records within the US Food and Drug Administration (FDA) Sentinel Program, within research-oriented health care systems, and through the Patient-Centered Outcomes Research Network. In various precision medicine initiatives, patients are sharing with researchers data from personal devices and genomic sequencing of biospecimens.},
  file = {/Users/nately/Zotero/storage/PDAJZ4ZK/Lo and Goodman - 2017 - Sharing Clinical Research Data—Finding the Right Balance.pdf}
}

