  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/A1/A12536DC-7F39-487B-94CA-892B72F5D2EF.pdf},
  pmcid = {PMC1767619},
  pmid = {12695446},
  rating = {0},
