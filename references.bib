@article{kwakmanHowHoneyKills2010,
  title = {How Honey Kills Bacteria.},
  author = {Kwakman, Paulus H S and {te Velde}, Anje A and {de Boer}, Leonie and Speijer, Dave and {Vandenbroucke-Grauls}, Christina M J E and Zaat, Sebastian A J},
  year = {2010},
  month = jul,
  volume = {24},
  number = {7},
  pages = {2576--2582},
  doi = {10.1096/fj.09-150789},
  abstract = {With the rise in prevalence of antibiotic-resistant bacteria, honey is increasingly valued for its antibacterial activity. To characterize all bactericidal factors in a medical-grade honey, we used a novel approach of successive neutralization of individual honey bactericidal factors. All bacteria tested, including Bacillus subtilis, methicillin-resistant Staphylococcus aureus, extended-spectrum beta-lactamase producing Escherichia coli, ciprofloxacin-resistant Pseudomonas aeruginosa, and vancomycin-resistant Enterococcus faecium, were killed by 10-20\% (v/v) honey, whereas {\textquestiondown} or = 40\% (v/v) of a honey-equivalent sugar solution was required for similar activity. Honey accumulated up to 5.62 +/- 0.54 mM H(2)O(2) and contained 0.25 +/- 0.01 mM methylglyoxal (MGO). After enzymatic neutralization of these two compounds, honey retained substantial activity. Using B. subtilis for activity-guided isolation of the additional antimicrobial factors, we discovered bee defensin-1 in honey. After combined neutralization of H(2)O(2), MGO, and bee defensin-1, 20\% honey had only minimal activity left, and subsequent adjustment of the pH of this honey from 3.3 to 7.0 reduced the activity to that of sugar alone. Activity against all other bacteria tested depended on sugar, H(2)O(2), MGO, and bee defensin-1. Thus, we fully characterized the antibacterial activity of medical-grade honey.},
  affiliation = {Department of Medical Microbiology, Academic Medical Center, University of Amsterdam, 1105 AZ Amsterdam, The Netherlands.},
  date-added = {2015-11-23T03:04:56GMT},
  date-modified = {2022-03-20T22:31:12GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Unknown/2010/Kwakman/2010\%20Kwakman.pdf},
  pmid = {20228250},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1096/fj.09-150789},
  file = {/Users/nately/Zotero/storage/GKVT9V28/2010 Kwakman.pdf}
}

@article{kwakmanMedicalgradeHoneyKills2008,
  title = {Medical-Grade Honey Kills Antibiotic-Resistant Bacteria in Vitro and Eradicates Skin Colonization.},
  author = {Kwakman, Paulus H S and {Van den Akker}, Johannes P C and G{\"u}{\c c}l{\"u}, Ahmet and Aslami, Hamid and Binnekade, Jan M and {de Boer}, Leonie and Boszhard, Laura and Paulus, Frederique and Middelhoek, Pauline and {te Velde}, Anje A and {Vandenbroucke-Grauls}, Christina M J E and Schultz, Marcus J and Zaat, Sebastian A J},
  year = {2008},
  month = jun,
  journal = {Clinical infectious diseases : an official publication of the Infectious Diseases Society of America},
  volume = {46},
  number = {11},
  pages = {1677--1682},
  doi = {10.1086/587892},
  abstract = {BACKGROUND:Antibiotic resistance among microbes urgently necessitates the development of novel antimicrobial agents. Since ancient times, honey has been used successfully for treatment of infected wounds, because of its antibacterial activity. However, large variations in the in vitro antibacterial activity of various honeys have been reported and hamper its acceptance in modern medicine. METHODS:We assessed the in vitro bactericidal activity of Revamil (Bfactory), a medical-grade honey produced under controlled conditions, and assessed its efficacy for reduction of forearm skin colonization in healthy volunteers in a within-subject-controlled trial. RESULTS:With Bacillus subtilis as a test strain, we demonstrated that the variation in bactericidal activity of 11 batches of medical-grade honey was {\textexclamdown}2-fold. Antibiotic-susceptible and -resistant isolates of Staphylococcus aureus, Staphylococcus epidermidis, Enterococcus faecium, Escherichia coli, Pseudomonas aeruginosa, Enterobacter cloacae, and Klebsiella oxytoca were killed within 24 h by 10\%-40\% (vol/vol) honey. After 2 days of application of honey, the extent of forearm skin colonization in healthy volunteers was reduced 100-fold (P {\textexclamdown} .001), and the numbers of positive skin cultures were reduced by 76\% (P {\textexclamdown} .001). CONCLUSIONS:Revamil is a promising topical antimicrobial agent for prevention or treatment of infections, including those caused by multidrug-resistant bacteria.},
  affiliation = {Department of Medical Microbiology, Academic Medical Center, University of Amsterdam, The Netherlands.},
  date-added = {2015-11-23T04:17:42GMT},
  date-modified = {2022-04-30T18:16:31GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/C/2008/Kwakman/2008\%20Kwakman\%20Clin.\%20Infect.\%20Dis-1.pdf},
  pmid = {18433338},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.1086/587892},
  file = {/Users/nately/Zotero/storage/UQI4XJCZ/2008 Kwakman Clin. Infect. Dis-1.pdf}
}

