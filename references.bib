@article{wehnerEffectTaiChi2021,
  title = {Effect of {{Tai Chi}} on Muscle Strength, Physical Endurance, Postural Balance and Flexibility: A Systematic Review and Meta-Analysis},
  author = {Wehner, Christian and Blank, Cornelia and Arvandi, Marjan and Wehner, Carina and Schobersberger, Wolfgang},
  year = {2021},
  month = feb,
  journal = {BMJ open sport \& exercise medicine},
  volume = {7},
  number = {1},
  pages = {e000817},
  publisher = {BMJ Specialist Journals},
  doi = {10.1136/bmjsem-2020-000817},
  abstract = {{\textexclamdown}h3{\textquestiondown}Objective{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}To investigate the impact of Tai Chi training on muscle strength, physical endurance, postural balance and flexibility, as measured by tests commonly used in health-related fitness or competitive sports contexts.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Design{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Systematic review and meta-analysis.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Data sources{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}The following databases were searched up to 31 July 2020: CINAHL, Cochrane Library, MEDLINE via PubMed and SPORTDiscus.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Eligibility criteria for studies{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Inclusion: (1) Randomised controlled trials published in German or English; (2) Tai Chi used as an intervention to improve physical performance; (3) Test methods commonly used in health-related fitness or competitive sports and (4) Participants aged 16 years (irrespective of health status). Exclusion: (1) Studies not focusing on Tai Chi or including Tai Chi mixed with other interventions and (2) Modified or less than eight Tai Chi movements.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Results{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Out of 3817 records, 31 studies were included in the review, 21 of them in the meta-analysis. Significant improvements in handgrip strength (2.34 kg, 95\% CI 1.53 to 3.14), walking distance during 6 min (43.37 m, 95\% CI 29.12 to 57.63), standing time in single-leg-stance with open eyes (6.41 s, 95\% CI 4.58 to 8.24) and thoracolumbar spine flexibility (2.33 cm, 95\% CI 0.11 to 4.55) were observed.{\textexclamdown}/p{\textquestiondown}{\textexclamdown}h3{\textquestiondown}Conclusion{\textexclamdown}/h3{\textquestiondown} {\textexclamdown}p{\textquestiondown}Tai Chi training seems to moderately improve physical fitness when evaluated by tests used in health-related fitness or competitive sports. Moreover, thoracolumbar spine flexibility seems to be a factor in the improvement of postural balance. Further research is needed, including younger healthy participants performing a widely used, standardised form (eg, Peking-style routine) with high-intensity movements (eg, use of lower stances).{\textexclamdown}/p{\textquestiondown}},
  date-added = {2021-11-24T05:18:00GMT},
  date-modified = {2022-03-21T19:10:31GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/B/2021/Wehner/2021\%20Wehner\%20BMJ\%20Open\%20Sport\%20Exerc\%20Med.pdf},
  rating = {0},
  uri = {papers3://publication/doi/10.1136/bmjsem-2020-000817},
  file = {/Users/nately/Zotero/storage/YPPRDB6B/2021 Wehner BMJ Open Sport Exerc Med.pdf}
}

