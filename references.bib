  pages = {2106--2111},
  issn = {1930-0433},
  doi = {10.1016/j.radcr.2024.02.037},
  urldate = {2024-03-14},
  abstract = {Serious iatrogenic vascular injuries are considered uncommon; however, they are underreported. There are limited studies discussing the proper management of these injuries; therefore, the management is often anecdotal. A 4-month-old female patient presented with elevated liver enzymes and cholecystitis with sludge. Her HIDA scan suggested biliary atresia. During the surgery, there was a bilateral iatrogenic injury to the hepato-duodenal ligament, including the portal vein, hepatic artery, and bile ducts. The patient underwent splenectomy and cholecystectomy, and the hepatic artery transection was successfully managed with a splenic artery jump graft and a portal vein bypass initiated with the SMV using a Gore-Tex(R) vascular graft. The management of iatrogenic vascular injury depends primarily on the assessment of the stage of the injury, which should be conducted by experienced surgeons using proper strategies in an established hepato-biliary surgical center. Additionally, there is little data provided in the literature, mostly case reports. Therefore, no preferred or specific approach can be found.},
  keywords = {blooper,chatGPT,Gore-Tex vascular graft,Hepatic artery injury,Iatrogenic vascular injuries,Jump graft,Portal vein injury},
  file = {/Users/nately/Zotero/storage/RH5LSQHG/S1930043324001298.html}
}

