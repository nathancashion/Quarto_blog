@article{sandersOverviewCosteffectivenessAnalysis2019,
  title = {Overview of {{Cost-effectiveness Analysis}}},
  author = {Sanders, Gillian D. and Maciejewski, Matthew L. and Basu, Anirban},
  year = {2019},
  month = apr,
  journal = {JAMA},
  volume = {321},
  number = {14},
  pages = {1400--1401},
  issn = {0098-7484},
  doi = {10.1001/jama.2019.1265},
  urldate = {2023-10-31},
  abstract = {Health care decision makers, including patients, clinicians, hospitals, private health systems, and public payers (eg, Medicare), are often challenged with choosing among several new or existing interventions or programs to commit their limited resources to. This choice is ideally based on a comparison of health benefits, harms, and costs associated with each alternative. How best to determine the optimal intervention is a challenging task because benefits, harms, and costs must be weighed for a given option and compared with alternatives.One way to inform such decisions is to perform a cost-effectiveness analysis. A cost-effectiveness analysis is an analytic method for quantifying the relative benefits and costs among 2 or more alternative interventions in a consistent framework. In a 2018 study published in JAMA Oncology, Moss et al examined the cost-effectiveness of multimodal ovarian cancer screening with serum cancer antigen 125 compared with no screening in the United States, based on findings from the large United Kingdom Collaborative Trial of Ovarian Cancer Screening (UKCTOCS). The UKCTOCS evaluated the effect of screening on ovarian cancer mortality and demonstrated that multimodal screening reduced mortality among women without prevalent ovarian cancer.},
  file = {/Users/nately/Zotero/storage/U474F8U4/jama.2019.1265.pdf.pdf}
}

