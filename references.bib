  journal = {JAMA},
  volume = {333},
  number = {20},
  pages = {1773--1774},
  issn = {0098-7484},
  doi = {10.1001/jama.2025.3641},
  urldate = {2025-05-28},
  abstract = {For the past decade, antitrust enforcement and policy have focused on the growing size and power of big tech platforms. Enforcers have homed in on the expansive reach and influence that technology platforms have over our lives and how the growing scale and size of platforms have blocked out smaller rivals, created outsized negotiating leverage, and raised barriers for new and innovative companies. In this article, we argue that a smaller number of massive health care conglomerate platforms exhibit many of the same concerning characteristics as big tech platforms and that similar antitrust attention and action may be necessary. We argue that policymakers and stakeholders should look beyond the individual services that each platform offers and consider the power and influence created by the conglomeration of services and formation of multisided platforms that function as essential health care intermediaries.},
  file = {/Users/nately/Zotero/storage/K8DRX6CM/Kanter and Gaynor - 2025 - The Rise of Health Care Platforms.pdf}
}

