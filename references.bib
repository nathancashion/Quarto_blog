@article{dorrHarnessingPromiseArtificial2023,
  title = {Harnessing the {{Promise}} of {{Artificial Intelligence Responsibly}}},
  author = {Dorr, David A. and Adams, Laura and Emb{\'i}, Peter},
  year = {2023},
  month = mar,
  journal = {JAMA},
  issn = {0098-7484},
  doi = {10.1001/jama.2023.2771},
  urldate = {2023-04-02},
  abstract = {We are now in an exceptional time: algorithms driven by artificial intelligence (AI) and related approaches are seemingly ubiquitous, are heavily promoted, and hold great potential, but early implementations have demonstrated the potential for harm, failure to perform, and furtherance of inequity. The promise of AI is clear: algorithms can provide new insights that support better health for individuals and populations and improve systems, including health, public health, population, or social systems. Artificial intelligence is used to help guide medical decisions benefiting individuals and populations and to provide insight into optimizing systems of all kinds. Advanced algorithms using AI draw inferences around potential risks, diagnoses, treatments, and prognoses from diverse data sources such as genomics, imaging, patient-generated health data, textual and structured clinical data, and even voice. True AI involves a system that replicates or enhances---but not replaces---the cognition normally carried out by a human; where the inference drawn is not easily reproduced by a human; and where the inference is intended to drive action or, in the future, automates an action such as defining a diagnosis, ordering a study, or prescribing treatments. In addition, tools like ChatGPT and DALL-E, while not without significant issues, can use their massive databases and algorithms to create new content: tailored notes, beautiful images, and even poetry. The use of algorithms in medicine is ubiquitous, and automation of these algorithms is increasingly common. Learning health systems can and should use algorithms to improve the effectiveness, reliability, person-centeredness, and efficiency of care as they seek to constantly improve, but do so responsibly, because AI is not without peril.},
  keywords = {artificial intelligence},
  file = {/Users/nately/Zotero/storage/4RYRIUFK/Dorr et al. - 2023 - Harnessing the Promise of Artificial Intelligence .pdf}
}

