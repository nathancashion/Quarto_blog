@article{stevensAccountingMissingData2016,
  title = {Accounting for {{Missing Data}} in {{Clinical Research}}},
  author = {Stevens, John R. and Suyundikov, Anvar and Slattery, Martha L.},
  year = {2016},
  month = feb,
  journal = {JAMA},
  volume = {315},
  number = {5},
  pages = {517--518},
  issn = {0098-7484},
  doi = {10.1001/jama.2015.16461},
  urldate = {2023-10-31},
  abstract = {To the Editor Drs Newgard and Lewis provided an overview of many important issues to consider when dealing with missing data in clinical research. In particular, they summarized the following limitations of traditional imputation methods: failure to account for uncertainty in imputed values, failure to make full use of observed values, possibilities for bias, and artificially low variance.One imputation method in use for many years involves the K--nearest neighbors (KNN) approach, which was not included in the JAMA Guide to Statistics and Methods article. By using the KNN method, a variable's missing value for a participant is imputed by taking a weighted average of fully observed variable values for several participants who are the most similar (in terms of other covariates) to the person in question. The KNN method has been widely applied with considerable effectiveness, including in ``-omics'' clinical research.},
  file = {/Users/nately/Zotero/storage/6W34TD4A/Stevens et al. - 2016 - Accounting for Missing Data in Clinical Research.pdf;/Users/nately/Zotero/storage/8Z9AKDFY/jama.2015.16461.pdf.pdf}
}

