  number = {3},
  pages = {257--258},
  doi = {10.1136/bjsm.32.3.257},
  abstract = {Hyponatraemia is one of the most common electrolyte abnormalities, leading to significant morbidity and mortality. In the most basic sense, hyponatraemia can be due to sodium loss or fluid excess. The extracellular fluid status is used to clinically divide hyponatraemia into three categories to help to determine both the cause and treatment required. Hyponatraemic patients can be categorised on the basis of their fluid status as hypovolaemic, euvolaemic, or hypervolaemic. Another distinction to make in evaluating hyponatraemia is whether the onset was acute or chronic in nature. The case presented here is iatrogenic acute hypervolaemic hyponatraemia in a college athlete. The patient presented in respiratory distress with an altered mental status after the administration of hypotonic fluids for treatment of muscle cramps. Treatment included intubation, water restriction, and furosemide, to which he responded favourably. Hyponatraemia should be in the differential diagnosis for patients presenting after intravenous fluid administration.},
  affiliation = {Department of Emergency Medicine, University of Kentucky College of Medicine, Lexington 40536, USA.},
