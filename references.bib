  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/FD/FD0D4E3B-E554-4AC0-A2F6-1E87E05E7A2D.pdf},
  pmcid = {PMC1185558},
  pmid = {16000175},
