@article{mahmoudRelationshipForwardHead2019,
  title = {The Relationship between Forward Head Posture and Neck Pain: A Systematic Review and Meta-Analysis.},
  author = {Mahmoud, Nesreen Fawzy and Hassan, Karima A and Abdelmajeed, Salwa F and Moustafa, Ibraheem M and Silva, Anabela G},
