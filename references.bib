@article{embiMasterDigitalHealth2025,
  title = {Master of {{Digital Health Degree}}},
  author = {Emb{\'i}, Peter J. and Melton, Genevieve B. and Payne, Philip R. O.},
  year = {2025},
  month = may,
  journal = {JAMA},
  issn = {0098-7484},
  doi = {10.1001/jama.2025.3538},
  urldate = {2025-05-22},
  abstract = {To the Editor We read with interest and some consternation the recent Viewpoint advocating for the creation of a new master of digital health (MDH) degree. While we agree that expanding the workforce of professionals capable of leading and implementing digital health transformation is essential, we also believe the authors' characterization of the current educational landscape is incomplete and that their proposed solution risks exacerbating, rather than resolving, the challenges they seek to address.They argue that digital health education is fragmented across various existing informatics degrees and lacks a cohesive professional identity. However, this assertion overlooks many well-established and recognized national and international informatics efforts and communities. Organizations such as the American Medical Informatics Association (AMIA), for which we represent past, current, and future leadership, provide a home for multidisciplinary professionals working to advance digital health and related activities. For decades, AMIA has supported a community of educators that has defined and continues to refine rigorous pedagogical and competency models to promote digital health-related education and professionalism. These models inform degree and graduate medical education accreditation programs, professional certifications that have recognized thousands of clinical informatics professionals including American Board of Medical Specialties subspecialty board certification, AMIA's Health Informatics Certification, and Fellows of AMIA professional recognition.},
  keywords = {read},
  file = {/Users/nately/Zotero/storage/M3ESGUN6/jama_emb_2025_le_250038_1747323812.01882.pdf}
}

@article{emdinMendelianRandomization2017,
  title = {Mendelian {{Randomization}}},
  author = {Emdin, Connor A. and Khera, Amit V. and Kathiresan, Sekar},
  year = {2017},
  month = nov,
  journal = {JAMA},
  volume = {318},
  number = {19},
  pages = {1925--1926},
  issn = {0098-7484},
  doi = {10.1001/jama.2017.17219},
  urldate = {2023-10-31},
  abstract = {Mendelian randomization uses genetic variants to determine whether an observational association between a risk factor and an outcome is consistent with a causal effect. Mendelian randomization relies on the natural, random assortment of genetic variants during meiosis yielding a random distribution of genetic variants in a population. Individuals are naturally assigned at birth to inherit a genetic variant that affects a risk factor (eg, a gene variant that raises low-density lipoprotein [LDL] cholesterol levels) or not inherit such a variant. Individuals who carry the variant and those who do not are then followed up for the development of an outcome of interest. Because these genetic variants are typically unassociated with confounders, differences in the outcome between those who carry the variant and those who do not can be attributed to the difference in the risk factor. For example, a genetic variant associated with higher LDL cholesterol levels that also is associated with a higher risk of coronary heart disease would provide supportive evidence for a causal effect of LDL cholesterol on coronary heart disease.},
  file = {/Users/nately/Zotero/storage/DX5YM56K/jama.2017.17219.pdf.pdf}
}

