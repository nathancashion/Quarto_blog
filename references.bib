  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/D/2019/Pennington/2019\%20Pennington\%20Dose-Response.pdf},
  pmcid = {PMC6376521},
  pmid = {30792613},
  rating = {0},
