  abstract = {Manual and physical therapists often use a postural-structural-biomechanical (PSB) model to ascertain the causes of various musculoskeletal conditions. It is believed that postural deviations, body asymmetries and pathomechanics are the predisposing/maintaining factors for many musculoskeletal conditions. The PSB model also plays an important role in clinical assessment and management, including the choice of manual techniques and the exercise prescribed. However, the most important question is consistently being ignored--can a person's physical shape/posture/structure/biomechanics be the cause of their lower back pain?},
  affiliation = {CPDO Ltd., 15 Harberton Road, London, UK. cpd@cpdo.net},
