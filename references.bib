@article{hidalgoItsAllConnected2024,
  title = {`{{It}}'s {\emph{All}} Connected, so It {\emph{All}} Matters' - the Fallacy of Osteopathic Anatomical Possibilism},
  author = {Hidalgo, Diego F. and MacMillan, Andrew and Thomson, Oliver P.},
  year = {2024},
  month = jun,
  journal = {International Journal of Osteopathic Medicine},
  volume = {52},
  pages = {100718},
  issn = {1746-0689},
  doi = {10.1016/j.ijosm.2024.100718},
  urldate = {2024-03-23},
  abstract = {Anatomy has been a cornerstone of osteopathic theory, practice and identity since the discipline's emergence in the 1800s and continues to be viewed as core knowledge to the present day. The domain of anatomical knowledge has provided seemingly endless rationales and explanations to justify osteopathic diagnosis, assessment and treatment. Moreover, knowledge of anatomy has been foundational for osteopaths' professional identity and conception of healthcare practice. Anatomical possibilism refers to the imagined, exaggerated, implausible and unproven relationships which are claimed to exist between anatomical structures. In persisting with such an approach to theory, practice and reasoning osteopathy may waste time, energy and intellectual capital and as a result fail to take advantage of opportunities to develop more plausible, ethical and person-focused approaches to patient care.},
  keywords = {Anatomy,Manual therapy,Osteopathic medicine,Pseudoscience},
  file = {/Users/nately/Zotero/storage/ZPFKSEE9/Hidalgo et al. - 2024 - ‘It's all connected, so it all matters’ - the fallacy of osteopathic anatomical possib.pdf;/Users/nately/Zotero/storage/34HDQXEX/S1746068924000117.html}
}

