@article{liewDatadrivenNetworkAnalysis2023,
  title = {Data-Driven Network Analysis Identified Subgroup-Specific Low Back Pain Pathways: A Cross-Sectional {{GLA}}:{{D Back}} Study},
  shorttitle = {Data-Driven Network Analysis Identified Subgroup-Specific Low Back Pain Pathways},
  author = {Liew, Bernard X. W. and Hartvigsen, Jan and Scutari, Marco and Kongsted, Alice},
  year = {2023},
  month = jan,
  journal = {Journal of Clinical Epidemiology},
  volume = {153},
  pages = {66--77},
  issn = {0895-4356},
  doi = {10.1016/j.jclinepi.2022.11.010},
  urldate = {2023-04-22},
  abstract = {Objectives To understand the physical, activity, pain, and psychological pathways contributing to low back pain (LBP) -related disability, and if these differ between subgroups. Methods Data came from the baseline observations (n~=~3849) of the ``GLA:D Back'' intervention program for long-lasting nonspecific LBP. 15 variables comprising demographic, pain, psychological, physical, activity, and disability characteristics were measured. Clustering was used for subgrouping, Bayesian networks (BN) were used for structural learning, and structural equation model (SEM) was used for statistical inference. Results Two clinical subgroups were identified with those in subgroup 1 having worse symptoms than those in subgroup 2. Psychological factors were directly associated with disability in both subgroups. For subgroup 1, psychological factors were most strongly associated with disability ({$\beta~$}=~0.363). Physical factors were directly associated with disability ({$\beta~$}=~-0.077), and indirectly via psychological factors. For subgroup 2, pain was most strongly associated with disability ({$\beta~$}=~0.408). Psychological factors were common predictors of physical factors ({$\beta~$}=~0.078), pain ({$\beta~$}=~0.518), activity ({$\beta~$}=~-0.101), and disability ({$\beta~$}=~0.382). Conclusions The importance of psychological factors in both subgroups suggests their importance for treatment. Differences in the interaction between physical, pain, and psychological factors and their contribution to disability in different subgroups may open the doors toward more optimal LBP treatments.},
  langid = {english},
  keywords = {Bayesian networks,Chronic pain,GLA:D back,GLA:D Back,low back pain,Machine learning,Network analysis,Structural equation modeling},
  file = {/Users/nately/Zotero/storage/Q2P69D27/Liew et al. - 2023 - Data-driven network analysis identified subgroup-s.pdf;/Users/nately/Zotero/storage/K8BRS4LZ/S0895435622002906.html}
}

