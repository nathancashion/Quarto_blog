  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/S/2017/Belav\%C3\%BD/2017\%20Belav\%C3\%BD\%20Sci\%20Rep-1.pdf},
  pmcid = {PMC5396190},
  pmid = {28422125},
  rating = {0},
