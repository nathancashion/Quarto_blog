@article{geriManualTherapyExploiting2019,
  title = {Manual Therapy: {{Exploiting}} the Role of Human Touch.},
  author = {Geri, Tommaso and Viceconti, Antonello and Minacci, Marco and Testa, Marco and Rossettini, Giacomo},
  year = {2019},
  month = jul,
  journal = {Musculoskeletal Science and Practice},
  volume = {44},
  pages = {102044},
  doi = {10.1016/j.msksp.2019.07.008},
  abstract = {INTRODUCTION:The physiotherapy approach to musculoskeletal pain is currently pointing more towards a hands-off management of patients by education and exercise therapy. However, hands-on techniques still represent a core element of musculoskeletal physiotherapy practice appreciated by patients and widely taught in educational program and clinical professional development training. PURPOSE:This professional issue explain why hands-on techniques may be considered a specific form of touch and outlines the importance of having a deep and wider understanding of their action mechanisms. Three aspects of the human touch, namely analgesic, affective and somatoperceptual are considered in light of the current literature. IMPLICATIONS:The view of hands-on techniques as a specific form of human touch implies a change of perspective. Primarily, manual therapy techniques are based on the physical properties of the delivered stimulus (requiring knowledge of anatomy, biomechanics and neurophysiology) as well as on the emotional properties that emerge from the sympathetic contact established with the patient. Secondarily, the manual therapists should develop relationship and communicative skills allowing this kind of touch to emerge. Thirdly, accordingly with this new perspective, the study of the multifaceted mechanisms of action of hands-on techniques requires a multidisciplinary team of researchers including specialists apparently far from the clinical field. Finally, the recognition of the therapeutic value of touch as one of the most qualifying professional acts of physiotherapists is needed and guarantees patients of its best evidence-based delivering.},
  affiliation = {Department of Neuroscience, Rehabilitation, Ophthalmology, Genetics, Maternal and Child Health, University of Genoa, Campus of Savona. Via Magliotto, 2, 17100, Savona (SV), Italy. Electronic address: tommaso.geri@gmail.com.},
  date-added = {2019-08-07T03:24:59GMT},
  date-modified = {2022-03-21T19:09:08GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/Files/E4/E4EC7042-7C5A-4E07-A35C-84A3715ADD13.pdf},
  pmid = {31358458},
  rating = {0},
  uri = {papers3://publication/doi/10.1016/j.msksp.2019.07.008}
}

