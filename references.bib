@article{fernandoAcuteSubduralHemorrhage2022,
  title = {Acute Subdural Hemorrhage as the Initial Presentation of Intracranial Hypotension Following Cervical Chiropractic Manipulation: {{A}} Case Report and Systematic Review.},
  author = {Fernando, Emmaline Z and Jamora, Roland Dominic G and Torio, Erickson F and Mariano, Manuel M and Cuanang, Joven R and {de Guzman}, Vincent E},
  year = {2022},
  month = jan,
  journal = {The Neurohospitalist},
  volume = {12},
  number = {1},
  pages = {57--62},
  doi = {10.1177/1941874420977767},
  abstract = {Spontaneous intracranial hypotension (SIH) still remains an underdiagnosed etiology of new-onset headache. Important risk factors include chiropractic manipulation (CM). We present a case of a 36-year-old Filipino woman who presented with severe bifrontal and postural headache associated with dizziness, vomiting, and doubling of vision. A cranial computed tomography scan was done which showed an acute subdural hematoma (SDH) at the interhemispheric area. Pain medications were given which afforded minimal relief. On history, the headaches occurred 2 weeks after cervical CM. Cranial and cervical magnetic resonance imaging revealed findings supportive of intracranial hypotension and neck trauma, respectively. The patient improved with conservative management. We found 12 articles on SIH and CM after a systematic review of literature. Eleven patients (90.9\%) initially presented with orthostatic headache. Eight patients (66.7\%) were initially treated conservatively but only 5 (62.5\%) had complete recovery. Recovery was achieved within 14 days from start of supportive therapy. Among the 3 patients who failed conservative treatment, 2 underwent non-directed epidural blood patch and one required neurosurgical intervention. This report highlights that a thorough history is warranted in patients with new onset headache. A history of CM must be actively sought. The limited evidence from the case reports showed that patients with SIH and SDH but with normal neurologic examination and minor spinal pathology can be managed conservatively for less than 2 weeks. This review showed that conservative treatment in a closely monitored environment may be an appropriate first line treatment.},
  affiliation = {Section of Neurology, Institute for Neurosciences, St. Luke's Medical Center, Quezon City, Philippines.},
  date-added = {2022-02-26T15:13:19GMT},
  date-modified = {2022-03-21T19:11:01GMT},
  langid = {english},
  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/N/2022/Fernando/2022\%20Fernando\%20Neurohospitalist.pdf},
  pmcid = {PMC8689553},
  pmid = {34950387},
  rating = {0},
  uri = {papers3://publication/doi/10.1177/1941874420977767},
  file = {/Users/nately/Zotero/storage/9BSXLMQU/2022 Fernando Neurohospitalist.pdf}
}

@article{fernyhoughInnerSpeechLanguage2023,
  title = {Inner Speech as Language Process and Cognitive Tool},
  author = {Fernyhough, Charles and Borghi, Anna M.},
  year = {2023},
  month = dec,
  journal = {Trends in Cognitive Sciences},
  volume = {27},
  number = {12},
  pages = {1180--1193},
  issn = {1364-6613},
  doi = {10.1016/j.tics.2023.08.014},
  urldate = {2024-01-15},
  abstract = {Many people report a form of internal language known as inner speech (IS). This review examines recent growth of research interest in the phenomenon, which has broadly supported a theoretical model in which IS is a functional language process that can confer benefits for cognition in a range of domains. A key insight to have emerged in recent years is that IS is an embodied experience characterized by varied subjective qualities, which can be usefully modeled in artificial systems and whose neural signals have the potential to be decoded through advancing brain--computer interface technologies. Challenges for future research include understanding individual differences in IS and mapping form to function across IS subtypes.},
  keywords = {inner dialogue,inner monologue,phenomenology,self-regulation,self-talk,verbal thinking},
  file = {/Users/nately/Zotero/storage/57ENG9T7/Fernyhough and Borghi - 2023 - Inner speech as language process and cognitive too.pdf;/Users/nately/Zotero/storage/T2K5Z8AE/S1364661323002103.html}
}

@misc{ferrariGlobalIncidencePrevalence,
  title = {Global Incidence, Prevalence, Years Lived with Disability ({{YLDs}}), Disability-Adjusted Life-Years ({{DALYs}}), and Healthy Life Expectancy ({{HALE}}) for 371 Diseases and Injuries in 204 Countries and Territories and 811 Subnational Locations, 1990--2021: {{A}} Systematic Analysis for the {{Global Burden}} of {{Disease Study}} 2021},
  author = {Ferrari, Alize J},
  abstract = {Our paper provides comprehensive estimates for several key health metrics --- prevalence, incidence, years lived with disability (YLDs), disability-adjusted life-years (DALYs), and healthy life expectancy (HALE) --- in 204 countries and territories for 1990--2021. The GBD 2021 analysis improved upon past iterations of GBD by using additional data sources and refined methods to generate updated past and current estimates. We found that for the first time in three decades, global health outcomes worsened as measured by age-standardized DALY rates. This increase in the overall global burden of disease in 2020 and 2021 was largely attributed to the COVID-19 pandemic. We observed that the increased burden was attributable to both the direct health consequences of COVID-19, long COVID, and other pandemic-related outcomes, as well as the secondary effects of the pandemic, such as the increased burden of depressive and anxiety disorders. We also highlight several important trends in the burden of non-communicable diseases; communicable, maternal, neonatal, and nutritional diseases; and injuries since 2010 by age, sex, and location. This paper provides a high-level overview of GBD 2021 findings and contextualizes the results for both specialist and non-specialist audiences. These findings have implications for the future of health care systems, economies, and societies, and evidence from this study will assist policymakers in better understanding and therefore addressing the underlying causes of health loss.},
  file = {/Users/nately/Zotero/storage/28XR2TIZ/Ferrari - Global incidence, prevalence, years lived with dis.pdf;/Users/nately/Zotero/storage/8LZP5ETQ/GBD 2021_DALY_Table.pdf;/Users/nately/Zotero/storage/E4FX2JCE/GBD 2021_DALY_Figures.pdf;/Users/nately/Zotero/storage/KKJK8G27/GBD 2021_DALY_Appendix1_Methods.pdf}
}

