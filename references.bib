@article{scarsbrookExpandingUseMicrosoft2006,
  title = {Expanding the Use of {{Microsoft PowerPoint}}. {{An}} Overview for Radiologists.},
  author = {Scarsbrook, A F and Graham, R N J and Perriss, R W},
