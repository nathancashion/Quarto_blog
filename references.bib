  local-url = {file://localhost/Users/nately/Dropbox/Articles/Library.papers3/M/2017/Rajfur/2017\%20Rajfur\%20Med.\%20Sci.\%20Monit-1.pdf},
  pmcid = {PMC5240899},
  pmid = {28062862},
  rating = {0},
  read = {Yes},
  uri = {papers3://publication/doi/10.12659/MSM.899461},
  file = {/Users/nately/Zotero/storage/W9MC8Q4W/2017 Rajfur Med. Sci. Monit-1.pdf}
