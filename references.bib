  booktitle = {Computer {{Vision}} and {{Graphics}}},
  author = {Sobel, Dawid and Kwiatkowski, Jan and Ryt, Artur and Domzal, Mariusz and Jedrasiak, Karol and Janik, Lukasz and Nawrat, Aleksander},
  editor = {Chmielewski, Leszek J. and Kozera, Ryszard and Shin, Bok-Suk and Wojciechowski, Konrad},
  year = {2014},
