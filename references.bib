@article{sujkowskiProtectiveRoleExercise2021,
  title = {The Protective Role of Exercise against Age-Related Neurodegeneration.},
  author = {Sujkowski, Alyson and Hong, Luke and Wessells, R J and Todi, Sokol V},
  year = {2021},
  month = dec,
  journal = {Ageing research reviews},
  volume = {74},
  pages = {101543},
  doi = {10.1016/j.arr.2021.101543},
  abstract = {Endurance exercise is a widely accessible, low-cost intervention with a variety of benefits to multiple organ systems. Exercise improves multiple indices of physical performance and stimulates pronounced health benefits reducing a range of pathologies including metabolic, cardiovascular, and neurodegenerative disorders. Endurance exercise delays brain aging, preserves memory and cognition, and improves symptoms of neurodegenerative pathologies like Amyotrophic Lateral Sclerosis, Alzheimer's disease, Parkinson's disease, Huntington's disease, and various ataxias. Potential mechanisms underlying the beneficial effects of exercise include neuronal survival and plasticity, neurogenesis, epigenetic modifications, angiogenesis, autophagy, and the synthesis and release of neurotrophins and cytokines. In this review, we discuss shared benefits and molecular pathways driving the protective effects of endurance exercise on various neurodegenerative diseases in animal models and in humans.},
  affiliation = {Department of Physiology, Wayne State University School of Medicine, USA; Department of Pharmacology, Wayne State University School of Medicine, USA.},
  date-added = {2021-12-17T17:42:58GMT},
