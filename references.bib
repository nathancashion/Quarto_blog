@article{demzikInterRaterIntraRaterRepeatability2016,
  title = {Inter-{{Rater}} and {{Intra-Rater Repeatability}} and {{Reliability}} of {{EOS}} 3-{{Dimensional Imaging Analysis Software}}},
  author = {Demzik, Alysen L. and Alvi, Hasham M. and Delagrammaticas, Dimitri E. and Martell, John M. and Beal, Matthew D. and Manning, David W.},
  year = {2016},
  month = may,
  journal = {The Journal of Arthroplasty},
  volume = {31},
  number = {5},
  pages = {1091--1095},
  issn = {0883-5403},
  doi = {10.1016/j.arth.2015.11.026},
  urldate = {2023-12-16},
  abstract = {Background Quantifying ideal component position for the acetabulum and stem during total hip arthroplasty (THA) has been described by many methods. A new imaging method using low-dose digital stereoradiography, the EOS imaging system, is a biplanar low-dose X-ray system that allows for 3-dimensional modeling of lower limbs and semiautomated measurement of pelvic parameters and implant alignment. Methods Twenty-five patients who underwent primary THA by a single surgeon between October 2014 and December 2014 were retrospectively selected. Only patients with unilateral THA without associated spine pathologies were included, totaling 16 right hips and 9 left hips. There were 8 men and 17 women in the cohort, with a mean age of 67 years (range, 53-82). Three individuals performed measurements of pelvic parameters and implant alignment on 3 separate occasions. An interclass correlation of {$>$}0.75 was accepted as evidence of excellent agreement and a confirmation of measurement reliability. Results Before reviewing patient radiographs, 4 pelvic phantom models were analyzed using the EOS 3-dimensional software to verify accuracy. All anatomic and implant measurements performed by the 3 independent reviewers showed interobserver and intraobserver agreement with interclass correlation {$>$}0.75. Conclusion Three-dimensional modeling of hip implants with the EOS imaging system is a reasonable option for the evaluation of component position after THA.},
  keywords = {EOS imaging,radiographic analysis,total hip arthroplasty},
  file = {/Users/nately/Zotero/storage/S9E9WGLI/Demzik et al. - 2016 - Inter-Rater and Intra-Rater Repeatability and Reli.pdf;/Users/nately/Zotero/storage/97H6TK6W/S0883540315010360.html}
}

